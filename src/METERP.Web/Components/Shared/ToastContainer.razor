@using METERP.Web.Services
@inject ToastService ToastService
@implements IDisposable

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100" data-testid="toast-container">
    @foreach (var toast in _toasts)
    {
        <div class="toast show align-items-center mb-2 @(toast.Type == ToastType.Notification ? "meterp-notify-card" : $"text-white border-0 {GetBgClass(toast.Type)}")"
             role="alert" aria-live="assertive" aria-atomic="true"
             data-testid="@(toast.Type == ToastType.Notification ? "live-notification" : "toast")">
            <div class="d-flex">
                <div class="toast-body">
                    @if (!string.IsNullOrWhiteSpace(toast.Title))
                    {
                        <strong class="d-block">@toast.Title</strong>
                    }
                    @toast.Message
                </div>
                <button type="button" class="btn-close @(toast.Type == ToastType.Notification ? "" : "btn-close-white") me-2 m-auto"
                        @onclick="() => Dismiss(toast)" aria-label="Close"></button>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();

    protected override void OnInitialized()
    {
        ToastService.OnShow += ShowToast;
    }

    private void ShowToast(ToastMessage toast)
    {
        _toasts.Add(toast);
        StateHasChanged();

        if (toast.DurationMs > 0)
        {
            _ = Task.Delay(toast.DurationMs).ContinueWith(_ =>
            {
                Dismiss(toast);
            });
        }
    }

    private void Dismiss(ToastMessage toast)
    {
        if (_toasts.Contains(toast))
        {
            _toasts.Remove(toast);
            InvokeAsync(StateHasChanged);
        }
    }

    private static string GetBgClass(ToastType type) => type switch
    {
        ToastType.Success => "bg-success",
        ToastType.Error => "bg-danger",
        ToastType.Info => "bg-primary",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        ToastService.OnShow -= ShowToast;
    }
}