@page "/payroll"
@rendermode InteractiveServer
@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Common
@using METERP.Web.Reports
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Payroll.View")]
@inject IPayrollService PayrollService
@inject ITenantService TenantService
@inject ICurrentUserService CurrentUserService
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Payroll</PageTitle>

<PageHeader Title="Payroll" Subtitle="Payslips from job labour. Not a SARS statutory run — deductions are a simple percent plus a fixed amount." TestId="payroll-page-header">
    <Actions>
        <ExportToolbar ShowPdf="false" ShowExcel="false" TestId="payroll-export"
                       OnExportCsv="ExportPeriodCsvAsync" Disabled="@_loading" />
        @if (CanManage)
        {
            <button class="btn btn-primary" data-testid="payroll-generate-button" @onclick="RefreshPayslipsAsync" disabled="@_loading">
                Refresh period
            </button>
        }
    </Actions>
</PageHeader>

<div class="card mb-3" data-testid="payroll-period-card">
    <div class="card-body row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Period (month)</label>
            <input type="month" class="form-control" value="@_periodMonth" @onchange="OnMonthInputChanged" data-testid="payroll-period" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Deduction % of gross</label>
            <input type="number" min="0" max="100" step="0.1" class="form-control" @bind="_deductionPercent" data-testid="payroll-deduction-pct" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Fixed deductions (R)</label>
            <input type="number" min="0" step="1" class="form-control" @bind="_fixedDeductions" data-testid="payroll-deduction-fixed" />
        </div>
        <div class="col-md-3">
            <button type="button" class="btn btn-outline-primary w-100" data-testid="payroll-apply-deductions" @onclick="RefreshPayslipsAsync" disabled="@_loading">
                Apply
            </button>
        </div>
    </div>
</div>

@if (_loading)
{
    <ListSkeleton Rows="6" TestId="payroll-loading" AriaLabel="Loading payroll" />
}
else if (!employees.Any())
{
    <div class="alert alert-info" data-testid="payroll-empty">No employees found. Add employees under HR, then log labor on jobs.</div>
}
else
{
    <div class="table-responsive" data-testid="payroll-ready">
        <table class="table table-hover" data-testid="payroll-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Employee</th>
                    <th>Role / Rate</th>
                    <th class="text-end">Hours</th>
                    <th class="text-end">Gross</th>
                    <th class="text-end">Deductions</th>
                    <th class="text-end">Net</th>
                    <th>Entries</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in PagedEmployees)
                {
                    <tr class="meterp-row-click" data-testid="payroll-row" title="Open payslip" @onclick="() => ViewPayslip(e)">
                        <td>@e.EmployeeNumber</td>
                        <td><strong>@e.Name</strong></td>
                        <td>@(e.JobTitle ?? "Technician")<br /><small>R @e.DefaultHourlyRate.ToString("N0")/hr</small></td>
                        <td class="text-end">@e.Hours.ToString("N1") <small class="text-muted">/ @e.MandatoryHoursPerMonth.ToString("N0")</small></td>
                        <td class="text-end">R @e.GrossPay.ToString("N2")</td>
                        <td class="text-end">R @e.Deductions.ToString("N2")</td>
                        <td class="text-end"><strong>R @e.NetPay.ToString("N2")</strong></td>
                        <td>@e.LaborEntryCount</td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-testid="payroll-view-payslip" @onclick="() => ViewPayslip(e)" @onclick:stopPropagation="true">View Payslip</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-testid="payroll-view-timesheet" @onclick="() => OpenTimesheetAsync(e)" @onclick:stopPropagation="true">Timesheet</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="d-flex align-items-center gap-2 mt-2" data-testid="payroll-pager">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-page-first" disabled="@(_page <= 1)" @onclick="() => GoPage(1)">First</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-page-prev" disabled="@(_page <= 1)" @onclick="() => GoPage(_page - 1)">Previous</button>
            <span class="small text-muted" data-testid="payroll-page-status">Page @_page / @_totalPages (@employees.Count employees)</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-page-next" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_page + 1)">Next</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-page-last" disabled="@(_page >= _totalPages)" @onclick="() => GoPage(_totalPages)">Last</button>
            <select class="form-select form-select-sm w-auto" data-testid="payroll-page-size" value="@_pageSize" @onchange="OnPageSizeSelected">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
        <p class="small text-muted mb-0">Period: @_periodLabel (UTC). Only labor with a linked employee is included. Deductions: @_deductionPercent% + R @_fixedDeductions.ToString("N0") fixed.</p>
    </div>
}

@if (_timesheetEmployeeId != null)
{
    <div class="card mt-3" data-testid="payroll-timesheet">
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <strong>Weekly timesheet</strong>
            @if (_timesheet != null)
            {
                <span data-testid="payroll-timesheet-week" data-week-start="@_timesheet.WeekStartUtc.ToString("yyyy-MM-dd")">
                    @_timesheet.EmployeeNumber @_timesheet.Name · @_timesheet.Days[0].Date.ToString("dd MMM yyyy") to @_timesheet.Days[6].Date.ToString("dd MMM yyyy")
                </span>
            }
            <div class="ms-auto d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-timesheet-prev" @onclick="() => ShiftTimesheetAsync(-1)" disabled="@_timesheetLoading">Previous week</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-timesheet-next" @onclick="() => ShiftTimesheetAsync(1)" disabled="@_timesheetLoading">Next week</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="payroll-timesheet-close" @onclick="CloseTimesheet">Close</button>
            </div>
        </div>
        <div class="card-body">
            @if (_timesheetLoading)
            {
                <ListSkeleton Rows="3" TestId="payroll-timesheet-loading" AriaLabel="Loading timesheet" />
            }
            else if (_timesheet == null)
            {
                <div class="alert alert-warning mb-0" data-testid="payroll-timesheet-missing">That employee is not on this company.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm mb-0" data-testid="payroll-timesheet-grid">
                        <thead>
                            <tr>
                                <th>Job</th>
                                @foreach (var day in _timesheet.Days)
                                {
                                    <th class="text-end">@day.Label<br /><small class="text-muted">@day.Date.ToString("dd MMM")</small></th>
                                }
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_timesheet.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-muted" data-testid="payroll-timesheet-empty">No hours posted this week.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in _timesheet.Rows)
                                {
                                    <tr data-testid="payroll-timesheet-row">
                                        <td>
                                            @TimesheetJobLabel(row)
                                            @if (row.JobClosed)
                                            {
                                                <span class="badge bg-secondary ms-1" data-testid="payroll-timesheet-closed">Closed</span>
                                            }
                                        </td>
                                        @foreach (var hours in row.HoursByDay)
                                        {
                                            <td class="text-end" data-testid="payroll-timesheet-cell">@FormatHours(hours)</td>
                                        }
                                        <td class="text-end" data-testid="payroll-timesheet-row-total">@FormatHours(row.TotalHours)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr data-testid="payroll-timesheet-totals">
                                <th>Total</th>
                                @foreach (var day in _timesheet.Days)
                                {
                                    <th class="text-end">@FormatHours(day.Hours)</th>
                                }
                                <th class="text-end" data-testid="payroll-timesheet-grand-total">@FormatHours(_timesheet.TotalHours)</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p class="small text-muted mb-0 mt-2">Read-only. Hours already posted on a closed job stay on this week.</p>
            }
        </div>
    </div>
}

@if (selectedEmp != null)
{
    <FormModal IsOpen="true"
               Title="@($"Payslip — {selectedEmp.EmployeeNumber} {selectedEmp.Name} — {_periodLabel}")"
               Size="md"
               TestId="payroll-payslip-card"
               OnClose="ClosePayslip">
        <ChildContent>
            <p class="mb-1">Title: @(selectedEmp.JobTitle ?? "—")</p>
            <p class="mb-1">Hours from JobLabor: @selectedEmp.Hours.ToString("N1") (mandatory capacity @selectedEmp.MandatoryHoursPerMonth.ToString("N0") h/mo)</p>
            <p class="mb-1">Gross: R @selectedEmp.GrossPay.ToString("N2")</p>
            <p class="mb-1">Deductions: R @selectedEmp.Deductions.ToString("N2")</p>
            <p class="fs-5 mb-3"><strong>Net pay: R @selectedEmp.NetPay.ToString("N2")</strong></p>
            <small class="text-muted d-block">@selectedEmp.LaborEntryCount JobLabor record(s). Not a SARS IRP5 / statutory payroll run.</small>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="ClosePayslip">Close</button>
            <button class="btn btn-outline-success" data-testid="payroll-download-payslip" @onclick="DownloadPayslipCsv">CSV</button>
            <button class="btn btn-primary" data-testid="payroll-download-payslip-pdf" @onclick="DownloadPayslipPdf">PDF</button>
        </Footer>
    </FormModal>
}

@code {
    private List<PayrollEmployeeSummary> employees = new();
    private int _page = 1;
    private int _pageSize = 25;
    private int SafePageSize => _pageSize is 50 or 100 ? _pageSize : 25;
    private int _totalPages => Math.Max(1, (int)Math.Ceiling(employees.Count / (double)SafePageSize));
    private IEnumerable<PayrollEmployeeSummary> PagedEmployees =>
        employees.Skip((_page - 1) * SafePageSize).Take(SafePageSize);

    private void GoPage(int page)
    {
        _page = Math.Clamp(page, 1, _totalPages);
    }

    private void OnPageSizeSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size is 25 or 50 or 100)
            _pageSize = size;
        _page = 1;
    }

    private PayrollEmployeeSummary? selectedEmp;
    private Guid? _timesheetEmployeeId;
    private WeeklyTimesheet? _timesheet;
    private bool _timesheetLoading;
    private DateTime _timesheetAnchor = DateTime.UtcNow;

    private void ClosePayslip() => selectedEmp = null;

    private void CloseTimesheet()
    {
        _timesheet = null;
        _timesheetEmployeeId = null;
    }

    private async Task OpenTimesheetAsync(PayrollEmployeeSummary employee)
    {
        _timesheetEmployeeId = employee.EmployeeId;
        var month = ParsePeriodMonth();
        var today = DateTime.UtcNow;
        _timesheetAnchor = today.Year == month.Year && today.Month == month.Month ? today : month;
        await LoadTimesheetAsync();
    }

    private async Task ShiftTimesheetAsync(int weeks)
    {
        _timesheetAnchor = (_timesheet?.WeekStartUtc ?? _timesheetAnchor).AddDays(7 * weeks);
        await LoadTimesheetAsync();
    }

    private async Task LoadTimesheetAsync()
    {
        if (_timesheetEmployeeId == null) return;
        _timesheetLoading = true;
        try
        {
            _timesheet = await PayrollService.GetWeeklyTimesheetAsync(_timesheetEmployeeId.Value, _timesheetAnchor);
        }
        catch (Exception ex)
        {
            _timesheet = null;
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _timesheetLoading = false;
        }
    }

    private static string TimesheetJobLabel(WeeklyTimesheetRow row)
    {
        if (string.IsNullOrWhiteSpace(row.JobNumber))
            return string.IsNullOrWhiteSpace(row.JobTitle) ? "Job" : row.JobTitle;
        if (string.IsNullOrWhiteSpace(row.JobTitle))
            return row.JobNumber;
        return $"{row.JobNumber} — {row.JobTitle}";
    }

    private static string FormatHours(decimal hours) => hours.ToString("0.##");
    private TenantBranding _branding = TenantBranding.Default;
    private bool _loading = true;
    private string _periodLabel = DateTime.UtcNow.ToString("MMMM yyyy");
    private string _periodMonth = DateTime.UtcNow.ToString("yyyy-MM");
    private decimal _deductionPercent = 1m;
    private decimal _fixedDeductions = 0m;

    private bool CanManage =>
        CurrentUserService.Permissions.Contains(Permissions.PayrollManage)
        || CurrentUserService.Permissions.Contains(Permissions.EmployeesManage)
        || CurrentUserService.Permissions.Contains(Permissions.TenantsManage);

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUserService.TenantId != Guid.Empty)
        {
            var tenant = await TenantService.GetByIdAsync(CurrentUserService.TenantId);
            _branding = TenantBranding.From(tenant);
        }

        await RefreshPayslipsAsync(showToast: false);
    }

    private async Task OnMonthInputChanged(ChangeEventArgs e)
    {
        _periodMonth = e.Value?.ToString() ?? DateTime.UtcNow.ToString("yyyy-MM");
        await RefreshPayslipsAsync(showToast: false);
    }

    private Task RefreshPayslipsAsync() => RefreshPayslipsAsync(showToast: true);

    private async Task RefreshPayslipsAsync(bool showToast)
    {
        _loading = true;
        selectedEmp = null;
        CloseTimesheet();
        try
        {
            var month = ParsePeriodMonth();
            _periodLabel = month.ToString("MMMM yyyy");
            employees = (await PayrollService.GetMonthlySummariesAsync(month, _deductionPercent, _fixedDeductions)).ToList();
            _page = 1;
            if (showToast && CanManage)
            {
                var withLabor = employees.Count(e => e.LaborEntryCount > 0);
                ToastService.ShowSuccess($"Payslips loaded for {_periodLabel}: {withLabor} employee(s) with JobLabor.");
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private DateTime ParsePeriodMonth()
    {
        if (DateTime.TryParse($"{_periodMonth}-01", out var dt))
            return DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        return DateTime.UtcNow;
    }

    private void ViewPayslip(PayrollEmployeeSummary e) => selectedEmp = e;

    private async Task ExportPeriodCsvAsync()
    {
        try
        {
            var month = ParsePeriodMonth();
            var csv = await PayrollService.ExportMonthlyCsvAsync(month, _deductionPercent, _fixedDeductions);
            if (string.IsNullOrWhiteSpace(csv) || csv.Split('\n').Length <= 1)
            {
                ToastService.ShowInfo("No payroll rows to export for this period.");
                return;
            }

            await JS.InvokeVoidAsync("meterpUi.downloadText",
                $"payroll-{month:yyyy-MM}.csv", csv, "text/csv;charset=utf-8");
            ToastService.ShowSuccess($"Payroll CSV downloaded for {month:MMMM yyyy}.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task DownloadPayslipCsv()
    {
        if (selectedEmp == null) return;

        var single = await PayrollService.GetEmployeeSummaryAsync(
            selectedEmp.EmployeeId, ParsePeriodMonth(), _deductionPercent, _fixedDeductions)
            ?? selectedEmp;

        var csv = string.Join(Environment.NewLine, new[]
        {
            $"Employee Number,{single.EmployeeNumber}",
            $"Employee,{single.Name}",
            $"Title,{single.JobTitle}",
            $"Period,{_periodLabel}",
            $"Hours,{single.Hours:N2}",
            $"Mandatory Hours/Month,{single.MandatoryHoursPerMonth:N0}",
            $"Gross Pay,R {single.GrossPay:N2}",
            $"Deductions,R {single.Deductions:N2}",
            $"Net Pay,R {single.NetPay:N2}",
            $"Labor Entries,{single.LaborEntryCount}"
        });

        var safeName = single.Name.Replace(' ', '-').ToLowerInvariant();
        await JS.InvokeVoidAsync("meterpUi.downloadText", $"payslip-{safeName}-{_periodLabel.Replace(' ', '-')}.csv", csv, "text/csv;charset=utf-8");
        ToastService.ShowSuccess($"Payslip CSV downloaded for {single.Name}.");
    }

    private async Task DownloadPayslipPdf()
    {
        if (selectedEmp == null) return;

        var pdf = PayslipPdfGenerator.Generate(
            selectedEmp.Name,
            _periodLabel,
            selectedEmp.Hours,
            selectedEmp.GrossPay,
            selectedEmp.Deductions,
            selectedEmp.LaborEntryCount,
            _branding,
            selectedEmp.EmployeeNumber,
            selectedEmp.JobTitle);

        var safeName = selectedEmp.Name.Replace(' ', '-').ToLowerInvariant();
        await JS.InvokeVoidAsync("meterpUi.downloadBytes", $"payslip-{safeName}-{_periodLabel.Replace(' ', '-')}.pdf",
            Convert.ToBase64String(pdf), "application/pdf");
        ToastService.ShowSuccess($"Payslip PDF downloaded for {selectedEmp.Name}.");
    }
}
