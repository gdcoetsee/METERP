@page "/invoices"
@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Domain
@using METERP.Common
@using METERP.Web.Reports
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "Invoices.View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IInvoiceService InvoiceService
@inject IJobService JobService
@inject ITenantService TenantService
@inject ICurrentUserService CurrentUserService
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>Invoices</PageTitle>

@if (!_loading)
{
    <span data-testid="invoices-ready" class="visually-hidden">ready</span>
}

@if (_agedDebtors.Count > 0)
{
    <div class="card mb-3 border-warning" data-testid="aged-debtors-summary">
        <div class="card-body py-2">
            <strong>Aged debtors:</strong>
            <span class="ms-2">@_agedDebtors.Count open invoice(s)</span>
            <span class="ms-2 text-danger">R @_agedDebtors.Sum(d => d.BalanceDue).ToString("N2") outstanding</span>
            <span class="ms-2 small text-muted">Net of open credit notes</span>
            <span class="ms-2 small text-muted">Buckets: @string.Join(", ", _agedDebtors.GroupBy(d => d.AgingBucket).Select(g => $"{g.Key} ({g.Count()})"))</span>
        </div>
        @if (_agedDebtors.Any(d => d.DaysOverdue > 0))
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0" data-testid="aged-debtors-overdue-table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Due</th>
                            <th class="text-end">Days</th>
                            <th class="text-end">Balance</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _agedDebtors.Where(d => d.DaysOverdue > 0).Take(8))
                        {
                            <tr class="meterp-row-click" @onclick="() => OpenAgedInvoice(row)" title="Open invoice">
                                <td>@row.InvoiceNumber</td>
                                <td>@row.CustomerName</td>
                                <td>@row.DueDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end text-danger">@row.DaysOverdue</td>
                                <td class="text-end">R @row.BalanceDue.ToString("N2")</td>
                                <td class="text-end">
                                    @if (UserCanManage)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-testid="invoice-chase"
                                                disabled="@_chasing"
                                                @onclick="() => ChaseOverdueAsync(row.InvoiceId)"
                                                @onclick:stopPropagation="true">Chase</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<PageHeader Title="Invoices" Subtitle="Bill completed work. Record payments here; invoicing does not close the job." TestId="invoices-page-header">
    <Actions>
        <ExportToolbar TestId="invoices-export" OnExportCsv="ExportInvoicesCsvAsync" OnExportExcel="ExportInvoicesExcelAsync" OnExportPdf="ExportInvoicesPdfAsync" Disabled="@_loading" />
        @if (UserCanManage)
        {
            <button class="btn btn-primary" @onclick="ShowCreateForm"
                    disabled="@InvoiceQuotaBlocked"
                    title="@(InvoiceQuotaBlocked ? TenantQuotaDefaults.GetQuotaTooltip(_tenant!, QuotaType.Invoice, "Invoices") : null)"
                    data-testid="new-invoice-button">New invoice</button>
        }
    </Actions>
</PageHeader>

@if (InvoiceQuotaBlocked)
{
    <div class="alert alert-warning" data-testid="invoices-quota-exceeded-banner" role="alert">
        <strong>Invoice quota reached.</strong>
        @TenantQuotaDefaults.GetQuotaTooltip(_tenant!, QuotaType.Invoice, "Invoices")
        <a href="/account" class="alert-link ms-1">View plan &amp; usage</a>
    </div>
}

<div class="meterp-filter-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control" data-testid="invoices-search" placeholder="Search invoice #, customer or job..."
               @bind="searchTerm" @bind:event="oninput" @bind:after="OnSearchChangedAsync" />
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Clear search">Clear</button>
        }
    </div>
    <div class="form-check ms-2 mb-0">
        <input class="form-check-input" type="checkbox" id="invoices-unlinked-only"
               data-testid="invoices-unlinked-only"
               @bind="_unlinkedOnly" @bind:after="OnUnlinkedFilterChanged" />
        <label class="form-check-label" for="invoices-unlinked-only">Unlinked</label>
    </div>
    <div class="form-check ms-2 mb-0">
        <input class="form-check-input" type="checkbox" id="invoices-unlinked-credits"
               data-testid="invoices-unlinked-credits"
               @bind="_unlinkedCreditsOnly" @bind:after="OnUnlinkedCreditsFilterChanged" />
        <label class="form-check-label" for="invoices-unlinked-credits">Unlinked credits</label>
    </div>
</div>

@if (_loading)
{
    <ListSkeleton Rows="6" TestId="invoices-loading" AriaLabel="Loading invoices" />
}
else if (invoices == null || !invoices.Any())
{
    @if (!string.IsNullOrEmpty(searchTerm) || _unlinkedOnly || _unlinkedCreditsOnly)
    {
        <div class="alert alert-warning">No invoices match. <button class="btn btn-sm btn-link p-0" @onclick="ClearSearch">Clear filters</button></div>
    }
    else
    {
        <div class="alert alert-info">No invoices yet. Create one manually or convert from a completed job.</div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-hover" data-testid="invoices-table">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Customer / Job</th>
                    <th>Date / Due</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Balance</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in invoices)
                {
                    <tr style="cursor:pointer;" @onclick="() => ViewInvoice(inv)" title="Open invoice">
                        <td><strong>@inv.InvoiceNumber</strong></td>
                        <td>
                            @(inv.Customer?.Name ?? "—")<br />
                            @if (inv.JobId == null)
                            {
                                <span class="badge bg-light text-dark border" data-testid="invoice-unlinked">Unlinked</span>
                                @if (InvoiceLegacyRef.TryReadTrfId(inv.Notes) is { } listTrf)
                                {
                                    <small class="text-muted ms-1">TRF @listTrf</small>
                                }
                            }
                            else if (inv.Job != null)
                            {
                                <a href="@($"/jobs/{inv.Job.Id}")" class="small" data-testid="invoice-job-link" @onclick:stopPropagation="true">@inv.Job.JobNumber</a>
                            }
                            else
                            {
                                <small class="text-muted">Linked job unavailable</small>
                            }
                        </td>
                        <td>@inv.InvoiceDate.ToString("yyyy-MM-dd")<br /><small class="text-muted">Due @inv.DueDate.ToString("yyyy-MM-dd")</small></td>
                        <td data-testid="invoice-type">
                            @((MarkupString)GetDocumentTypeBadge(inv.DocumentType))
                            @if (inv.DocumentType == InvoiceDocumentType.CreditNote && inv.CreditNoteForInvoiceId == null)
                            {
                                <div><span class="badge bg-warning text-dark" data-testid="invoice-unlinked-credit">Unlinked credit note</span></div>
                            }
                            else if (inv.DocumentType == InvoiceDocumentType.CreditNote)
                            {
                                <div class="small text-muted" data-testid="invoice-credit-for">for @(inv.CreditNoteForInvoice?.InvoiceNumber ?? "parent")</div>
                            }
                        </td>
                        <td>@((MarkupString)GetStatusBadge(inv.Status))</td>
                        <td class="text-end @(inv.DocumentType == InvoiceDocumentType.CreditNote ? "text-danger" : "")"
                            data-testid="@(inv.DocumentType == InvoiceDocumentType.CreditNote ? "invoice-credit-amount" : "invoice-amount")">
                            @InvoiceCreditConvention.FormatDocumentAmount(inv.DocumentType, inv.Total)
                        </td>
                        <td class="text-end @(inv.DocumentType == InvoiceDocumentType.CreditNote && inv.BalanceDue > 0 ? "text-danger" : "")">
                            @InvoiceCreditConvention.FormatDocumentBalance(inv.DocumentType, inv.BalanceDue)
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ViewInvoice(inv)" @onclick:stopPropagation="true" data-testid="view-invoice">View</button>
                            @if (UserCanManage)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditInvoice(inv)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteInvoice(inv)">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(currentPage <= 1)">Previous</button>
        <span class="text-muted small">Page @currentPage</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(invoices.Count < PageSize)">Next</button>
    </div>
}

@if (showForm)
{
    <FormModal IsOpen="true"
               Title="@(isEditing ? "Edit invoice" : "New invoice")"
               Size="md"
               TestId="invoice-form-modal"
               CloseOnBackdrop="false"
               OnClose="CancelForm">
        <ChildContent>
            <EditForm Model="currentInvoice" OnValidSubmit="SaveInvoice" FormName="InvoiceForm">
                <p class="meterp-field-hint mb-3">Prefer creating from a signed-off job when you can — line items and travel copy across automatically.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label meterp-required">Invoice date</label>
                        <InputDate class="form-control" @bind-Value="currentInvoice.InvoiceDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label meterp-required">Due date</label>
                        <InputDate class="form-control" @bind-Value="currentInvoice.DueDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">VAT rate</label>
                        <InputNumber class="form-control" @bind-Value="currentInvoice.TaxRate" step="0.01" />
                        <span class="meterp-field-hint">South Africa standard is 0.15 (15%).</span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes <span class="text-muted fw-normal">(optional)</span></label>
                        <InputTextArea class="form-control" @bind-Value="currentInvoice.Notes" rows="2" />
                    </div>
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveInvoice">Save invoice</button>
        </Footer>
    </FormModal>
}

@if (selectedInvoice != null)
{
    <FormModal IsOpen="true"
               Title="@($"{selectedInvoice.InvoiceNumber} — {selectedInvoice.Customer?.Name}")"
               Size="full"
               TestId="invoice-detail"
               BackdropTestId="invoice-detail-backdrop"
               CloseOnBackdrop="false"
               OnClose="CloseInvoiceView">
        <ChildContent>
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Type:</strong> @((MarkupString)GetDocumentTypeBadge(selectedInvoice.DocumentType))<br />
                    <strong>Status:</strong> @((MarkupString)GetStatusBadge(selectedInvoice.Status))<br />
                    <strong>Due:</strong> @selectedInvoice.DueDate.ToString("yyyy-MM-dd")
                    @if (UserCanManage && selectedInvoice.BalanceDue > 0
                         && InvoiceBillingCalculator.GetDaysOverdue(selectedInvoice.DueDate, DateTime.UtcNow) > 0
                         && selectedInvoice.DocumentType is not (InvoiceDocumentType.Proforma or InvoiceDocumentType.CreditNote)
                         && selectedInvoice.Status is not (InvoiceStatus.Draft or InvoiceStatus.Cancelled))
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger ms-2"
                                data-testid="invoice-chase-detail"
                                disabled="@_chasing"
                                @onclick="() => ChaseOverdueAsync(selectedInvoice.Id)">Chase payment</button>
                    }
                    @if (selectedInvoice.RetentionAmount > 0)
                    {
                        <br /><strong>Retention held:</strong> @($"R {selectedInvoice.RetentionAmount:N2} ({selectedInvoice.RetentionPercent:N0}%)")
                    }
                </div>
                <div class="col-md-6 text-md-end">
                    <div>Subtotal: <strong>@InvoiceCreditConvention.FormatDocumentAmount(selectedInvoice.DocumentType, selectedInvoice.Subtotal)</strong></div>
                    <div>Tax: @InvoiceCreditConvention.FormatDocumentAmount(selectedInvoice.DocumentType, selectedInvoice.Tax)</div>
                    <div class="fs-5">Total: <strong data-testid="invoice-detail-total">@InvoiceCreditConvention.FormatDocumentAmount(selectedInvoice.DocumentType, selectedInvoice.Total)</strong></div>
                    <div>Paid: R @selectedInvoice.AmountPaid.ToString("N2") · Balance: <strong>@InvoiceCreditConvention.FormatDocumentBalance(selectedInvoice.DocumentType, selectedInvoice.BalanceDue)</strong></div>
                    @if (selectedInvoice.DocumentType == InvoiceDocumentType.CreditNote)
                    {
                        @if (selectedInvoice.Status == InvoiceStatus.Draft)
                        {
                            <div class="small text-muted">Draft credit note — it does not reduce the customer balance until it is issued.</div>
                        }
                        else if (selectedInvoice.Status == InvoiceStatus.Cancelled)
                        {
                            <div class="small text-muted">Cancelled credit note — it does not reduce the customer balance.</div>
                        }
                        else
                        {
                            <div class="small text-muted">Credit note — stored as a positive total and shown as a credit. It reduces the customer balance.</div>
                        }
                    }
                    @if (selectedInvoice.RetentionAmount > 0)
                    {
                        <div class="small text-muted">Net collectable (excl. retention): R @selectedInvoice.NetCollectable.ToString("N2")</div>
                    }
                </div>
            </div>

            @if (selectedInvoice.DocumentType == InvoiceDocumentType.CreditNote)
            {
                <div class="mb-3 border rounded p-3" data-testid="invoice-credit-panel">
                    @if (selectedInvoice.CreditNoteForInvoiceId is Guid && selectedInvoice.CreditNoteForInvoice != null)
                    {
                        <strong>Credit for</strong>
                        <a href="@($"/invoices?open={selectedInvoice.CreditNoteForInvoice.Id}")"
                           data-testid="invoice-credit-parent">@selectedInvoice.CreditNoteForInvoice.InvoiceNumber</a>
                    }
                    else if (selectedInvoice.CreditNoteForInvoiceId != null)
                    {
                        <span class="badge bg-light text-dark border">Parent invoice is not available</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark" data-testid="invoice-unlinked-credit">Unlinked credit note</span>
                        <p class="small text-muted mb-2 mt-2">No parent invoice is linked. Once issued, this credit reduces the customer balance.</p>
                        @if (UserCanManage)
                        {
                            <div class="input-group input-group-sm">
                                <input class="form-control" data-testid="invoice-credit-parent-search" placeholder="Parent invoice number"
                                       @bind="_parentInvoiceNumber" @bind:event="oninput" />
                                <button type="button" class="btn btn-outline-primary" data-testid="invoice-credit-parent-link" @onclick="LinkCreditParentAsync">Link parent</button>
                            </div>
                        }
                    }
                    @if (UserCanManage && selectedInvoice.Status == InvoiceStatus.Draft)
                    {
                        <p class="small text-muted mb-2 mt-2">Issue this draft so the VAT-inclusive credit reduces what the customer owes.</p>
                        <button type="button" class="btn btn-sm btn-warning" data-testid="invoice-issue-credit-note" @onclick="IssueCreditNoteAsync">Issue credit note</button>
                    }
                </div>
            }

            @if (selectedInvoice.JobId == null)
            {
                <div class="mb-3 border rounded p-3" data-testid="invoice-link-panel">
                    <span class="badge bg-light text-dark border" data-testid="invoice-unlinked">Unlinked</span>
                    @if (InvoiceLegacyRef.TryReadTrfId(selectedInvoice.Notes) is { } detailTrf)
                    {
                        <span class="ms-2">TRF <strong>@detailTrf</strong></span>
                    }
                    <p class="small text-muted mb-2 mt-2">
                        This total is the invoice amount only. It is not the job quoted or actual total.
                        Linking a job does not close the job.
                    </p>
                    @if (UserCanManage)
                    {
                        <div class="input-group input-group-sm">
                            <input class="form-control" data-testid="invoice-link-search" placeholder="Job number or TRFid"
                                   @bind="_linkJobSearch" @bind:event="oninput" />
                            <button type="button" class="btn btn-outline-secondary" data-testid="invoice-link-find" @onclick="SearchLinkJobsAsync">Find</button>
                        </div>
                        @if (_linkSearched && _linkCandidates.Count == 0)
                        {
                            <p class="small text-muted mt-2 mb-0">No job matched that number.</p>
                        }
                        @foreach (var job in _linkCandidates)
                        {
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                <span>
                                    <strong>@job.JobNumber</strong> — @job.Title
                                    <span class="text-muted small">@job.Status · @(job.Customer?.Name ?? "—")</span>
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-testid="invoice-link-job"
                                        @onclick="() => LinkJobAsync(job)">Link job</button>
                            </div>
                        }
                    }
                </div>
            }
            else if (selectedInvoice.Job != null)
            {
                <div class="mb-2">
                    <strong>Linked job:</strong>
                    <a href="@($"/jobs/{selectedInvoice.Job.Id}")" data-testid="invoice-job-link">@selectedInvoice.Job.JobNumber</a>
                    <span class="text-muted small ms-2">Invoice total stays on this document. The job is not closed by this invoice.</span>
                </div>
            }
            else
            {
                <div class="mb-2 text-muted small">This invoice has a job id, but that job is not available. Totals on this document are the invoice amounts.</div>
            }

            <h6 data-testid="invoice-line-items-header">Line Items (@selectedInvoice.Lines.Count(l => !l.IsDeleted))</h6>

            @if (selectedInvoice.Lines.Any(l => !l.IsDeleted))
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th>Type</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Line Total</th>
                            @if (UserCanManage) { <th></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in selectedInvoice.Lines.Where(l => !l.IsDeleted))
                        {
                            <tr>
                                <td>@line.Description</td>
                                <td class="text-end">@line.Quantity @line.Unit</td>
                                <td><span class="badge bg-light text-dark">@line.LineType</span></td>
                                <td class="text-end">@InvoiceCreditConvention.FormatDocumentAmount(selectedInvoice.DocumentType, line.UnitPrice)</td>
                                <td class="text-end"><strong>@InvoiceCreditConvention.FormatDocumentAmount(selectedInvoice.DocumentType, line.LineTotal)</strong></td>
                                @if (UserCanManage)
                                {
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => EditLine(line)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" @onclick="() => DeleteLine(line)">Del</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No line items.</p>
            }

            @if (UserCanManage)
            {
                <button class="btn btn-outline-success btn-sm" @onclick="ShowAddLineForm">+ Add Line</button>
            }

            @if (showLineForm && editingLine != null)
            {
                <div class="mt-2 p-3 border rounded bg-light">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <InputText class="form-control form-control-sm" @bind-Value="editingLine.Description" placeholder="Description" />
                        </div>
                        <div class="col-md-2">
                            <InputNumber class="form-control form-control-sm" @bind-Value="editingLine.Quantity" />
                        </div>
                        <div class="col-md-2">
                            <InputText class="form-control form-control-sm" @bind-Value="editingLine.Unit" placeholder="Unit" />
                        </div>
                        <div class="col-md-2">
                            <select class="form-select form-select-sm" @bind="editingLine.LineType">
                                <option>Material</option>
                                <option>Labour</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <InputNumber class="form-control form-control-sm" @bind-Value="editingLine.UnitPrice" step="0.01" />
                        </div>
                    </div>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-success" @onclick="SaveLine">Save Line</button>
                        <button class="btn btn-sm btn-secondary ms-1" @onclick="CancelLineForm">Cancel</button>
                    </div>
                </div>
            }

            @if (selectedInvoice.DocumentType != InvoiceDocumentType.Proforma && selectedInvoice.DocumentType != InvoiceDocumentType.CreditNote)
            {
                <h6 class="mt-4" data-testid="invoice-payments-header">Payments (@_payments.Count)</h6>
                @if (_payments.Any())
                {
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Amount</th><th>Reference</th><th>POP</th></tr></thead>
                        <tbody>
                            @foreach (var p in _payments)
                            {
                                <tr data-testid="invoice-payment-row">
                                    <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                    <td>R @p.Amount.ToString("N2")</td>
                                    <td>@(p.Reference ?? "—")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.PopStorageKey))
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0" data-testid="invoice-pop-download"
                                                    @onclick="() => DownloadPopAsync(p)">@(p.PopFileName ?? "Download")</button>
                                        }
                                        else
                                        {
                                            <span>—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted small">No payments recorded yet.</p>
                }

                @if (UserCanManage && selectedInvoice.BalanceDue > 0)
                {
                    <div class="border rounded p-3 bg-light" data-testid="invoice-record-payment">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label small">Amount</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_paymentAmount" step="0.01" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Date</label>
                                <InputDate class="form-control form-control-sm" @bind-Value="_paymentDate" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Reference</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_paymentReference" placeholder="EFT ref" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">POP attachment</label>
                                <InputFile class="form-control form-control-sm" OnChange="OnPopSelected" accept=".pdf,.png,.jpg,.jpeg" data-testid="invoice-pop-upload" />
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-sm btn-success w-100" @onclick="RecordPaymentAsync" data-testid="invoice-record-payment-btn">Record payment</button>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (UserCanManage)
            {
                <div class="mt-3 d-flex gap-2 flex-wrap">
                    @if (selectedInvoice.DocumentType != InvoiceDocumentType.CreditNote && selectedInvoice.DocumentType != InvoiceDocumentType.Proforma)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning" @onclick="CreateCreditNoteAsync" data-testid="invoice-create-credit-note">Create credit note</button>
                    }
                </div>
                @if (selectedInvoice.DocumentType != InvoiceDocumentType.CreditNote && selectedInvoice.DocumentType != InvoiceDocumentType.Proforma)
                {
                    <div class="border rounded p-3 mt-3" data-testid="invoice-partial-credit">
                        <div class="small text-muted mb-2">
                            Credit part of this invoice. The amount is VAT-inclusive (R 115.00 at 15% stores R 100.00 ex-VAT and R 15.00 VAT).
                            Enter an amount or a percent, not both. Balance due R @selectedInvoice.BalanceDue.ToString("N2").
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small">Reason</label>
                                <InputText class="form-control form-control-sm" @bind-Value="_creditReason" data-testid="invoice-credit-reason" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Amount incl. VAT</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_creditAmount" step="0.01" data-testid="invoice-credit-amount" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Or percent</label>
                                <InputNumber class="form-control form-control-sm" @bind-Value="_creditPercent" step="0.01" data-testid="invoice-credit-percent" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-sm btn-outline-warning w-100" @onclick="CreatePartialCreditNoteAsync" data-testid="invoice-create-partial-credit">Credit this amount</button>
                            </div>
                        </div>
                    </div>
                }
                <div class="mt-4">
                    <strong>Update Status:</strong>
                    <div class="btn-group mt-1" role="group">
                        @foreach (var s in Enum.GetValues<InvoiceStatus>())
                        {
                            <button class="btn btn-sm @(selectedInvoice.Status == s ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => UpdateStatus(s)">
                                @s
                            </button>
                        }
                    </div>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-outline-secondary" @onclick="CloseInvoiceView" data-testid="close-invoice-view">Close</button>
        </Footer>
    </FormModal>
}

@code {
    private List<Invoice> invoices = new();
    private List<AgedDebtorRow> _agedDebtors = new();
    private List<InvoicePayment> _payments = new();
    private decimal _paymentAmount;
    private DateTime _paymentDate = DateTime.UtcNow.Date;
    private string _paymentReference = "";
    private IBrowserFile? _popFile;
    private Invoice currentInvoice = new();
    private Invoice? selectedInvoice;
    private bool showForm;
    private bool isEditing;
    private string searchTerm = string.Empty;
    private bool _unlinkedOnly;
    private bool _unlinkedCreditsOnly;
    private string _parentInvoiceNumber = "";
    private string _creditReason = "";
    private decimal? _creditAmount;
    private decimal? _creditPercent;
    private string _linkJobSearch = string.Empty;
    private List<Job> _linkCandidates = new();
    private bool _linkSearched;
    private int currentPage = 1;
    private const int PageSize = 10;
    private bool _loading = true;
    private bool _chasing;
    private TenantBranding _branding = TenantBranding.Default;
    private Tenant? _tenant;
    private bool InvoiceQuotaBlocked =>
        _tenant != null && TenantQuotaDefaults.IsAtOrOverLimit(_tenant, QuotaType.Invoice);

    private bool showLineForm;
    private InvoiceLine? editingLine;

    private bool UserCanManage => CurrentUserService.Permissions.Contains(Permissions.InvoicesManage);

    [SupplyParameterFromQuery(Name = "open")]
    public Guid? OpenInvoiceId { get; set; }

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(QuerySearch))
                searchTerm = QuerySearch;
            if (CurrentUserService.TenantId != Guid.Empty)
            {
                _tenant = await TenantService.GetByIdAsync(CurrentUserService.TenantId);
                _branding = TenantBranding.From(_tenant);
            }

            await LoadInvoices();
            _agedDebtors = (await InvoiceService.GetAgedDebtorsAsync()).ToList();

            if (OpenInvoiceId is { } openId && openId != Guid.Empty)
            {
                var opened = await InvoiceService.GetByIdAsync(openId);
                if (opened != null)
                    await ViewInvoice(opened);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadInvoices()
    {
        var term = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim();
        invoices = (await InvoiceService.GetAllAsync(term, currentPage, PageSize, unlinkedOnly: _unlinkedOnly, unlinkedCreditsOnly: _unlinkedCreditsOnly)).ToList();
        _agedDebtors = (await InvoiceService.GetAgedDebtorsAsync()).ToList();
    }

    private async Task OnSearchChangedAsync()
    {
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        _unlinkedOnly = false;
        _unlinkedCreditsOnly = false;
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task OnUnlinkedFilterChanged()
    {
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task OnUnlinkedCreditsFilterChanged()
    {
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadInvoices();
        }
    }

    private async Task NextPage()
    {
        currentPage++;
        await LoadInvoices();
    }

    private void ShowCreateForm()
    {
        if (InvoiceQuotaBlocked)
        {
            ToastService.ShowError(TenantQuotaDefaults.GetQuotaTooltip(_tenant!, QuotaType.Invoice, "Invoices"));
            return;
        }

        currentInvoice = new Invoice
        {
            InvoiceDate = DateTime.UtcNow,
            DueDate = DateTime.UtcNow.AddDays(30),
            TaxRate = 0.15m
        };
        isEditing = false;
        showForm = true;
        selectedInvoice = null;
    }

    private void EditInvoice(Invoice inv)
    {
        currentInvoice = new Invoice
        {
            Id = inv.Id,
            InvoiceNumber = inv.InvoiceNumber,
            InvoiceDate = inv.InvoiceDate,
            DueDate = inv.DueDate,
            Status = inv.Status,
            Notes = inv.Notes,
            TaxRate = inv.TaxRate
        };
        isEditing = true;
        showForm = true;
        selectedInvoice = null;
    }

    private async Task SaveInvoice()
    {
        try
        {
            if (isEditing)
            {
                await InvoiceService.UpdateAsync(currentInvoice);
            }
            else
            {
                await InvoiceService.CreateAsync(currentInvoice);
            }

            showForm = false;
            ToastService.ShowSuccess("Invoice saved successfully.");
            await LoadInvoices();
            currentInvoice = new();
        }
        catch (QuotaExceededException ex)
        {
            ToastService.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {ex.Message}");
        }
    }

    private void CancelForm()
    {
        showForm = false;
        currentInvoice = new();
    }

    private async Task OpenAgedInvoice(AgedDebtorRow row)
    {
        var inv = await InvoiceService.GetByIdAsync(row.InvoiceId);
        if (inv != null)
            await ViewInvoice(inv);
    }

    private async Task ViewInvoice(Invoice inv)
    {
        selectedInvoice = await InvoiceService.GetByIdAsync(inv.Id);
        _linkJobSearch = InvoiceLegacyRef.TryReadTrfId(selectedInvoice?.Notes) ?? "";
        _parentInvoiceNumber = "";
        _creditReason = "";
        _creditAmount = null;
        _creditPercent = null;
        _linkCandidates = new();
        _linkSearched = false;
        _payments = selectedInvoice != null
            ? (await InvoiceService.GetPaymentsAsync(selectedInvoice.Id)).ToList()
            : new();
        _paymentAmount = selectedInvoice?.BalanceDue ?? 0;
        _paymentDate = DateTime.UtcNow.Date;
        _paymentReference = "";
        _popFile = null;
        showForm = false;
        showLineForm = false;
        editingLine = null;
    }

    private void CloseInvoiceView()
    {
        selectedInvoice = null;
        showLineForm = false;
        editingLine = null;
    }

    private async Task SearchLinkJobsAsync()
    {
        var term = _linkJobSearch.Trim();
        if (term.Length == 0)
        {
            ToastService.ShowError("Enter a job number or TRFid.");
            return;
        }

        _linkCandidates = (await JobService.GetAllAsync(term, 1, 8)).ToList();
        _linkSearched = true;
    }

    private async Task LinkJobAsync(Job job)
    {
        if (selectedInvoice == null)
            return;

        try
        {
            await InvoiceService.LinkJobAsync(selectedInvoice.Id, job.Id);
            ToastService.ShowSuccess($"Linked {selectedInvoice.InvoiceNumber} to {job.JobNumber}. The job was not closed.");
            await ViewInvoice(selectedInvoice);
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private void ShowAddLineForm()
    {
        if (selectedInvoice == null) return;
        editingLine = new InvoiceLine { InvoiceId = selectedInvoice.Id, Quantity = 1, LineType = "Material" };
        showLineForm = true;
    }

    private void EditLine(InvoiceLine line)
    {
        editingLine = new InvoiceLine
        {
            Id = line.Id,
            InvoiceId = line.InvoiceId,
            Description = line.Description,
            Quantity = line.Quantity,
            Unit = line.Unit,
            LineType = line.LineType,
            UnitPrice = line.UnitPrice
            // LineTotal is computed from Quantity * UnitPrice
        };
        showLineForm = true;
    }

    private async Task SaveLine()
    {
        if (editingLine == null || selectedInvoice == null) return;

        if (editingLine.Id == Guid.Empty)
        {
            await InvoiceService.AddLineAsync(editingLine);
        }
        else
        {
            await InvoiceService.UpdateLineAsync(editingLine);
        }

        showLineForm = false;
        editingLine = null;
        selectedInvoice = await InvoiceService.GetByIdAsync(selectedInvoice.Id);
        await LoadInvoices();
    }

    private void CancelLineForm()
    {
        showLineForm = false;
        editingLine = null;
    }

    private async Task DeleteLine(InvoiceLine line)
    {
        if (!await ConfirmDelete($"Delete line?")) return;
        await InvoiceService.DeleteLineAsync(line.Id);
        selectedInvoice = await InvoiceService.GetByIdAsync(selectedInvoice!.Id);
        await LoadInvoices();
    }

    private async Task DeleteInvoice(Invoice inv)
    {
        if (!await ConfirmDelete($"Delete invoice {inv.InvoiceNumber}?")) return;
        await InvoiceService.DeleteAsync(inv.Id);
        if (selectedInvoice?.Id == inv.Id) selectedInvoice = null;
        ToastService.ShowSuccess("Invoice deleted.");
        await LoadInvoices();
    }

    private async Task ChaseOverdueAsync(Guid invoiceId)
    {
        if (_chasing) return;
        _chasing = true;
        try
        {
            var result = await InvoiceService.ChaseOverdueAsync(invoiceId);
            ToastService.ShowSuccess(result.EmailSent
                ? $"Chased {result.InvoiceNumber} — reminder emailed to {result.CustomerEmail}."
                : $"Chased {result.InvoiceNumber} — recorded (SMTP not configured).");
            await LoadInvoices();
            if (selectedInvoice?.Id == invoiceId)
            {
                selectedInvoice = await InvoiceService.GetByIdAsync(invoiceId);
                if (selectedInvoice != null)
                    _payments = (await InvoiceService.GetPaymentsAsync(invoiceId)).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _chasing = false;
        }
    }

    private async Task UpdateStatus(InvoiceStatus status)
    {
        if (selectedInvoice == null) return;
        await InvoiceService.UpdateStatusAsync(selectedInvoice.Id, status);
        selectedInvoice = await InvoiceService.GetByIdAsync(selectedInvoice.Id);
        ToastService.ShowSuccess($"Status updated to {status}.");
        await LoadInvoices();
    }

    private async Task<bool> ConfirmDelete(string message)
    {
        try { return await JS.InvokeAsync<bool>("confirm", message); }
        catch { return false; }
    }

    private void OnPopSelected(InputFileChangeEventArgs e) => _popFile = e.File;

    private async Task DownloadPopAsync(InvoicePayment payment)
    {
        try
        {
            var pop = await InvoiceService.OpenPaymentPopAsync(payment.Id);
            if (pop == null)
            {
                ToastService.ShowError("POP file not available.");
                return;
            }

            await using var stream = pop.Value.Content;
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("meterpUi.downloadBytes", pop.Value.FileName, base64, pop.Value.ContentType);
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task RecordPaymentAsync()
    {
        if (selectedInvoice == null || _paymentAmount <= 0) return;
        try
        {
            if (_popFile != null)
            {
                await using var stream = _popFile.OpenReadStream(5 * 1024 * 1024);
                await InvoiceService.RecordPaymentWithPopAsync(
                    selectedInvoice.Id,
                    _paymentAmount,
                    _paymentDate.ToUniversalTime(),
                    string.IsNullOrWhiteSpace(_paymentReference) ? null : _paymentReference,
                    _popFile.Name,
                    stream,
                    _popFile.ContentType,
                    CurrentUserService.UserId,
                    null);
            }
            else
            {
                await InvoiceService.RecordPaymentAsync(
                    selectedInvoice.Id,
                    _paymentAmount,
                    _paymentDate.ToUniversalTime(),
                    string.IsNullOrWhiteSpace(_paymentReference) ? null : _paymentReference,
                    CurrentUserService.UserId,
                    null);
            }

            ToastService.ShowSuccess("Payment recorded.");
            await ViewInvoice(selectedInvoice);
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task LinkCreditParentAsync()
    {
        if (selectedInvoice == null) return;
        try
        {
            await InvoiceService.LinkCreditNoteParentAsync(selectedInvoice.Id, _parentInvoiceNumber);
            ToastService.ShowSuccess($"Linked {_parentInvoiceNumber.Trim()}.");
            var refreshed = await InvoiceService.GetByIdAsync(selectedInvoice.Id);
            if (refreshed != null)
                await ViewInvoice(refreshed);
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task CreateCreditNoteAsync()
    {
        if (selectedInvoice == null) return;
        try
        {
            var cn = await InvoiceService.CreateCreditNoteAsync(selectedInvoice.Id, "Credit note via Invoices UI");
            ToastService.ShowSuccess($"Credit note {cn.InvoiceNumber} created.");
            await LoadInvoices();
            await ViewInvoice(cn);
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task CreatePartialCreditNoteAsync()
    {
        if (selectedInvoice == null) return;
        try
        {
            var cn = await InvoiceService.CreatePartialCreditNoteAsync(
                selectedInvoice.Id,
                _creditReason,
                _creditAmount,
                _creditPercent);
            ToastService.ShowSuccess($"Credit note {cn.InvoiceNumber} created for R {cn.Total:N2} incl. VAT.");
            await LoadInvoices();
            await ViewInvoice(cn);
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task IssueCreditNoteAsync()
    {
        if (selectedInvoice == null) return;
        try
        {
            var issued = await InvoiceService.IssueCreditNoteAsync(selectedInvoice.Id);
            ToastService.ShowSuccess($"Credit note {issued.InvoiceNumber} issued. The customer balance now includes this credit.");
            await LoadInvoices();
            var refreshed = await InvoiceService.GetByIdAsync(issued.Id);
            if (refreshed != null)
                await ViewInvoice(refreshed);
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private static string GetDocumentTypeBadge(InvoiceDocumentType type) => type switch
    {
        InvoiceDocumentType.Proforma => "<span class=\"badge bg-info\">Proforma</span>",
        InvoiceDocumentType.Deposit => "<span class=\"badge bg-primary\">Deposit</span>",
        InvoiceDocumentType.Partial => "<span class=\"badge bg-warning text-dark\">Partial</span>",
        InvoiceDocumentType.Final => "<span class=\"badge bg-success\">Final</span>",
        InvoiceDocumentType.CreditNote => "<span class=\"badge bg-danger\">Credit note</span>",
        _ => "<span class=\"badge bg-light text-dark\">Standard</span>"
    };

    private static string GetStatusBadge(InvoiceStatus status)
    {
        return status switch
        {
            InvoiceStatus.Draft => "<span class=\"badge bg-secondary\">Draft</span>",
            InvoiceStatus.Sent => "<span class=\"badge bg-info\">Sent</span>",
            InvoiceStatus.PartiallyPaid => "<span class=\"badge bg-warning text-dark\">Partially Paid</span>",
            InvoiceStatus.Paid => "<span class=\"badge bg-success\">Paid</span>",
            InvoiceStatus.Overdue => "<span class=\"badge bg-danger\">Overdue</span>",
            InvoiceStatus.Cancelled => "<span class=\"badge bg-dark\">Cancelled</span>",
            _ => status.ToString()
        };
    }

    private IEnumerable<string[]> BuildInvoiceExportRows()
    {
        foreach (var inv in invoices)
        {
            yield return new[]
            {
                inv.InvoiceNumber,
                inv.Customer?.Name ?? "",
                inv.Job?.JobNumber ?? (inv.JobId == null ? "Unlinked" : ""),
                inv.InvoiceDate.ToString("yyyy-MM-dd"),
                inv.DueDate.ToString("yyyy-MM-dd"),
                inv.DocumentType.ToString(),
                inv.Status.ToString(),
                TabularExportHelper.FormatDecimal(InvoiceCreditConvention.SignedStoredTotal(inv.DocumentType, inv.Total)),
                TabularExportHelper.FormatDecimal(inv.DocumentType == InvoiceDocumentType.CreditNote
                    ? InvoiceCreditConvention.ArSignedOpenBalance(inv.DocumentType, inv.Status, inv.Total, inv.AmountPaid)
                    : inv.BalanceDue)
            };
        }
    }

    private async Task ExportInvoicesCsvAsync()
    {
        if (!invoices.Any()) return;
        var csv = TabularExportHelper.BuildCsv(
            "InvoiceNumber,Customer,Job,InvoiceDate,DueDate,Type,Status,Total,BalanceDue",
            BuildInvoiceExportRows().Select(r => r.AsEnumerable()));
        await JS.InvokeVoidAsync("meterpUi.downloadText", "invoices.csv", csv, "text/csv;charset=utf-8");
        ToastService.ShowSuccess("Invoices CSV downloaded.");
    }

    private async Task ExportInvoicesExcelAsync()
    {
        if (!invoices.Any()) return;
        var tsv = TabularExportHelper.BuildExcelTsv(
            "InvoiceNumber\tCustomer\tJob\tInvoiceDate\tDueDate\tType\tStatus\tTotal\tBalanceDue",
            BuildInvoiceExportRows().Select(r => r.AsEnumerable()));
        await JS.InvokeVoidAsync("meterpUi.downloadText", "invoices.xls", tsv, "application/vnd.ms-excel");
        ToastService.ShowSuccess("Invoices Excel file downloaded.");
    }

    private async Task ExportInvoicesPdfAsync()
    {
        if (!invoices.Any()) return;
        var pdf = TabularPdfGenerator.Generate(
            "Invoices Export",
            new[] { "Invoice #", "Customer", "Job", "Date", "Due", "Type", "Status", "Total", "Balance" },
            BuildInvoiceExportRows(),
            _branding);
        await JS.InvokeVoidAsync("meterpUi.downloadBytes", "invoices.pdf", Convert.ToBase64String(pdf), "application/pdf");
        ToastService.ShowSuccess("Invoices PDF downloaded.");
    }
}
