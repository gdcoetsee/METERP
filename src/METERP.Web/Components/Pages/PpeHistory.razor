@page "/ppe-history"
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Common
@using METERP.Domain
@attribute [Authorize(Policy = "Inventory.View")]
@rendermode InteractiveServer
@inject IPpeIssueService PpeIssueService
@inject IEmployeeService EmployeeService
@inject IInventoryService InventoryService
@inject IJobService JobService
@inject ICurrentUserService CurrentUser
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>PPE Register</PageTitle>

<PageHeader Title="PPE register" Subtitle="Issue PPE stock to an employee. Job is optional site context only." TestId="ppe-page-header">
    <Actions>
        @if (CanIssue)
        {
            <button type="button" class="btn btn-primary" data-testid="ppe-issue-btn" @onclick="OpenIssueModal">Issue PPE</button>
        }
        <ExportToolbar ShowPdf="false" ShowExcel="false" TestId="ppe-history-export" OnExportCsv="ExportCsvAsync" />
    </Actions>
</PageHeader>

<div class="mb-3" style="max-width: 360px;" data-testid="ppe-filter">
    <label class="form-label small text-muted">Filter by employee</label>
    <select class="form-select" @bind="_filterEmployeeId" @bind:after="ReloadAsync" data-testid="ppe-filter-employee">
        <option value="@Guid.Empty">All employees</option>
        @foreach (var e in _employees)
        {
            <option value="@e.Id">@e.EmployeeNumber — @e.FirstName @e.LastName</option>
        }
    </select>
</div>

@if (_loading)
{
    <ListSkeleton Rows="5" TestId="ppe-history-skeleton" />
}
else if (_issues.Count == 0)
{
    <EmptyState Title="No PPE issues recorded"
                Description="Issue PPE stock to employees from this register, or via PPE-flagged requisitions."
                Icon="🦺"
                TestId="ppe-history-empty" />
}
else
{
    <div class="table-responsive" data-testid="ppe-history-table">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Issued</th>
                    <th>Employee</th>
                    <th>Item</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Out</th>
                    <th>Job (optional)</th>
                    <th>Requisition</th>
                    <th>Notes</th>
                    @if (CanIssue)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var issue in _issues)
                {
                    <tr data-testid="ppe-history-row" class="@(issue.IsFullyReturned ? "text-muted" : null)">
                        <td>@issue.IssuedAt.ToString("yyyy-MM-dd")</td>
                        <td>@(issue.Employee != null ? $"{issue.Employee.FirstName} {issue.Employee.LastName}" : "—")</td>
                        <td>@(issue.InventoryItem != null ? $"{issue.InventoryItem.Sku} — {issue.InventoryItem.Name}" : "—")</td>
                        <td class="text-end">@issue.Quantity.ToString("N2")</td>
                        <td class="text-end">
                            @if (issue.IsFullyReturned)
                            {
                                <span class="badge bg-success">Returned</span>
                            }
                            else
                            {
                                @issue.QuantityOutstanding.ToString("N2")
                            }
                        </td>
                        <td>@(issue.Job?.JobNumber ?? "—")</td>
                        <td>@(issue.StockRequisition?.RequisitionNumber ?? "—")</td>
                        <td class="small text-muted">@(issue.Notes ?? "—")</td>
                        @if (CanIssue)
                        {
                            <td class="text-end">
                                @if (!issue.IsFullyReturned)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-testid="ppe-return-btn"
                                            @onclick="() => OpenReturnModal(issue)">Return</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showIssueModal)
{
    <FormModal IsOpen="true" Title="Issue PPE to employee" TestId="ppe-issue-modal" OnClose="CloseIssueModal">
        <div class="mb-3">
            <label class="form-label meterp-required">Employee</label>
            <EntityPicker TestId="ppe-issue-employee"
                          Value="_issueEmployeeId"
                          ValueChanged="OnIssueEmployeePicked"
                          Options="PpeEmployeeOptions"
                          SelectedLabel="@IssueEmployeeName"
                          Placeholder="Type an employee name"
                          Required="true"
                          OnSearch="SearchPpeEmployeesAsync" />
        </div>
        <div class="mb-3">
            <label class="form-label meterp-required">Stock item</label>
            <EntityPicker TestId="ppe-issue-item"
                          Value="_issueItemId"
                          ValueChanged="OnIssueItemPicked"
                          Options="PpeItemOptions"
                          SelectedLabel="@IssueItemName"
                          Placeholder="Type SKU or name"
                          Required="true"
                          OnSearch="SearchPpeItemsAsync" />
        </div>
        <div class="mb-3">
            <label class="form-label">Quantity *</label>
            <input type="number" min="0.01" step="0.01" class="form-control" @bind="_issueQty" data-testid="ppe-issue-qty" />
        </div>
        <div class="mb-3">
            <label class="form-label">Job <span class="text-muted fw-normal">(optional)</span></label>
            <EntityPicker TestId="ppe-issue-job"
                          Value="_issueJobId"
                          ValueChanged="OnIssueJobPicked"
                          Options="PpeJobOptions"
                          SelectedLabel="@IssueJobName"
                          Placeholder="Type a job number, or leave blank"
                          OnSearch="SearchPpeJobsAsync" />
        </div>
        <div class="mb-3">
            <label class="form-label">Notes</label>
            <input class="form-control" @bind="_issueNotes" data-testid="ppe-issue-notes" />
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" @onclick="CloseIssueModal">Cancel</button>
            <button type="button" class="btn btn-primary" data-testid="ppe-issue-confirm" @onclick="IssueAsync">Issue to register</button>
        </div>
    </FormModal>
}

@if (_showReturnModal && _returnIssue != null)
{
    <FormModal IsOpen="true" Title="Return PPE to stock" TestId="ppe-return-modal" OnClose="CloseReturnModal">
        <p class="small text-muted">
            @( _returnIssue.InventoryItem?.Name ?? "Item" ) issued to
            @( _returnIssue.Employee != null ? $"{_returnIssue.Employee.FirstName} {_returnIssue.Employee.LastName}" : "employee" ).
            Outstanding: <strong>@_returnIssue.QuantityOutstanding.ToString("N2")</strong>
        </p>
        <div class="mb-3">
            <label class="form-label">Quantity to return *</label>
            <input type="number" min="0.01" step="0.01" class="form-control"
                   @bind="_returnQty" data-testid="ppe-return-qty" />
        </div>
        <div class="mb-3">
            <label class="form-label">Notes</label>
            <input class="form-control" @bind="_returnNotes" data-testid="ppe-return-notes" />
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" @onclick="CloseReturnModal">Cancel</button>
            <button type="button" class="btn btn-primary" data-testid="ppe-return-confirm" @onclick="ReturnAsync">Return to stock</button>
        </div>
    </FormModal>
}

@code {
    private List<EmployeePpeIssue> _issues = new();
    private List<Employee> _employees = new();
    private List<InventoryItem> _items = new();
    private List<Job> _jobs = new();
    private bool _loading = true;

    private Guid _filterEmployeeId = Guid.Empty;

    private bool _showIssueModal;
    private Guid _issueEmployeeId;
    private Guid _issueItemId;
    private Guid _issueJobId;
    private decimal _issueQty = 1;
    private string _issueNotes = "";
    private string _itemSearch = "";

    private bool _showReturnModal;
    private EmployeePpeIssue? _returnIssue;
    private decimal _returnQty = 1;
    private string _returnNotes = "";

    private bool CanIssue =>
        CurrentUser.Permissions.Contains(Permissions.InventoryManage)
        || CurrentUser.Permissions.Contains(Permissions.RequisitionsManage);

    private IReadOnlyList<EntityPickerOption> PpeItemOptions =>
        _items.Select(i => new EntityPickerOption
        {
            Id = i.Id,
            Label = $"{i.Sku} — {i.Name}",
            SubLabel = $"On hand {i.QuantityOnHand:N0}"
        }).ToList();
    private string? IssueItemName
    {
        get
        {
            var i = _items.FirstOrDefault(x => x.Id == _issueItemId);
            return i == null ? null : $"{i.Sku} — {i.Name}";
        }
    }

    private Task OnIssueItemPicked(Guid id)
    {
        _issueItemId = id;
        return Task.CompletedTask;
    }

    private async Task SearchPpeItemsAsync(string term)
    {
        _itemSearch = term ?? "";
        await LoadItemsAsync();
    }

    private IReadOnlyList<EntityPickerOption> PpeEmployeeOptions =>
        _employees.Select(e => new EntityPickerOption { Id = e.Id, Label = $"{e.EmployeeNumber} — {e.FirstName} {e.LastName}" }).ToList();
    private string? IssueEmployeeName
    {
        get
        {
            var e = _employees.FirstOrDefault(x => x.Id == _issueEmployeeId);
            return e == null ? null : $"{e.EmployeeNumber} — {e.FirstName} {e.LastName}";
        }
    }
    private IReadOnlyList<EntityPickerOption> PpeJobOptions =>
        _jobs.Select(j => new EntityPickerOption { Id = j.Id, Label = $"{j.JobNumber} — {j.Title}" }).ToList();
    private string? IssueJobName
    {
        get
        {
            var j = _jobs.FirstOrDefault(x => x.Id == _issueJobId);
            return j == null ? null : $"{j.JobNumber} — {j.Title}";
        }
    }

    private Task OnIssueEmployeePicked(Guid id)
    {
        _issueEmployeeId = id;
        return Task.CompletedTask;
    }

    private Task OnIssueJobPicked(Guid id)
    {
        _issueJobId = id;
        return Task.CompletedTask;
    }

    private async Task SearchPpeEmployeesAsync(string term)
    {
        _employees = (await EmployeeService.GetAllAsync(
                string.IsNullOrWhiteSpace(term) ? null : term.Trim(), 1, 50)).ToList();
    }

    private async Task SearchPpeJobsAsync(string term)
    {
        _jobs = (await JobService.GetAllAsync(
                string.IsNullOrWhiteSpace(term) ? null : term.Trim(), 1, 50))
            .Where(j => j.IsOpenForOperations()).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _employees = (await EmployeeService.GetAllAsync(pageSize: 200)).ToList();
        _jobs = (await JobService.GetAllAsync(pageSize: 100)).Where(j => j.IsOpenForOperations()).ToList();
        await LoadItemsAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            Guid? filter = _filterEmployeeId == Guid.Empty ? null : _filterEmployeeId;
            _issues = (await PpeIssueService.GetHistoryAsync(filter, pageSize: 100)).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadItemsAsync()
    {
        _items = (await InventoryService.GetAllItemsAsync(
            string.IsNullOrWhiteSpace(_itemSearch) ? null : _itemSearch,
            pageSize: 40)).ToList();
        if (_items.Count > 0 && !_items.Any(i => i.Id == _issueItemId))
            _issueItemId = _items[0].Id;
    }

    private async Task OnItemSearch(ChangeEventArgs e)
    {
        _itemSearch = e.Value?.ToString() ?? "";
        await LoadItemsAsync();
    }

    private async Task ExportCsvAsync()
    {
        if (_issues.Count == 0)
        {
            Toast.ShowInfo("No PPE issues to export.");
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("IssuedAt,Employee,Sku,Item,Quantity,Job,Requisition,Notes");
        foreach (var i in _issues)
        {
            var emp = i.Employee != null ? $"{i.Employee.FirstName} {i.Employee.LastName}" : "";
            var sku = i.InventoryItem?.Sku ?? "";
            var name = i.InventoryItem?.Name ?? "";
            sb.AppendLine($"{i.IssuedAt:yyyy-MM-dd},{emp},{sku},{name},{i.Quantity},{i.Job?.JobNumber},{i.StockRequisition?.RequisitionNumber},{i.Notes}");
        }

        await JS.InvokeVoidAsync("meterpUi.downloadText", "ppe-register.csv", sb.ToString(), "text/csv;charset=utf-8");
        Toast.ShowSuccess("PPE register CSV downloaded.");
    }

    private void OpenIssueModal()
    {
        _issueEmployeeId = _employees.FirstOrDefault()?.Id ?? Guid.Empty;
        _issueQty = 1;
        _issueJobId = Guid.Empty;
        _issueNotes = "";
        _showIssueModal = true;
    }

    private void CloseIssueModal() => _showIssueModal = false;

    private void OpenReturnModal(EmployeePpeIssue issue)
    {
        _returnIssue = issue;
        _returnQty = issue.QuantityOutstanding;
        _returnNotes = "";
        _showReturnModal = true;
    }

    private void CloseReturnModal()
    {
        _showReturnModal = false;
        _returnIssue = null;
    }

    private async Task ReturnAsync()
    {
        if (_returnIssue == null || CurrentUser.UserId is not { } userId)
        {
            Toast.ShowError("Not signed in.");
            return;
        }

        try
        {
            await PpeIssueService.ReturnFromEmployeeAsync(
                _returnIssue.Id,
                _returnQty,
                userId,
                string.IsNullOrWhiteSpace(_returnNotes) ? null : _returnNotes);
            Toast.ShowSuccess("PPE returned to stock.");
            CloseReturnModal();
            await ReloadAsync();
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task IssueAsync()
    {
        if (CurrentUser.UserId is not { } userId)
        {
            Toast.ShowError("Not signed in.");
            return;
        }

        if (_issueEmployeeId == Guid.Empty || _issueItemId == Guid.Empty || _issueQty <= 0)
        {
            Toast.ShowError("Select employee, item, and quantity.");
            return;
        }

        try
        {
            Guid? jobId = _issueJobId == Guid.Empty ? null : _issueJobId;
            await PpeIssueService.IssueToEmployeeAsync(
                _issueEmployeeId,
                _issueItemId,
                _issueQty,
                userId,
                jobId,
                _issueNotes);

            Toast.ShowSuccess("PPE issued to employee register.");
            CloseIssueModal();
            await ReloadAsync();
            await LoadItemsAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }
}
