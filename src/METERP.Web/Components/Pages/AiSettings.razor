@page "/settings/ai"
@using METERP.Application.Interfaces
@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Common
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Tenants.Manage")]
@inject ITenantAiSettingsService AiSettingsService
@inject IAiConfigurationResolver ConfigResolver
@inject ITenantProvider TenantProvider
@inject ITenantService TenantService
@inject ToastService ToastService

<PageTitle>AI Settings</PageTitle>

@if (!_loading)
{
    <span data-testid="ai-settings-ready" class="visually-hidden">ready</span>
}

<PageHeader Title="AI settings" Subtitle="@($"{_officeName} · paste a provider key, test it, then use Copilot.")" TestId="ai-settings-page-header">
    <Actions>
        <span class="badge @StatusBadgeClass" data-testid="ai-status-badge">@StatusLabel</span>
    </Actions>
</PageHeader>

@if (_loading)
{
    <ListSkeleton Rows="4" TestId="ai-settings-loading" AriaLabel="Loading AI settings" />
}
else
{
    @if (!effectiveConfigured)
    {
        <div class="ai-needs-key mb-3" data-testid="ai-needs-key">
            <div>
                <strong>No API key is active.</strong>
                <span>User-secrets <code>Ai:ApiKey</code> is empty. Paste a key from <a href="https://console.x.ai" target="_blank" rel="noopener">console.x.ai</a> below and Save. Environment <code>Ai__ApiKey</code> or <code>XAI_API_KEY</code> also works. Never commit the key.</span>
            </div>
            <a class="btn btn-sm btn-outline-primary" href="/help#ai">Where to put the key</a>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card ai-settings-card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                        <div>
                            <h2 class="h5 mb-1">Connection</h2>
                            <p class="text-muted mb-0">Effective source: <strong>@effectiveSource</strong>@if (!string.IsNullOrWhiteSpace(effectiveMasked)) { <span> · key @effectiveMasked</span> }</p>
                            @if (effectiveConfigured && testMessage is null)
                            {
                                <p class="small text-muted mb-0 mt-1" data-testid="ai-configured-note">Configured means a key is on file. It does not mean Test connection has passed. A failed test leaves the key in place.</p>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-2" data-testid="ai-connect-buttons">
                            <a class="btn btn-dark btn-sm" href="https://console.x.ai" target="_blank" rel="noopener" @onclick="ConnectGrok" @onclick:preventDefault="false" data-testid="ai-connect-grok">Grok</a>
                            <a class="btn btn-outline-primary btn-sm" href="https://aistudio.google.com/apikey" target="_blank" rel="noopener" @onclick="ConnectGemini" @onclick:preventDefault="false">Google</a>
                            <a class="btn btn-outline-secondary btn-sm" href="https://platform.openai.com/api-keys" target="_blank" rel="noopener" @onclick="ConnectOpenAi" @onclick:preventDefault="false">OpenAI</a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="useTenantKey" @bind="useTenantKey" data-testid="ai-use-tenant-key" />
                            <label class="form-check-label" for="useTenantKey">Use tenant API key</label>
                        </div>
                        <small class="text-muted">On, with a saved key, this tenant overrides deployment settings. Off, or with no saved key, METERP uses <code>Ai:ApiKey</code> / <code>Ai__ApiKey</code> / <code>XAI_API_KEY</code>.</small>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="ai-provider-select">Provider</label>
                            <select id="ai-provider-select" class="form-select" @bind="provider" @bind:after="OnProviderChanged" data-testid="ai-provider-select">
                                @foreach (var p in AiProviderProfiles.All)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                            <small class="text-muted">@providerHint</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="ai-base-url">Base URL</label>
                            <input id="ai-base-url" class="form-control" @bind="baseUrl" placeholder="https://api.x.ai/v1" data-testid="ai-base-url" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="ai-model">Model</label>
                            <input id="ai-model" class="form-control" list="ai-model-options" @bind="model" placeholder="grok-4.6" data-testid="ai-model" />
                            <datalist id="ai-model-options">
                                @foreach (var suggested in AiProviderProfiles.SuggestedModels(provider))
                                {
                                    <option value="@suggested"></option>
                                }
                            </datalist>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label" for="ai-api-key">API key</label>
                        <input id="ai-api-key" type="password" class="form-control" @bind="apiKeyInput" placeholder="Paste a new key — it stays masked" autocomplete="off" data-testid="ai-api-key" />
                        @if (hasStoredKey)
                        {
                            <small class="text-muted">Stored tenant key: @maskedKey. Leave the box blank to keep it.</small>
                        }
                        else
                        {
                            <small class="text-muted">Nothing saved for this tenant yet. Saving a key turns on the tenant override and encrypts it.</small>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button class="btn btn-primary" @onclick="SaveSettings" disabled="@_saving" data-testid="ai-settings-save">@(_saving ? "Saving…" : "Save")</button>
                        <button class="btn btn-outline-secondary" @onclick="TestConnection" disabled="@_testing" data-testid="ai-test-connection">@(_testing ? "Testing…" : "Test connection")</button>
                        <a class="btn btn-outline-primary" href="/ai-copilot">Open copilot</a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(testMessage))
                    {
                        <div class="alert @(testSuccess ? "alert-success" : "alert-danger") mt-3 mb-0" role="alert" data-testid="ai-test-result">@testMessage</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card ai-settings-card mb-3">
                <div class="card-body">
                    <h2 class="h6">Where the key can live</h2>
                    <ol class="small mb-0 ps-3">
                        <li class="mb-2"><strong>This page</strong> — paste, Save, Test connection. Encrypted on the tenant.</li>
                        <li class="mb-2"><strong>User-secrets</strong> (Development): <code>dotnet user-secrets set "Ai:ApiKey" "…"</code> in <code>METERP.Web</code>. Also <code>Ai:BaseUrl</code>, <code>Ai:Model</code>, <code>Ai:Provider</code>, <code>Ai:Enabled</code>.</li>
                        <li><strong>Environment</strong>: <code>Ai__ApiKey</code> or <code>XAI_API_KEY</code>. A blank user-secrets value does not count as a key.</li>
                    </ol>
                </div>
            </div>
            <div class="card ai-settings-card">
                <div class="card-body small">
                    <h2 class="h6">OpenAI-compatible endpoint</h2>
                    <p class="mb-2">METERP calls <code>/chat/completions</code>. Grok default is <code>https://api.x.ai/v1</code> and <code>grok-4.6</code>. An X Premium login is not an API key.</p>
                    <p class="mb-0 text-muted">@deploymentNote</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _testing;
    private bool effectiveConfigured;
    private string effectiveSource = "Not configured";
    private string effectiveMasked = "";
    private string deploymentNote = "";
    private string _officeName = "MET Electrical";

    private string provider = AiProviderProfiles.Grok;
    private string baseUrl = "";
    private string model = "";
    private bool useTenantKey;
    private string apiKeyInput = "";
    private string maskedKey = "";
    private bool hasStoredKey;
    private string providerHint = "";
    private string? testMessage;
    private bool testSuccess;

    private string StatusLabel =>
        testMessage != null && !testSuccess ? "Error"
        : effectiveConfigured ? "Configured"
        : "Not configured";

    private string StatusBadgeClass =>
        testMessage != null && !testSuccess ? "bg-danger"
        : effectiveConfigured ? "bg-success"
        : "bg-warning text-dark";

    protected override async Task OnInitializedAsync()
    {
        var settings = await AiSettingsService.GetCurrentTenantSettingsAsync();
        provider = settings.Provider;
        baseUrl = settings.BaseUrl;
        model = settings.Model;
        useTenantKey = settings.UseTenantKey;
        maskedKey = settings.MaskedApiKey ?? "(not set)";
        hasStoredKey = settings.HasStoredKey;
        providerHint = AiProviderProfiles.GetPreset(provider).Hint;

        try
        {
            var tenantId = TenantProvider.GetCurrentTenantId();
            if (tenantId != Guid.Empty)
            {
                var tenant = await TenantService.GetByIdAsync(tenantId);
                var brand = TenantBranding.From(tenant).DisplayName;
                if (!string.IsNullOrWhiteSpace(brand) && brand != "METERP")
                    _officeName = brand;
            }
        }
        catch { /* branding is cosmetic */ }

        await RefreshEffectiveAsync();
        _loading = false;
    }

    private async Task RefreshEffectiveAsync()
    {
        var effective = await ConfigResolver.GetEffectiveAsync();
        effectiveConfigured = effective.IsConfigured;
        effectiveMasked = effective.IsConfigured ? effective.MaskedApiKey : "";
        effectiveSource = !effective.IsConfigured
            ? "Not configured"
            : effective.FromTenantOverride
                ? "Tenant key"
                : "Deployment (user-secrets or environment)";
        deploymentNote = ConfigResolver.IsDeploymentConfigured
            ? "A deployment key is present. Its value is not shown."
            : "No deployment key. Ai:ApiKey in user-secrets is empty or whitespace.";
    }

    private void OnProviderChanged()
    {
        var preset = AiProviderProfiles.GetPreset(provider);
        providerHint = preset.Hint;
        if (_loading || provider == AiProviderProfiles.Custom)
            return;

        baseUrl = preset.BaseUrl;
        model = preset.Model;
    }

    private void ConnectGrok() => ApplyProvider(AiProviderProfiles.Grok);
    private void ConnectGemini() => ApplyProvider(AiProviderProfiles.GoogleGemini);
    private void ConnectOpenAi() => ApplyProvider(AiProviderProfiles.OpenAi);

    private void ApplyProvider(string name)
    {
        provider = name;
        useTenantKey = true;
        OnProviderChanged();
    }

    private async Task SaveSettings()
    {
        _saving = true;
        try
        {
            await AiSettingsService.SaveCurrentTenantSettingsAsync(
                provider, baseUrl, model, useTenantKey,
                string.IsNullOrWhiteSpace(apiKeyInput) ? null : apiKeyInput);
            apiKeyInput = "";
            var settings = await AiSettingsService.GetCurrentTenantSettingsAsync();
            provider = settings.Provider;
            baseUrl = settings.BaseUrl;
            model = settings.Model;
            useTenantKey = settings.UseTenantKey;
            maskedKey = settings.MaskedApiKey ?? "(not set)";
            hasStoredKey = settings.HasStoredKey;
            testMessage = null;
            await RefreshEffectiveAsync();
            ToastService.ShowSuccess(effectiveConfigured
                ? "AI settings saved. Copilot can call the provider."
                : "AI settings saved. Paste a key and test the connection to go live.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Save failed: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestConnection()
    {
        _testing = true;
        testMessage = null;
        try
        {
            var result = await AiSettingsService.TestConnectionAsync(
                provider, baseUrl, model,
                string.IsNullOrWhiteSpace(apiKeyInput) ? null : apiKeyInput);
            testSuccess = result.Success;
            testMessage = result.Message;
            await RefreshEffectiveAsync();
        }
        catch (Exception ex)
        {
            testSuccess = false;
            testMessage = $"Connection failed: {ex.Message}";
        }
        finally
        {
            _testing = false;
        }
    }
}
