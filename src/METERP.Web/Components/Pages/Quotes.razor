@page "/quotes"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Domain
@using METERP.Web.Reports
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "Quotes.View")]
@inject IQuoteService QuoteService
@inject ICustomerService CustomerService
@inject ITenantService TenantService
@inject ITenantProvider TenantProvider
@inject ICurrentUserService CurrentUserService
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using METERP.Common
@using System.Globalization

<PageTitle>Quotes</PageTitle>

@if (!_loading)
{
    <span data-testid="quotes-ready" class="visually-hidden">ready</span>
}

<PageHeader Title="Quotes" Subtitle="Estimates with labour, materials, and explicit travel. VAT 15%." TestId="quotes-page-header">
    <Actions>
        <ExportToolbar TestId="quotes-export" OnExportCsv="ExportQuotesCsv" OnExportExcel="ExportQuotesExcelAsync" OnExportPdf="ExportQuotesPdfAsync" Disabled="@_pageBusy" />
        @if (UserCanManage)
        {
            <button type="button" class="btn btn-primary" @onclick="ShowCreateEditor"
                    disabled="@(_pageBusy || QuoteQuotaBlocked)"
                    title="@(QuoteQuotaBlocked ? TenantQuotaDefaults.GetQuotaTooltip(_tenant!, QuotaType.Quote, "Quotes") : null)"
                    data-testid="new-quote-button">New quote</button>
        }
        <a href="/ai-copilot" class="btn btn-outline-success" data-testid="create-with-ai-copilot">Create with AI</a>
    </Actions>
</PageHeader>

@if (QuoteQuotaBlocked)
{
    <div class="alert alert-warning" data-testid="quotes-quota-exceeded-banner" role="alert">
        <strong>Quote quota reached.</strong>
        @TenantQuotaDefaults.GetQuotaTooltip(_tenant!, QuotaType.Quote, "Quotes")
        <a href="/account" class="alert-link ms-1">View plan &amp; usage</a>
    </div>
}

<div class="meterp-filter-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control" data-testid="quotes-search" placeholder="Search quote #, customer or notes..."
               value="@searchTerm" @oninput="OnSearchInput" disabled="@_pageBusy" />
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearch" disabled="@_pageBusy">Clear</button>
        }
    </div>
</div>

@if (_loading)
{
    <ListSkeleton Rows="6" TestId="quotes-loading" AriaLabel="Loading quotes" />
}
else
{
    <QuoteList
        Quotes="quotes"
        CanManage="UserCanManage"
        CurrentPage="currentPage"
        DisablePrevious="@(currentPage <= 1 || _pageBusy)"
        DisableNext="@(quotes != null && quotes.Count < PageSize || _pageBusy)"
        OnView="ViewQuote"
        OnEdit="EditQuote"
        OnDelete="DeleteQuote"
        OnPrevious="PreviousPage"
        OnNext="NextPage"
        OnCreate="ShowCreateEditor" />
}

@if (editorQuote != null)
{
<FormModal IsOpen="true"
           Title="@QuoteEditorTitle"
           Size="full"
           TestId="quote-editor"
           BackdropTestId="quote-editor-backdrop"
           CloseOnBackdrop="false"
           CloseDisabled="@_pageBusy"
           OnClose="CloseEditor">
    <HeaderActions>
        @if (editorReadOnly)
        {
            <span class="badge bg-secondary">View</span>
        }
        @if (_pageBusy || _lineSaving)
        {
            <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
        }
        @if (CanConvertToJob)
        {
            <button type="button" class="btn btn-sm btn-success" @onclick="ConvertToJob" disabled="@_pageBusy" data-testid="convert-to-job">Convert to job</button>
        }
    </HeaderActions>
    <ChildContent>
            <div class="row g-4">
                <div class="col-lg-8">
                    @if (!string.IsNullOrWhiteSpace(editorQuote.ExecutiveDecisionNote) || !string.IsNullOrWhiteSpace(editorQuote.ExecutiveRejectionReason))
                    {
                        <div class="alert @(editorQuote.ApprovalStatus == QuoteApprovalStatus.Rejected ? "alert-warning" : "alert-success") small" data-testid="quote-executive-note">
                            <strong>@(editorQuote.ApprovalStatus == QuoteApprovalStatus.Rejected ? "Executive rejected" : "Executive note")</strong>
                            <div>@(editorQuote.ExecutiveDecisionNote ?? editorQuote.ExecutiveRejectionReason)</div>
                        </div>
                    }
                    @if (!editorReadOnly)
                    {
                        <EditForm Model="editorQuote" FormName="QuoteEditorForm">
                            <div class="meterp-section">
                                <div class="meterp-section-title">Who is this for</div>
                                <label class="form-label meterp-required" for="quote-customer">Customer</label>
                                <EntityPicker TestId="quote-customer-select"
                                              Value="editorQuote.CustomerId"
                                              ValueChanged="OnCustomerPickedAsync"
                                              Options="CustomerPickerOptions"
                                              SelectedLabel="@SelectedCustomerName"
                                              Placeholder="Type a company name to find them"
                                              Required="true"
                                              ShowRequiredError="_customerError"
                                              RequiredMessage="Select a customer, or create one if they are new."
                                              AllowCreate="true"
                                              CreateLabel="+ Create new customer"
                                              CreateTestId="quote-new-customer-toggle"
                                              OnCreate="ToggleNewCustomer"
                                              OnSearch="SearchCustomersAsync" />
                                <span class="meterp-field-hint">Required. Type to search the full customer list — it is not limited to the first few names.</span>
                            </div>

                            <div class="meterp-section">
                                <div class="meterp-section-title">Quote details</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label meterp-required">Quote date</label>
                                        <InputDate class="form-control" @bind-Value="editorQuote.QuoteDate" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label meterp-required">Valid until</label>
                                        <InputDate class="form-control" @bind-Value="editorQuote.ValidUntil" />
                                        <span class="meterp-field-hint">Defaults to 30 days.</span>
                                    </div>
                                    @if (!editorIsNew)
                                    {
                                        <div class="col-md-4">
                                            <label class="form-label">Status</label>
                                            <select class="form-select" @bind="editorQuote.Status">
                                                @foreach (QuoteStatus s in Enum.GetValues<QuoteStatus>())
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            </select>
                                            @if (editorQuote.ApprovalStatus != QuoteApprovalStatus.ExecutiveApproved)
                                            {
                                                <span class="meterp-field-hint">Sent requires executive approval first.</span>
                                            }
                                        </div>
                                    }
                                    <div class="col-md-4">
                                        <label class="form-label">VAT rate</label>
                                        <InputNumber class="form-control" @bind-Value="editorQuote.TaxRate" step="0.01" />
                                        <span class="meterp-field-hint">South Africa standard is 0.15 (15%).</span>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Notes <span class="text-muted fw-normal">(optional)</span></label>
                                        <InputTextArea class="form-control" @bind-Value="editorQuote.Notes" rows="2" placeholder="Scope, site, or terms the customer should see" />
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="meterp-section">
                            <div class="meterp-section-title">Customer</div>
                            <p class="mb-1"><strong>@(editorQuote.Customer?.Name ?? SelectedCustomerName ?? "—")</strong></p>
                            <p class="mb-0 text-muted small">
                                @((MarkupString)GetStatusBadge(editorQuote.Status))
                                <span class="ms-2">@editorQuote.QuoteDate.ToString("yyyy-MM-dd")</span>
                            </p>
                        </div>
                    }

                    <div class="meterp-section">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="meterp-section-title mb-0 border-0 pb-0">Line items (@LineCount)</div>
                            @if (CanEditLines && !showLineForm)
                            {
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowAddLineForm" data-testid="quote-add-line-button">Add line</button>
                            }
                        </div>
                        <p class="meterp-field-hint mb-2">Add labour, materials, and travel as separate lines. Description and sell price are required for each line.</p>

                        @if (LineCount > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm" data-testid="quote-lines-table">
                                    <thead>
                                        <tr>
                                            <th>Description</th>
                                            <th>Type</th>
                                            <th class="text-end">Qty</th>
                                            <th class="text-end">Unit cost</th>
                                            <th class="text-end">GP %</th>
                                            <th class="text-end">Unit price</th>
                                            <th class="text-end">Line total</th>
                                            @if (CanEditLines) { <th></th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (editorIsNew)
                                        {
                                            @foreach (var line in draftLines)
                                            {
                                                <tr data-testid="quote-line-row">
                                                    <td>@line.Description</td>
                                                    <td><span class="badge bg-light text-dark">@line.LineType</span></td>
                                                    <td class="text-end">@line.Quantity</td>
                                                    <td class="text-end">@(line.UnitCost > 0 ? $"R {line.UnitCost:N2}" : "—")</td>
                                                    <td class="text-end">@((line.GrossProfitPercent * 100).ToString("0"))%</td>
                                                    <td class="text-end">R @line.UnitPrice.ToString("N2")</td>
                                                    <td class="text-end"><strong>R @line.LineTotal.ToString("N2")</strong></td>
                                                    @if (CanEditLines)
                                                    {
                                                        <td>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => EditDraftLine(line)" disabled="@_lineSaving" data-testid="quote-line-edit-button">Edit</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" @onclick="() => DeleteDraftLine(line)" disabled="@_lineSaving">Del</button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var line in editorQuote.Lines.Where(l => !l.IsDeleted))
                                            {
                                                <tr data-testid="quote-line-row">
                                                    <td>@line.Description</td>
                                                    <td><span class="badge bg-light text-dark">@line.LineType</span></td>
                                                    <td class="text-end">@line.Quantity</td>
                                                    <td class="text-end">@(line.UnitCost > 0 ? $"R {line.UnitCost:N2}" : "—")</td>
                                                    <td class="text-end">@((line.GrossProfitPercent * 100).ToString("0"))%</td>
                                                    <td class="text-end">R @line.UnitPrice.ToString("N2")</td>
                                                    <td class="text-end"><strong>R @line.LineTotal.ToString("N2")</strong></td>
                                                    @if (CanEditLines)
                                                    {
                                                        <td>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => EditSavedLine(line)" disabled="@_lineSaving" data-testid="quote-line-edit-button">Edit</button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" @onclick="() => DeleteSavedLine(line)" disabled="@_lineSaving">Del</button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-2">No lines yet. Add labour, materials, or travel.</p>
                        }

                        @if (showLineForm)
                        {
                            <div class="mt-2 p-3 border rounded bg-light" @key="lineFormKey" data-testid="quote-line-form">
                                <h6>@(editingLineIsNew ? "Add line" : "Edit line")</h6>
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label small mb-0 meterp-required">Description</label>
                                        <input class="form-control form-control-sm"
                                               value="@lineDescription"
                                               @oninput="OnLineDescriptionChanged"
                                               data-testid="quote-line-description" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small mb-0">Type</label>
                                        <select class="form-select form-select-sm" @bind="lineType">
                                            <option value="Material">Material</option>
                                            <option value="Labour">Labour</option>
                                            <option value="Travel">Travel</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small mb-0">Qty</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                               value="@lineQuantityText" @oninput="OnLineQuantityChanged" />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small mb-0">Unit</label>
                                        <input class="form-control form-control-sm" value="@lineUnit" @oninput="OnLineUnitChanged" placeholder="ea" />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small mb-0">Unit cost</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                               value="@lineUnitCostText" @oninput="OnLineUnitCostChanged" data-testid="quote-line-unit-cost" />
                                    </div>
                                    <div class="col-md-1">
                                        <label class="form-label small mb-0">GP %</label>
                                        <input type="number" class="form-control form-control-sm" step="1" min="0" max="99"
                                               value="@LineGrossProfitPercentDisplay" @oninput="OnLineGrossProfitChanged" data-testid="quote-line-gross-profit-percent" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small mb-0 meterp-required">Unit price (sell)</label>
                                        <input type="text" inputmode="decimal" class="form-control form-control-sm"
                                               value="@lineUnitPriceText" @oninput="OnLineUnitPriceChanged" data-testid="quote-line-unit-price" />
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-success" @onclick="() => SaveLine(false)" disabled="@_lineSaving" data-testid="quote-line-save-button">Save line</button>
                                    <button type="button" class="btn btn-sm btn-outline-success ms-1" @onclick="() => SaveLine(true)" disabled="@_lineSaving" data-testid="quote-line-save-add-another-button">Save &amp; add another</button>
                                    <button type="button" class="btn btn-sm btn-secondary ms-1" @onclick="CancelLineForm" disabled="@_lineSaving">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="meterp-totals">
                        <div class="meterp-section-title">Totals</div>
                        <div class="meterp-totals-row"><span>Subtotal</span><strong>R @DisplaySubtotal.ToString("N2")</strong></div>
                        @if (ShowGpSummary)
                        {
                            <div class="meterp-totals-row text-success"><span>Est. gross profit</span><span>R @DisplayGrossProfit.ToString("N2")</span></div>
                            <div class="meterp-totals-row text-success"><span>Blended GP</span><span>@DisplayBlendedGp.ToString("0.0")%</span></div>
                        }
                        <div class="meterp-totals-row"><span>VAT (@((editorQuote.TaxRate * 100).ToString("0"))%)</span><span>R @DisplayTax.ToString("N2")</span></div>
                        <div class="meterp-totals-row meterp-totals-total"><span>Total</span><span>R @DisplayTotal.ToString("N2")</span></div>
                    </div>
                </div>
            </div>
    </ChildContent>
    <Footer>
        @if (editorReadOnly)
        {
            @if (UserCanManage)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="SwitchToEditMode" disabled="@_pageBusy" data-testid="quote-edit-button">Edit quote</button>
            }
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor" disabled="@_pageBusy">Close</button>
        }
        else
        {
            @if (!editorIsNew)
            {
                <span class="me-auto">@((MarkupString)GetApprovalBadge(editorQuote.ApprovalStatus))</span>
            }
            @if (CanSubmitApproval)
            {
                <button type="button" class="btn btn-outline-primary" disabled="@_pageBusy"
                        data-testid="quote-submit-approval" @onclick="SubmitForExecutiveApproval">
                    Submit for executive approval
                </button>
            }
            @if (CanWithdrawApproval)
            {
                <button type="button" class="btn btn-outline-secondary" disabled="@_pageBusy"
                        data-testid="quote-withdraw-approval" @onclick="WithdrawFromApproval">
                    Withdraw for edits
                </button>
            }
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor" disabled="@_pageBusy">Cancel</button>
            <button type="button" class="btn btn-primary" disabled="@_pageBusy" data-testid="quote-save-button" @onclick="SaveQuoteHeader">
                @(editorIsNew ? "Save quote" : "Save header")
            </button>
        }
    </Footer>
</FormModal>
}

@if (showNewCustomer && editorQuote != null)
{
<FormModal IsOpen="true"
           Title="New customer"
           Size="md"
           Layer="2"
           TestId="quote-new-customer-modal"
           OnClose="CloseNewCustomer">
    <ChildContent>
        <div data-testid="quote-new-customer-form">
            <p class="meterp-field-hint mb-3">Company name is required. Email and phone help later quoting and invoicing.</p>
            <div class="mb-2">
                <label class="form-label meterp-required">Company name</label>
                <input class="form-control" @bind="newCustomerName" @bind:event="oninput" placeholder="e.g. Acme Mining" data-testid="quote-new-customer-name" />
            </div>
            <div class="mb-2">
                <label class="form-label">Email <span class="text-muted fw-normal">(optional)</span></label>
                <input class="form-control" @bind="newCustomerEmail" placeholder="accounts@company.co.za" />
            </div>
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label">Phone <span class="text-muted fw-normal">(optional)</span></label>
                    <input class="form-control" @bind="newCustomerPhone" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">City <span class="text-muted fw-normal">(optional)</span></label>
                    <input class="form-control" @bind="newCustomerCity" />
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseNewCustomer">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveNewCustomer" disabled="@_pageBusy" data-testid="quote-new-customer-save">Add customer</button>
    </Footer>
</FormModal>
}

@code {
    private List<Quote> quotes = new();
    private TenantBranding _branding = TenantBranding.Default;
    private Tenant? _tenant;
    private bool QuoteQuotaBlocked =>
        _tenant != null && TenantQuotaDefaults.IsAtOrOverLimit(_tenant, QuotaType.Quote);
    private List<Customer> availableCustomers = new();
    private bool _customerError;
    private Quote? editorQuote;
    private bool editorIsNew;
    private bool editorReadOnly;
    private List<QuoteLineDraft> draftLines = new();
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private const int PageSize = 10;
    private int _quotesLoadGeneration;
    private bool _loading = true;
    private bool _pageBusy;
    private bool _lineSaving;
    private readonly SemaphoreSlim _gate = new(1, 1);
    private readonly ComponentAsyncGate _dataGate = new();

    private bool showLineForm;
    private int lineFormKey;
    private bool editingLineIsNew;
    private Guid? editingSavedLineId;
    private Guid? editingDraftLineId;

    private string lineDescription = "";
    private string lineType = "Material";
    private decimal lineQuantity = 1;
    private string lineQuantityText = "1";
    private string? lineUnit;
    private decimal lineUnitCost;
    private string lineUnitCostText = "";
    private decimal lineGrossProfitPercent = 0.25m;
    private decimal lineUnitPrice;
    private string lineUnitPriceText = "";

    private bool showNewCustomer;
    private bool _createQueryApplied;
    private string newCustomerName = "";
    private string newCustomerEmail = "";
    private string newCustomerPhone = "";
    private string newCustomerCity = "";

    private bool UserCanManage => CurrentUserService.Permissions.Contains(Permissions.QuotesManage);
    private bool CanEditLines => UserCanManage && !editorReadOnly && editorQuote?.Status == QuoteStatus.Draft;
    private bool CanConvertToJob =>
        editorQuote != null && UserCanManage && !editorIsNew
        && (editorQuote.Status == QuoteStatus.Draft || editorQuote.Status == QuoteStatus.Sent);
    private bool CanSubmitApproval =>
        editorQuote != null && !editorIsNew && editorQuote.Status == QuoteStatus.Draft && LineCount > 0
        && (editorQuote.ApprovalStatus == QuoteApprovalStatus.None || editorQuote.ApprovalStatus == QuoteApprovalStatus.Rejected);
    private bool CanWithdrawApproval =>
        editorQuote != null && !editorIsNew && editorQuote.Status == QuoteStatus.Draft
        && editorQuote.ApprovalStatus == QuoteApprovalStatus.PendingExecutive;

    private int LineGrossProfitPercentDisplay => (int)Math.Round(lineGrossProfitPercent * 100);

    private int LineCount => editorIsNew ? draftLines.Count : editorQuote?.Lines.Count(l => !l.IsDeleted) ?? 0;

    private decimal DisplaySubtotal => editorIsNew
        ? draftLines.Sum(l => l.LineTotal)
        : editorQuote?.Lines.Where(l => !l.IsDeleted).Sum(l => l.LineTotal) ?? 0;

    private decimal DisplayGrossProfit => editorIsNew
        ? draftLines.Sum(l => l.LineTotal - l.UnitCost * l.Quantity)
        : editorQuote != null ? QuotePricing.QuoteGrossProfit(editorQuote.Lines) : 0;

    private decimal DisplayBlendedGp => QuotePricing.BlendedGrossProfitPercent(DisplaySubtotal, DisplayGrossProfit);

    private bool ShowGpSummary => DisplayGrossProfit > 0 || HasLineWithCost;

    private bool HasLineWithCost => editorIsNew
        ? draftLines.Any(l => l.UnitCost > 0)
        : editorQuote?.Lines.Any(l => !l.IsDeleted && l.UnitCost > 0) ?? false;

    private decimal DisplayTax => Math.Round(DisplaySubtotal * (editorQuote?.TaxRate ?? 0.15m), 2);
    private decimal DisplayTotal => DisplaySubtotal + DisplayTax;

    private IReadOnlyList<EntityPickerOption> CustomerPickerOptions =>
        availableCustomers.Select(c => new EntityPickerOption { Id = c.Id, Label = c.Name }).ToList();

    private string? SelectedCustomerName =>
        availableCustomers.FirstOrDefault(c => c.Id == editorQuote?.CustomerId)?.Name
        ?? editorQuote?.Customer?.Name;

    private string QuoteEditorTitle => editorQuote == null
        ? "Quote"
        : editorIsNew
            ? "New quote"
            : $"{editorQuote.QuoteNumber} — {editorQuote.Customer?.Name ?? SelectedCustomerName ?? "—"}";

    protected override async Task OnInitializedAsync() => await _dataGate.RunAsync(async () =>
    {
        _loading = true;
        try
        {
            var tenantId = TenantProvider.GetCurrentTenantId();
            if (tenantId != Guid.Empty)
            {
                _tenant = await TenantService.GetByIdAsync(tenantId);
                _branding = TenantBranding.From(_tenant);
            }

            ApplyListSearchQuery();
            await LoadCustomers();
            await LoadQuotes();
            HandleCreateQuery();
            await EnsureSelectedCustomerInListAsync();
            await HandleOpenQueryAsync();
        }
        finally
        {
            _loading = false;
        }
    });

    private void OnLineDescriptionChanged(ChangeEventArgs e) =>
        lineDescription = e.Value?.ToString() ?? "";

    private void OnLineGrossProfitChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pct))
            lineGrossProfitPercent = Math.Clamp(pct, 0, 99) / 100m;
        ApplyGrossProfitToLinePrice();
    }

    private void OnLineQuantityChanged(ChangeEventArgs e)
    {
        lineQuantityText = e.Value?.ToString() ?? "";
        if (TryParseDecimal(lineQuantityText, out var parsed) && parsed > 0)
            lineQuantity = parsed;
    }

    private void OnLineUnitChanged(ChangeEventArgs e) => lineUnit = e.Value?.ToString();

    private void OnLineUnitCostChanged(ChangeEventArgs e)
    {
        lineUnitCostText = e.Value?.ToString() ?? "";
        if (TryParseDecimal(lineUnitCostText, out var parsed))
        {
            lineUnitCost = parsed;
            ApplyGrossProfitToLinePrice();
        }
    }

    private void OnLineUnitPriceChanged(ChangeEventArgs e)
    {
        lineUnitPriceText = e.Value?.ToString() ?? "";
        if (TryParseDecimal(lineUnitPriceText, out var parsed))
            lineUnitPrice = parsed;
    }

    private static bool TryParseDecimal(string? text, out decimal parsed) =>
        decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out parsed);

    private void CommitLineNumericFields()
    {
        lineQuantity = TryParseDecimal(lineQuantityText, out var qty) && qty > 0 ? qty : 1;
        lineQuantityText = lineQuantity.ToString(CultureInfo.InvariantCulture);
        if (TryParseDecimal(lineUnitCostText, out var cost))
            lineUnitCost = cost;
        if (TryParseDecimal(lineUnitPriceText, out var price))
            lineUnitPrice = price;
    }

    private void ApplyGrossProfitToLinePrice()
    {
        if (lineUnitCost <= 0) return;
        lineUnitPrice = QuotePricing.SellPriceFromCost(lineUnitCost, lineGrossProfitPercent);
        lineUnitPriceText = lineUnitPrice.ToString(CultureInfo.InvariantCulture);
    }

    private async Task RunGuardedAsync(Func<Task> action)
    {
        await _gate.WaitAsync();
        _pageBusy = true;
        try { await action(); }
        finally { _pageBusy = false; _gate.Release(); }
    }

    private async Task RunLineSaveAsync(Func<Task> action)
    {
        if (_lineSaving) return;
        _lineSaving = true;
        try { await action(); }
        finally { _lineSaving = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _createQueryApplied || !UserCanManage)
            return;

        HandleCreateQuery();
        if (_createQueryApplied)
            await InvokeAsync(StateHasChanged);
    }

    private void HandleCreateQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("create", out var create) || create != "1" || !UserCanManage) return;

        var wantNewCustomer = query.TryGetValue("newCustomer", out var nc) && nc == "1";
        if (editorQuote == null || !editorIsNew)
            ShowCreateEditor();
        if (editorQuote == null)
            return;

        if (query.TryGetValue("customerId", out var cid) && Guid.TryParse(cid, out var customerId) && customerId != Guid.Empty)
            editorQuote.CustomerId = customerId;
        if (query.TryGetValue("notes", out var notes) && !string.IsNullOrWhiteSpace(notes))
            editorQuote.Notes = notes.ToString();
        if (wantNewCustomer)
            showNewCustomer = true;
        if (!showLineForm)
            ShowAddLineForm();

        _createQueryApplied = true;
    }

    /// <summary>Opens an existing quote from ?open={id} (stable path for E2E / deep links).</summary>
    private async Task HandleOpenQueryAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("open", out var openVal) || !Guid.TryParse(openVal, out var quoteId) || quoteId == Guid.Empty)
            return;
        var quote = await QuoteService.GetByIdAsync(quoteId);
        if (quote == null) return;
        SetEditorQuote(quote);
        editorIsNew = false;
        editorReadOnly = false;
        draftLines = new();
        CancelLineForm();
    }

    private void ApplyListSearchQuery()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.TryGetValue("search", out var s) && !string.IsNullOrWhiteSpace(s))
            searchTerm = s.ToString();
    }

    private async Task LoadCustomers() => await SearchCustomersAsync("");

    private async Task SearchCustomersAsync(string term)
    {
        // Strip Contacts navigation — Customer→Contacts→Customer cycles break Blazor Server circuits.
        availableCustomers = (await CustomerService.GetAllAsync(
                string.IsNullOrWhiteSpace(term) ? null : term.Trim(), 1, 50))
            .Select(c => new Customer { Id = c.Id, Name = c.Name })
            .ToList();
        await EnsureSelectedCustomerInListAsync();
    }

    private async Task EnsureSelectedCustomerInListAsync()
    {
        if (editorQuote == null || editorQuote.CustomerId == Guid.Empty)
            return;
        if (availableCustomers.Any(c => c.Id == editorQuote.CustomerId))
            return;
        var extra = await CustomerService.GetByIdAsync(editorQuote.CustomerId);
        if (extra != null)
            availableCustomers.Insert(0, new Customer { Id = extra.Id, Name = extra.Name });
    }

    private Task OnCustomerPickedAsync(Guid id)
    {
        if (editorQuote != null)
            editorQuote.CustomerId = id;
        _customerError = id == Guid.Empty;
        return Task.CompletedTask;
    }

    private async Task LoadQuotes()
    {
        var gen = ++_quotesLoadGeneration;
        var loaded = (await QuoteService.GetAllAsync(string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm, currentPage, PageSize)).ToList();
        if (gen == _quotesLoadGeneration)
            quotes = loaded.Select(q => QuoteUiHelper.DetachForUi(q)!).ToList();
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
        return RunGuardedAsync(LoadQuotes);
    }

    private Task ClearSearch()
    {
        searchTerm = "";
        currentPage = 1;
        return RunGuardedAsync(LoadQuotes);
    }

    private Task PreviousPage()
    {
        if (currentPage <= 1) return Task.CompletedTask;
        currentPage--;
        return RunGuardedAsync(LoadQuotes);
    }

    private Task NextPage() => RunGuardedAsync(async () =>
    {
        currentPage++;
        await LoadQuotes();
    });

    private void ShowCreateEditor()
    {
        if (QuoteQuotaBlocked)
        {
            ToastService.ShowError(TenantQuotaDefaults.GetQuotaTooltip(_tenant!, QuotaType.Quote, "Quotes"));
            return;
        }

        editorQuote = new Quote
        {
            QuoteDate = DateTime.UtcNow.Date,
            ValidUntil = DateTime.UtcNow.Date.AddDays(30),
            TaxRate = 0.15m,
            GrossProfitPercent = 0.25m,
            Status = QuoteStatus.Draft
        };
        editorIsNew = true;
        editorReadOnly = false;
        _customerError = false;
        draftLines = new();
        // Ensure InteractiveServer paints the editor after button click / create query.
        CancelLineForm();
        StateHasChanged();
    }

    private void SetEditorQuote(Quote? quote) =>
        editorQuote = QuoteUiHelper.DetachForUi(quote);

    private async Task OpenEditor(Quote q, bool readOnly)
    {
        // Do not use the page-busy gate for open/view — E2E and users need the editor
        // even if a list refresh is in flight.
        try
        {
            var full = await QuoteService.GetByIdAsync(q.Id);
            SetEditorQuote(full);
            if (editorQuote == null)
            {
                ToastService.ShowError("Quote could not be loaded.");
                return;
            }
            editorIsNew = false;
            editorReadOnly = readOnly;
            draftLines = new();
            CancelLineForm();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to open quote: {ex.Message}");
        }
    }

    private Task ViewQuote(Quote q) => OpenEditor(q, true);
    private Task EditQuote(Quote q) => OpenEditor(q, false);
    private void SwitchToEditMode() => editorReadOnly = false;

    private void CloseEditor()
    {
        editorQuote = null;
        draftLines = new();
        CancelLineForm();
        showNewCustomer = false;
    }

    private async Task ToggleNewCustomer()
    {
        showNewCustomer = true;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseNewCustomer() => showNewCustomer = false;

    private Task SaveNewCustomer()
    {
        if (string.IsNullOrWhiteSpace(newCustomerName))
        {
            ToastService.ShowError("Customer name is required.");
            return Task.CompletedTask;
        }

        return RunGuardedAsync(async () =>
        {
            try
            {
                var id = await CustomerService.CreateAsync(new Customer
                {
                    Name = newCustomerName.Trim(),
                    Email = string.IsNullOrWhiteSpace(newCustomerEmail) ? null : newCustomerEmail.Trim(),
                    Phone = string.IsNullOrWhiteSpace(newCustomerPhone) ? null : newCustomerPhone.Trim(),
                    City = string.IsNullOrWhiteSpace(newCustomerCity) ? null : newCustomerCity.Trim(),
                    Country = "South Africa"
                });
                await LoadCustomers();
                if (editorQuote != null) editorQuote.CustomerId = id;
                newCustomerName = newCustomerEmail = newCustomerPhone = newCustomerCity = "";
                showNewCustomer = false;
                ToastService.ShowSuccess("Customer created and selected.");
            }
            catch (Exception ex) { ToastService.ShowError(ex.Message); }
        });
    }

    private Task SubmitForExecutiveApproval()
    {
        if (editorQuote == null || CurrentUserService.UserId is not { } userId)
            return Task.CompletedTask;

        return RunGuardedAsync(async () =>
        {
            try
            {
                await QuoteService.SubmitForExecutiveApprovalAsync(editorQuote.Id, userId);
                ToastService.ShowSuccess("Submitted for executive approval — it is now in Approvals.");
                CloseEditor();
                await LoadQuotes();
            }
            catch (Exception ex)
            {
                ToastService.ShowError(ex.Message);
            }
        });
    }

    private Task WithdrawFromApproval()
    {
        if (editorQuote == null || CurrentUserService.UserId is not { } userId)
            return Task.CompletedTask;

        return RunGuardedAsync(async () =>
        {
            try
            {
                await QuoteService.WithdrawFromApprovalAsync(editorQuote.Id, userId, "Withdrawn to edit lines");
                SetEditorQuote(await QuoteService.GetByIdAsync(editorQuote.Id));
                ToastService.ShowSuccess("Quote withdrawn — lines can be edited again.");
            }
            catch (Exception ex)
            {
                ToastService.ShowError(ex.Message);
            }
        });
    }

    private Task SaveQuoteHeader()
    {
        if (editorQuote == null) return Task.CompletedTask;
        _customerError = editorQuote.CustomerId == Guid.Empty;
        if (_customerError)
        {
            ToastService.ShowError("Select a customer, or create one if they are new.");
            return Task.CompletedTask;
        }

        return RunGuardedAsync(async () =>
        {
            try
            {
                if (editorIsNew)
                {
                    var quoteToCreate = new Quote
                    {
                        CustomerId = editorQuote.CustomerId,
                        QuoteDate = editorQuote.QuoteDate,
                        ValidUntil = editorQuote.ValidUntil,
                        TaxRate = editorQuote.TaxRate,
                        GrossProfitPercent = editorQuote.GrossProfitPercent,
                        Status = editorQuote.Status,
                        Notes = editorQuote.Notes
                    };
                    foreach (var line in draftLines.Select(d => d.ToQuoteLine()))
                        quoteToCreate.Lines.Add(line);

                    var id = await QuoteService.CreateAsync(quoteToCreate);
                    SetEditorQuote(await QuoteService.GetByIdAsync(id));
                    editorIsNew = false;
                    draftLines = new();
                    ToastService.ShowSuccess("Quote saved with line items.");
                }
                else
                {
                    await QuoteService.UpdateAsync(editorQuote);
                    SetEditorQuote(await QuoteService.GetByIdAsync(editorQuote.Id));
                    ToastService.ShowSuccess("Quote updated.");
                }
                await LoadQuotes();
            }
            catch (QuotaExceededException ex) { ToastService.ShowError(ex.Message); }
            catch (Exception ex) { ToastService.ShowError($"Save failed: {ex.Message}"); }
        });
    }

    private Task DeleteQuote(Quote q) => RunGuardedAsync(async () =>
    {
        if (!await Confirm($"Delete quote {q.QuoteNumber}?")) return;
        await QuoteService.DeleteAsync(q.Id);
        if (editorQuote?.Id == q.Id) CloseEditor();
        await LoadQuotes();
        ToastService.ShowSuccess("Quote deleted.");
    });

