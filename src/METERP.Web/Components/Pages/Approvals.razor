@page "/approvals"
@using METERP.Application.Interfaces
@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Common
@using METERP.Domain
@using Microsoft.AspNetCore.Components
@attribute [Authorize(Policy = "Approvals.View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IQuoteService QuoteService
@inject ILeaveService LeaveService
@inject IStockRequisitionService RequisitionService
@inject IFieldReportService FieldReportService
@inject IAccountabilityReportService AccountabilityReports
@inject ICurrentUserService CurrentUser
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>Approvals</PageTitle>

<PageHeader Title="Approvals" Subtitle="Quotes, requisitions, leave, field reports, and sign-offs in one queue." TestId="approvals-page-header">
    <Actions>
        <ExportToolbar ShowPdf="false" ShowExcel="false" TestId="approvals-export" OnExportCsv="ExportOverdueCsvAsync" />
    </Actions>
</PageHeader>

@if (_overdueApprovals.Count > 0)
{
    <div class="alert alert-danger py-2 mb-3" data-testid="approvals-sla-overdue" role="alert">
        <strong>@_overdueApprovals.Count approval(s) past SLA.</strong>
        <span class="ms-1 small">Longest wait: @_overdueApprovals.Max(o => o.HoursInQueue)h (SLA @_overdueApprovals[0].SlaHours h).</span>
    </div>
}

<ul class="nav nav-tabs mb-3" role="tablist" data-testid="approvals-tabs">
    @foreach (var tab in _tabs)
    {
        <li class="nav-item" role="presentation">
            <button type="button" class="nav-link @(_activeTab == tab.Key ? "active" : "")"
                    data-testid="@($"approvals-tab-{tab.Key}")"
                    @onclick="() => SelectTab(tab.Key)">
                @tab.Label
                @if (tab.Count > 0)
                {
                    <span class="badge bg-warning text-dark ms-1">@tab.Count</span>
                }
            </button>
        </li>
    }
</ul>

<div data-testid="approvals-ready">
    @if (_loading)
    {
        <ListSkeleton Rows="3" TestId="approvals-skeleton" />
    }
    else if (_activeTab == "field")
    {
        <div data-testid="approvals-field-panel">
            @if (_pendingFieldReports.Count > 0)
            {
                @FieldReportList()
            }
            else
            {
                <EmptyState Title="No field reports pending"
                            Description="Technicians submit hours and travel from the Field Portal."
                            Icon="📝"
                            TestId="approvals-field-empty" />
            }
        </div>
    }
    else if (_activeTab == "signoff")
    {
        <div class="alert alert-info" data-testid="approvals-tab-panel">
            <strong>Job work sign-off</strong> — dual chain on the Job Command Center: manager, then executive (before final/partial invoices).
            <a href="/jobs" class="alert-link ms-1">Open jobs</a>
        </div>
    }
    else if (ShowQuotes && _pendingQuotes.Count > 0)
    {
        <div class="list-group @(HasMoreAfterQuotes ? "mb-3" : "")" data-testid="approvals-quotes-list">
            @foreach (var quote in _pendingQuotes)
            {
                <div class="list-group-item list-group-item-action" style="cursor:pointer;"
                     data-testid="approvals-quote-row" @onclick="() => OpenQuoteReviewAsync(quote)">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="badge bg-light text-dark me-1">Quote</span>
                            <strong>@quote.QuoteNumber</strong> — @(quote.Customer?.Name ?? "—")
                            <div class="small text-muted">R @quote.Total.ToString("N2") · submitted @quote.SubmittedForApprovalAt?.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                        @if (CanApproveQuotes)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenQuoteReviewAsync(quote)" @onclick:stopPropagation="true">
                                Review
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
        @if (ShowRequisitions && _pendingRequisitions.Count > 0)
        {
            @RequisitionList()
        }
        @if (ShowLeave && _pendingLeave.Count > 0)
        {
            @LeaveList()
        }
        @if (ShowFieldReports && _pendingFieldReports.Count > 0)
        {
            @FieldReportList()
        }
    }
    else if (ShowRequisitions && _pendingRequisitions.Count > 0)
    {
        @RequisitionList()
    }
    else if (_activeTab == "leave")
    {
        <div data-testid="approvals-leave-panel">
            @if (_pendingLeave.Count > 0)
            {
                @LeaveList()
            }
            else
            {
                <EmptyState Title="No leave requests pending approval"
                            Description="Technicians submit leave via the Field Portal; managers and HR approve here."
                            Icon="🏖️"
                            TestId="approvals-leave-empty" />
            }
        </div>
    }
    else if (ShowLeave && _pendingLeave.Count > 0)
    {
        @LeaveList()
    }
    else if (_activeTab == "requisitions")
    {
        <EmptyState Title="No stock requisitions pending approval"
                    Description="Field technicians submit material requests; managers and executives approve here."
                    Icon="📦"
                    TestId="approvals-requisitions-empty" />
    }
    else if (_activeTab == "quotes")
    {
        <EmptyState Title="No quotes awaiting executive approval"
                    Description="Estimators submit draft quotes for review before client send."
                    Icon="📋"
                    TestId="approvals-quotes-empty" />
    }
    else
    {
        <EmptyState Title="No pending approvals"
                    Description="When items need your action, they will appear here with accountable queues per role."
                    Icon="✅"
                    TestId="approvals-empty" />
    }
</div>

@if (_reviewQuote != null)
{
    <FormModal IsOpen="true"
               Title="@($"{_reviewQuote.QuoteNumber} — {_reviewQuote.Customer?.Name}")"
               Size="full"
               TestId="approvals-quote-review"
               CloseOnBackdrop="false"
               OnClose="CloseQuoteReview">
        <ChildContent>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="meterp-section">
                        <div class="meterp-section-title">Quote</div>
                        <p class="mb-1"><strong>Customer:</strong> @(_reviewQuote.Customer?.Name ?? "—")</p>
                        <p class="mb-1"><strong>Date:</strong> @_reviewQuote.QuoteDate.ToString("yyyy-MM-dd") · Valid @_reviewQuote.ValidUntil.ToString("yyyy-MM-dd")</p>
                        @if (!string.IsNullOrWhiteSpace(_reviewQuote.Notes))
                        {
                            <p class="mb-0"><strong>Estimator notes:</strong> @_reviewQuote.Notes</p>
                        }
                    </div>
                    <div class="meterp-section">
                        <div class="meterp-section-title">Lines</div>
                        <p class="small text-muted">Revise quantities or prices before you approve. The estimator sees the updated quote.</p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Type</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _reviewQuote.Lines.Where(l => !l.IsDeleted))
                                {
                                    <tr>
                                        <td>@line.Description</td>
                                        <td>@line.LineType</td>
                                        <td style="width:6rem;">
                                            <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                   data-testid="approvals-quote-line-qty"
                                                   @bind="line.Quantity" @bind:after="RecalcReviewQuote"
                                                   disabled="@(!CanApproveQuotes)" />
                                        </td>
                                        <td style="width:8rem;">
                                            <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end"
                                                   data-testid="approvals-quote-line-price"
                                                   @bind="line.UnitPrice" @bind:after="RecalcReviewQuote"
                                                   disabled="@(!CanApproveQuotes)" />
                                        </td>
                                        <td class="text-end">R @line.LineTotal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="meterp-totals mb-3">
                        <div class="meterp-totals-row"><span>Subtotal</span><strong>R @_reviewQuote.Subtotal.ToString("N2")</strong></div>
                        <div class="meterp-totals-row"><span>VAT</span><span>R @_reviewQuote.Tax.ToString("N2")</span></div>
                        <div class="meterp-totals-row meterp-totals-total"><span>Total</span><span>R @_reviewQuote.Total.ToString("N2")</span></div>
                    </div>
                    <label class="form-label">Note to the estimator</label>
                    <textarea class="form-control" rows="4" data-testid="approvals-quote-note"
                              @bind="_reviewNote" placeholder="Optional on approve. Required if you reject."></textarea>
                    <span class="meterp-field-hint">They see this on the quote after you decide.</span>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseQuoteReview">Close</button>
            @if (CanApproveQuotes)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="SaveReviewQuoteLinesAsync">Save changes</button>
                <button type="button" class="btn btn-outline-danger" data-testid="approvals-quote-reject"
                        @onclick="RejectReviewedQuoteAsync">Reject</button>
                <button type="button" class="btn btn-success" data-testid="approvals-quote-approve"
                        @onclick="ApproveReviewedQuoteAsync">Approve</button>
            }
        </Footer>
    </FormModal>
}

@if (_reviewReq != null)
{
    <FormModal IsOpen="true"
               Title="@($"{_reviewReq.RequisitionNumber} — {_reviewReq.Job?.JobNumber}")"
               Size="lg"
               TestId="approvals-requisition-review"
               CloseOnBackdrop="false"
               OnClose="CloseRequisitionReview">
        <ChildContent>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="meterp-section">
                        <div class="meterp-section-title">Stock request</div>
                        <p class="mb-1"><strong>Job:</strong> @(_reviewReq.Job?.JobNumber ?? "—") @(_reviewReq.Job?.Title)</p>
                        <p class="mb-1"><strong>Status:</strong> @GetRequisitionStatusLabel(_reviewReq.Status)</p>
                        @if (_reviewReq.IsPpe)
                        {
                            <p class="mb-1"><span class="badge bg-warning text-dark">PPE</span></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_reviewReq.Notes))
                        {
                            <p class="mb-0"><strong>Requester notes:</strong> @_reviewReq.Notes</p>
                        }
                    </div>
                    <div class="meterp-section">
                        <div class="meterp-section-title">Lines</div>
                        <p class="small text-muted">Change quantities before you approve. The requester sees your note.</p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _reviewReq.Lines.Where(l => !l.IsDeleted))
                                {
                                    <tr>
                                        <td>@(line.InventoryItem?.Name ?? line.DisplayDescription)</td>
                                        <td style="width:7rem;">
                                            <input type="number" step="0.01" min="0.01" class="form-control form-control-sm text-end"
                                                   data-testid="approvals-requisition-line-qty"
                                                   @bind="line.QuantityRequested"
                                                   disabled="@(!CanApproveRequisitions)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">Note to the requester</label>
                    <textarea class="form-control" rows="4" data-testid="approvals-requisition-note"
                              @bind="_reviewNote" placeholder="Optional on approve. Required if you reject."></textarea>
                    <span class="meterp-field-hint">They see this on the requisition after you decide.</span>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseRequisitionReview">Close</button>
            @if (CanApproveRequisitions)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="SaveReviewRequisitionLinesAsync">Save changes</button>
                <button type="button" class="btn btn-outline-danger" data-testid="approvals-requisition-reject"
                        @onclick="RejectReviewedRequisitionAsync">Reject</button>
                <button type="button" class="btn btn-success" data-testid="approvals-requisition-approve"
                        @onclick="ApproveReviewedRequisitionAsync">Approve</button>
            }
        </Footer>
    </FormModal>
}

@if (_reviewLeave != null)
{
    <FormModal IsOpen="true"
               Title="@($"Leave — {LeaveEmployeeName(_reviewLeave)}")"
               Size="lg"
               TestId="approvals-leave-review"
               CloseOnBackdrop="false"
               OnClose="CloseLeaveReview">
        <ChildContent>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="meterp-section">
                        <div class="meterp-section-title">Leave request</div>
                        <p class="mb-1"><strong>Employee:</strong> @LeaveEmployeeName(_reviewLeave)</p>
                        <p class="mb-3"><strong>Stage:</strong> @GetLeaveStatusLabel(_reviewLeave.Status)</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Start</label>
                                <input type="date" class="form-control" data-testid="approvals-leave-start"
                                       @bind="_reviewLeave.StartDate" @bind:after="RecalcLeaveDays"
                                       disabled="@(!CanApproveLeave)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">End</label>
                                <input type="date" class="form-control" data-testid="approvals-leave-end"
                                       @bind="_reviewLeave.EndDate" @bind:after="RecalcLeaveDays"
                                       disabled="@(!CanApproveLeave)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Days</label>
                                <input type="number" step="0.5" min="0.5" class="form-control"
                                       @bind="_reviewLeave.DaysRequested" disabled="@(!CanApproveLeave)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Reason</label>
                                <textarea class="form-control" rows="2" @bind="_reviewLeave.Reason" disabled="@(!CanApproveLeave)"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">Note to the requester</label>
                    <textarea class="form-control" rows="4" data-testid="approvals-leave-note"
                              @bind="_reviewNote" placeholder="Optional on approve. Required if you reject."></textarea>
                    <span class="meterp-field-hint">They see this on the leave request after you decide.</span>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseLeaveReview">Close</button>
            @if (CanApproveLeave && CanActOnLeave(_reviewLeave))
            {
                <button type="button" class="btn btn-outline-primary" @onclick="SaveReviewLeaveAsync">Save changes</button>
                <button type="button" class="btn btn-outline-danger" data-testid="approvals-leave-reject"
                        @onclick="RejectReviewedLeaveAsync">Reject</button>
                <button type="button" class="btn btn-success" data-testid="approvals-leave-approve"
                        @onclick="ApproveReviewedLeaveAsync">Approve</button>
            }
        </Footer>
    </FormModal>
}

@if (_reviewField != null)
{
    <FormModal IsOpen="true"
               Title="@($"Field report — {_reviewField.Job?.JobNumber}")"
               Size="lg"
               TestId="approvals-field-review"
               CloseOnBackdrop="false"
               OnClose="CloseFieldReview">
        <ChildContent>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="meterp-section">
                        <div class="meterp-section-title">Field report</div>
                        <p class="mb-1"><strong>Job:</strong> @(_reviewField.Job?.JobNumber ?? "—") @(_reviewField.Job?.Title)</p>
                        <div class="row g-3 mt-1">
                            <div class="col-md-4">
                                <label class="form-label">Work date</label>
                                <input type="date" class="form-control" @bind="_reviewField.WorkDate" disabled="@(!CanApproveFieldReports)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Hours</label>
                                <input type="number" step="0.5" min="0" class="form-control" data-testid="approvals-field-hours"
                                       @bind="_reviewField.HoursWorked" disabled="@(!CanApproveFieldReports)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Travel (R)</label>
                                <input type="number" step="0.01" min="0" class="form-control" data-testid="approvals-field-travel"
                                       @bind="_reviewField.TravelCost" disabled="@(!CanApproveFieldReports)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Materials used</label>
                                <textarea class="form-control" rows="2" @bind="_reviewField.MaterialsUsed" disabled="@(!CanApproveFieldReports)"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Technician comments</label>
                                <textarea class="form-control" rows="2" @bind="_reviewField.Comments" disabled="@(!CanApproveFieldReports)"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <label class="form-label">Note to the requester</label>
                    <textarea class="form-control" rows="4" data-testid="approvals-field-note"
                              @bind="_reviewNote" placeholder="Optional on approve. Required if you reject."></textarea>
                    <span class="meterp-field-hint">They see this on the field report after you decide.</span>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseFieldReview">Close</button>
            @if (CanApproveFieldReports)
            {
                <button type="button" class="btn btn-outline-primary" @onclick="SaveReviewFieldAsync">Save changes</button>
                <button type="button" class="btn btn-outline-danger" data-testid="approvals-field-reject"
                        @onclick="RejectReviewedFieldAsync">Reject</button>
                <button type="button" class="btn btn-success" data-testid="approvals-field-approve"
                        @onclick="ApproveReviewedFieldAsync">Approve &amp; post costs</button>
            }
        </Footer>
    </FormModal>
}

@if (_rejectOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)" data-testid="approvals-reject-modal" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_rejectTitle</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseRejectModal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">@_rejectMessage</p>
                    <label class="form-label" for="approvals-reject-reason">Reason <span class="text-danger">*</span></label>
                    <textarea id="approvals-reject-reason" class="form-control" rows="3"
                              data-testid="approvals-reject-reason"
                              @bind="_rejectReason" placeholder="Explain why this is being rejected"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseRejectModal">Cancel</button>
                    <button type="button" class="btn btn-danger" data-testid="approvals-reject-confirm"
                            disabled="@_rejectBusy" @onclick="ConfirmRejectAsync">Reject</button>
                </div>
            </div>
        </div>
    </div>
}

@* ConfirmDialogHost lives in MainLayout — do not mount a second host (double backdrop blocks E2E clicks). *@

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string _activeTab = "all";
    private bool _loading = true;
    private List<Quote> _pendingQuotes = new();
    private List<LeaveRequest> _pendingLeave = new();
    private List<StockRequisition> _pendingRequisitions = new();
    private List<FieldReport> _pendingFieldReports = new();
    private List<OverdueApprovalRow> _overdueApprovals = new();

    private bool _rejectOpen;
    private bool _rejectBusy;
    private string _rejectTitle = "Reject";
    private string _rejectMessage = "";
    private string _rejectReason = "";
    private Func<string, Task>? _rejectAction;

    private readonly List<ApprovalTab> _tabs =
    [
        new("all", "All", 0),
        new("quotes", "Quotes", 0),
        new("requisitions", "Stock", 0),
        new("leave", "Leave", 0),
        new("field", "Field reports", 0),
        new("signoff", "Job sign-off", 0)
    ];

    private bool CanApproveQuotes => CurrentUser.Permissions.Contains(Permissions.QuotesApprove);
    private bool CanApproveLeave => CurrentUser.Permissions.Contains(Permissions.LeaveApprove);
    private bool CanApproveRequisitions => CurrentUser.Permissions.Contains(Permissions.RequisitionsApprove);
    private bool ShowQuotes => _activeTab is "all" or "quotes";
    private bool ShowRequisitions => _activeTab is "all" or "requisitions";
    private bool ShowLeave => _activeTab is "all" or "leave";
    private bool ShowFieldReports => _activeTab is "all" or "field";
    private bool CanApproveFieldReports => CurrentUser.Permissions.Contains(Permissions.JobsManage);
    private bool HasMoreAfterQuotes =>
        (ShowRequisitions && _pendingRequisitions.Count > 0)
        || (ShowLeave && _pendingLeave.Count > 0)
        || (ShowFieldReports && _pendingFieldReports.Count > 0);

    private int TotalPending => _tabs.Sum(t => t.Count);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Tab)
            && _tabs.Any(t => string.Equals(t.Key, Tab, StringComparison.OrdinalIgnoreCase)))
        {
            _activeTab = Tab.Trim().ToLowerInvariant();
        }

        // First paint of approvals-ready/tabs before sequential queue queries (InteractiveServer, no prerender).
        await Task.Yield();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _pendingQuotes = (await QuoteService.GetPendingExecutiveApprovalAsync()).ToList();
            _pendingLeave = (await LeaveService.GetPendingApprovalsAsync()).ToList();
            _pendingRequisitions = (await RequisitionService.GetPendingApprovalsAsync()).ToList();
            _pendingFieldReports = (await FieldReportService.GetPendingAsync()).ToList();
            _overdueApprovals = (await AccountabilityReports.GetOverdueApprovalsAsync()).ToList();
            UpdateTabCount("quotes", _pendingQuotes.Count);
            UpdateTabCount("requisitions", _pendingRequisitions.Count);
            UpdateTabCount("leave", _pendingLeave.Count);
            UpdateTabCount("field", _pendingFieldReports.Count);
            UpdateTabCount("all", _pendingQuotes.Count + _pendingRequisitions.Count + _pendingLeave.Count + _pendingFieldReports.Count);
        }
        catch (Exception)
        {
            Toast.ShowError("Could not load the approvals queue.");
        }
        finally
        {
            _loading = false;
        }
    }

    private void UpdateTabCount(string key, int count)
    {
        var idx = _tabs.FindIndex(t => t.Key == key);
        if (idx >= 0)
            _tabs[idx] = _tabs[idx] with { Count = count };
    }

    private async Task SelectTab(string key)
    {
        _activeTab = key;
        await InvokeAsync(StateHasChanged);
    }

    private string GetTabLabel(string key) => _tabs.First(t => t.Key == key).Label;

    private RenderFragment RequisitionList() => __builder =>
    {
        <div class="list-group mb-3" data-testid="approvals-requisitions-list">
            @foreach (var req in _pendingRequisitions)
            {
                var lineSummary = string.Join(", ", req.Lines.Select(l =>
                    $"{l.InventoryItem?.Name ?? "Item"} x{l.QuantityRequested:N0}"));
                <div class="list-group-item list-group-item-action" style="cursor:pointer;"
                     data-testid="approvals-requisition-row" @onclick="() => OpenRequisitionReviewAsync(req)">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="badge bg-light text-dark me-1">Stock</span>
                            <strong>@req.RequisitionNumber</strong> — @(req.Job?.JobNumber ?? "—")
                            @if (req.IsPpe)
                            {
                                <span class="badge bg-warning text-dark ms-1">PPE</span>
                            }
                            <div class="small text-muted">@GetRequisitionStatusLabel(req.Status)</div>
                            <div class="small">@lineSummary</div>
                        </div>
                        @if (CanApproveRequisitions)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenRequisitionReviewAsync(req)" @onclick:stopPropagation="true">Review</button>
                        }
