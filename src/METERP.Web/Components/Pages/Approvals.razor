    private async Task RejectCoreAsync(Func<Task<bool>> action, string successMessage, Action close)
    {
        try
        {
            if (!await action())
            {
                Toast.ShowError("This request could not be rejected.");
                return;
            }

            Toast.ShowInfo(successMessage);
            close();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private void OpenRejectModal(string title, string message, Func<string, Task> action)
    {
        _rejectTitle = title;
        _rejectMessage = message;
        _rejectReason = "";
        _rejectAction = action;
        _rejectBusy = false;
        _rejectOpen = true;
    }

    private void CloseRejectModal()
    {
        _rejectOpen = false;
        _rejectBusy = false;
        _rejectAction = null;
        _rejectReason = "";
    }

    private async Task ConfirmRejectAsync()
    {
        if (_rejectAction is null) return;
        if (string.IsNullOrWhiteSpace(_rejectReason))
        {
            Toast.ShowError("Rejection reason is required.");
            return;
        }

        _rejectBusy = true;
        try
        {
            await _rejectAction(_rejectReason.Trim());
            CloseRejectModal();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _rejectBusy = false;
        }
    }

