    private RenderFragment FieldReportList() => __builder =>
    {
        <div class="list-group mb-3" data-testid="approvals-field-list">
            @foreach (var report in _pendingFieldReports)
            {
                <div class="list-group-item list-group-item-action" style="cursor:pointer;"
                     data-testid="approvals-field-row" @onclick="() => OpenFieldReviewAsync(report)">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="badge bg-light text-dark me-1">Field</span>
                            <strong>@(report.Job?.JobNumber ?? "—")</strong>
                            <div class="small text-muted">
                                @report.WorkDate.ToString("dd MMM yyyy") · @report.HoursWorked.ToString("N1")h · travel R @report.TravelCost.ToString("N2")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(report.Comments))
                            {
                                <div class="small">@report.Comments</div>
                            }
                        </div>
                        @if (CanApproveFieldReports)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenFieldReviewAsync(report)" @onclick:stopPropagation="true">Review</button>
                        }
                    </div>
                </div>
            }
        </div>
    };

    private RenderFragment LeaveList() => __builder =>
    {
        <div class="list-group" data-testid="approvals-leave-list">
            @foreach (var request in _pendingLeave)
            {
                var employeeName = request.Employee != null
                    ? $"{request.Employee.FirstName} {request.Employee.LastName}"
                    : "Employee";
                <div class="list-group-item list-group-item-action" style="cursor:pointer;"
                     data-testid="approvals-leave-row" @onclick="() => OpenLeaveReviewAsync(request)">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="badge bg-light text-dark me-1">Leave</span>
                            <strong>@employeeName</strong>
                            <div class="small text-muted">
                                @request.StartDate.ToString("dd MMM") – @request.EndDate.ToString("dd MMM yyyy")
                                · @request.DaysRequested.ToString("N1") day(s) · @GetLeaveStatusLabel(request.Status)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(request.Reason))
                            {
                                <div class="small">@request.Reason</div>
                            }
                        </div>
                        @if (CanApproveLeave && CanActOnLeave(request))
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenLeaveReviewAsync(request)" @onclick:stopPropagation="true">Review</button>
                        }
                    </div>
                </div>
            }
        </div>
    };

    private static string GetLeaveStatusLabel(LeaveRequestStatus status) => status switch
    {
        LeaveRequestStatus.PendingManager => "Awaiting manager",
        LeaveRequestStatus.PendingExecutive => "Awaiting executive",
        LeaveRequestStatus.PendingHr => "Awaiting HR",
        _ => status.ToString()
    };

    private static bool CanActOnLeave(LeaveRequest request) =>
        request.Status is LeaveRequestStatus.PendingManager
            or LeaveRequestStatus.PendingExecutive
            or LeaveRequestStatus.PendingHr;

    private async Task ExportOverdueCsvAsync()
    {
        try
        {
            var csv = await AccountabilityReports.ExportOverdueApprovalsCsvAsync();
            try
            {
                await JS.InvokeVoidAsync("meterpUi.downloadText", "overdue-approvals.csv", csv, "text/csv;charset=utf-8");
            }
            catch
            {
                /* download helper may be blocked in headless browsers */
            }
        }
        finally
        {
            Toast.ShowSuccess("Overdue approvals exported.");
        }
    }

    private Quote? _reviewQuote;
    private StockRequisition? _reviewReq;
    private LeaveRequest? _reviewLeave;
    private FieldReport? _reviewField;
    private string _reviewNote = "";

    private async Task OpenQuoteReviewAsync(Quote quote)
    {
        CloseAllReviews();
        _reviewQuote = QuoteUiHelper.DetachForUi(await QuoteService.GetByIdAsync(quote.Id) ?? quote);
        _reviewNote = "";
    }

    private void CloseQuoteReview()
    {
        _reviewQuote = null;
        _reviewNote = "";
    }

    private void CloseAllReviews()
    {
        _reviewQuote = null;
        _reviewReq = null;
        _reviewLeave = null;
        _reviewField = null;
        _reviewNote = "";
    }

    private void RecalcReviewQuote() => _reviewQuote?.RecalculateTotals();

    private async Task SaveReviewQuoteLinesAsync()
    {
        if (_reviewQuote == null) return;
        try
        {
            foreach (var line in _reviewQuote.Lines.Where(l => !l.IsDeleted))
                await QuoteService.ExecutiveReviseLineAsync(line);
            _reviewQuote = QuoteUiHelper.DetachForUi(await QuoteService.GetByIdAsync(_reviewQuote.Id));
            Toast.ShowSuccess("Quote lines updated.");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task ApproveReviewedQuoteAsync()
    {
        if (_reviewQuote == null || CurrentUser.UserId is not { } userId) return;
        try
        {
            foreach (var line in _reviewQuote.Lines.Where(l => !l.IsDeleted))
                await QuoteService.ExecutiveReviseLineAsync(line);
            await QuoteService.ExecutiveApproveAsync(_reviewQuote.Id, userId, _reviewNote);
            Toast.ShowSuccess($"{_reviewQuote.QuoteNumber} approved — the estimator will see your note.");
            CloseQuoteReview();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private Task RejectReviewedQuoteAsync()
    {
        if (_reviewQuote == null || CurrentUser.UserId is not { } userId) return Task.CompletedTask;
        var quote = _reviewQuote;
        var note = _reviewNote;
        if (string.IsNullOrWhiteSpace(note))
        {
            Toast.ShowError("Add a note so the estimator knows why it was rejected.");
            return Task.CompletedTask;
        }

        return RejectQuoteCoreAsync(quote, userId, note);
    }

    private async Task RejectQuoteCoreAsync(Quote quote, Guid userId, string reason)
    {
        try
        {
            await QuoteService.ExecutiveRejectAsync(quote.Id, userId, reason);
            Toast.ShowInfo($"{quote.QuoteNumber} rejected.");
            CloseQuoteReview();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task OpenRequisitionReviewAsync(StockRequisition req)
    {
        CloseAllReviews();
        _reviewReq = await RequisitionService.GetByIdAsync(req.Id) ?? req;
        _reviewNote = "";
    }

    private void CloseRequisitionReview()
    {
        _reviewReq = null;
        _reviewNote = "";
    }

    private async Task SaveReviewRequisitionLinesAsync()
    {
        if (_reviewReq == null) return;
        try
        {
            foreach (var line in _reviewReq.Lines.Where(l => !l.IsDeleted))
                await RequisitionService.UpdatePendingLineQuantityAsync(line.Id, line.QuantityRequested);
            Toast.ShowSuccess("Quantities updated.");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task ApproveReviewedRequisitionAsync()
    {
        if (_reviewReq == null || CurrentUser.UserId is not { } userId) return;
        try
        {
            foreach (var line in _reviewReq.Lines.Where(l => !l.IsDeleted))
                await RequisitionService.UpdatePendingLineQuantityAsync(line.Id, line.QuantityRequested);

            var wasManager = _reviewReq.Status == RequisitionStatus.PendingManager;
            var approved = _reviewReq.Status switch
            {
                RequisitionStatus.PendingManager => await RequisitionService.ApproveManagerAsync(_reviewReq.Id, userId, _reviewNote),
                RequisitionStatus.PendingExecutive => await RequisitionService.ApproveExecutiveAsync(_reviewReq.Id, userId, _reviewNote),
                _ => false
            };

            if (!approved)
            {
                Toast.ShowError("Requisition is no longer pending at this approval stage.");
                CloseRequisitionReview();
                await LoadAsync();
                return;
            }

            Toast.ShowSuccess(wasManager
                ? $"{_reviewReq.RequisitionNumber} advanced to executive approval."
                : $"{_reviewReq.RequisitionNumber} approved — stock reserved for issue.");
            CloseRequisitionReview();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private Task RejectReviewedRequisitionAsync()
    {
        if (_reviewReq == null || CurrentUser.UserId is not { } userId) return Task.CompletedTask;
        var note = _reviewNote;
        if (string.IsNullOrWhiteSpace(note))
        {
            Toast.ShowError("Add a note so the requester knows why it was rejected.");
            return Task.CompletedTask;
        }

        var req = _reviewReq;
        return RejectCoreAsync(
            () => RequisitionService.RejectAsync(req.Id, userId, note),
            $"{req.RequisitionNumber} rejected.",
            CloseRequisitionReview);
    }

