    private static string LeaveEmployeeName(LeaveRequest request) =>
        request.Employee != null
            ? $"{request.Employee.FirstName} {request.Employee.LastName}"
            : "Employee";

    private void RecalcLeaveDays()
    {
        if (_reviewLeave == null) return;
        var days = (_reviewLeave.EndDate.Date - _reviewLeave.StartDate.Date).TotalDays + 1;
        _reviewLeave.DaysRequested = days < 0.5 ? 0.5m : (decimal)days;
    }

    private async Task SaveReviewLeaveAsync()
    {
        if (_reviewLeave == null) return;
        try
        {
            RecalcLeaveDays();
            await LeaveService.UpdatePendingAsync(_reviewLeave);
            Toast.ShowSuccess("Leave request updated.");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task ApproveReviewedLeaveAsync()
    {
        if (_reviewLeave == null || CurrentUser.UserId is not { } userId) return;
        try
        {
            RecalcLeaveDays();
            await LeaveService.UpdatePendingAsync(_reviewLeave);

            var approved = _reviewLeave.Status switch
            {
                LeaveRequestStatus.PendingManager => await LeaveService.ApproveManagerAsync(_reviewLeave.Id, userId, _reviewNote),
                LeaveRequestStatus.PendingExecutive => await LeaveService.ApproveExecutiveAsync(_reviewLeave.Id, userId, _reviewNote),
                LeaveRequestStatus.PendingHr => await LeaveService.ApproveHrAsync(_reviewLeave.Id, userId, _reviewNote),
                _ => false
            };

            if (!approved)
            {
                Toast.ShowError("Leave request is no longer pending at this approval stage.");
                CloseLeaveReview();
                await LoadAsync();
                return;
            }

            Toast.ShowSuccess("Leave request advanced in the approval chain.");
            CloseLeaveReview();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private Task RejectReviewedLeaveAsync()
    {
        if (_reviewLeave == null || CurrentUser.UserId is not { } userId) return Task.CompletedTask;
        var note = _reviewNote;
        if (string.IsNullOrWhiteSpace(note))
        {
            Toast.ShowError("Add a note so the requester knows why it was rejected.");
            return Task.CompletedTask;
        }

        var request = _reviewLeave;
        return RejectCoreAsync(
            () => LeaveService.RejectAsync(request.Id, userId, note),
            "Leave request rejected.",
            CloseLeaveReview);
    }

