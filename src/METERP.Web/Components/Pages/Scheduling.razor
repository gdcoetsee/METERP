@page "/scheduling"
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Domain
@using METERP.Common
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@attribute [Authorize(Policy = "Jobs.Manage")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ISchedulingService SchedulingService
@inject IRecurringJobService RecurringJobService
@inject ICustomerService CustomerService
@inject ICurrentUserService CurrentUserService
@inject IAiAssistantService AiAssistantService
@inject NavigationManager Nav
@inject ToastService ToastService
@implements IDisposable

<PageTitle>Scheduling</PageTitle>

<PageHeader Title="Scheduling" Subtitle="Plan the week or month. Click a job to assign crew, or drag it to another day." TestId="scheduling-shell">
    <Actions>
        <ExportToolbar TestId="scheduling-export" ShowPdf="false" ShowExcel="false" OnExportCsv="ExportScheduleCsvAsync" Disabled="@_loading" />
        <button class="btn btn-outline-primary" data-testid="scheduling-ai-risk" @onclick="RunLowStockRiskForScheduled">Low-stock risk</button>
        <button class="btn btn-primary" data-testid="scheduling-ai-suggest" @onclick="SuggestAssignmentsWithAI">AI suggest assignments</button>
    </Actions>
</PageHeader>

@if (!_loading)
{
    <div class="card mb-3" data-testid="scheduling-recurring">
        <div class="card-header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Recurring jobs</span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-primary" @onclick="OpenCreateRecurring"
                        data-testid="scheduling-recurring-create">Add schedule</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="ProcessRecurringAsync" data-testid="scheduling-process-recurring">Spawn due jobs</button>
            </div>
        </div>
        @if (_recurringSchedules.Count == 0)
        {
            <div class="card-body small text-muted py-2">No active recurring schedules. Add maintenance/SLA templates to auto-spawn jobs.</div>
        }
        else
        {
            <ul class="list-group list-group-flush small">
                @foreach (var s in _recurringSchedules)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span><strong>@s.Title</strong> — @(s.Customer?.Name ?? "Customer") every @s.IntervalDays d · R @s.DefaultQuotedTotal.ToString("N0")</span>
                        <span class="text-nowrap">
                            <span class="text-muted me-2">Next: @s.NextRunDate.ToString("yyyy-MM-dd")</span>
                            <button type="button" class="btn btn-outline-secondary btn-sm py-0"
                                    data-testid="scheduling-recurring-deactivate"
                                    @onclick="() => DeactivateRecurringAsync(s.Id)">Deactivate</button>
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
}

@if (_showRecurringModal)
{
    <FormModal IsOpen="true"
               Title="New recurring job schedule"
               Size="md"
               TestId="scheduling-recurring-modal"
               CloseOnBackdrop="false"
               OnClose="CloseCreateRecurring">
        <ChildContent>
            <div class="mb-2">
                <label class="form-label meterp-required" for="recurring-title">Title</label>
                <input id="recurring-title" class="form-control" data-testid="scheduling-recurring-title" @bind="_newRecurringTitle" @bind:event="oninput" />
            </div>
            <div class="mb-2">
                <label class="form-label meterp-required" for="recurring-customer">Customer</label>
                <EntityPicker TestId="scheduling-recurring-customer"
                              Value="_newRecurringCustomerId"
                              ValueChanged="OnRecurringCustomerPicked"
                              Options="RecurringCustomerOptions"
                              SelectedLabel="@RecurringCustomerName"
                              Placeholder="Type a company name"
                              Required="true"
                              OnSearch="SearchRecurringCustomersAsync" />
            </div>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label" for="recurring-interval">Interval (days)</label>
                    <input id="recurring-interval" type="number" min="1" class="form-control"
                           data-testid="scheduling-recurring-interval" @bind="_newRecurringInterval" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="recurring-next">Next run</label>
                    <input id="recurring-next" type="date" class="form-control"
                           data-testid="scheduling-recurring-next" @bind="_newRecurringNext" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="recurring-quote">Quoted total (R)</label>
                    <input id="recurring-quote" type="number" min="0" step="0.01" class="form-control"
                           data-testid="scheduling-recurring-quoted" @bind="_newRecurringQuoted" />
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreateRecurring">Cancel</button>
            <button type="button" class="btn btn-primary" data-testid="scheduling-recurring-save"
                    disabled="@_recurringBusy" @onclick="SaveRecurringAsync">Save schedule</button>
        </Footer>
    </FormModal>
}

<div class="meterp-cal-shell" data-testid="scheduling-calendar">
    <div class="meterp-cal-toolbar">
        <div class="btn-group" role="group" aria-label="Calendar range">
            <button type="button" class="btn btn-sm @(_view == CalendarView.Day ? "btn-primary" : "btn-outline-secondary")"
                    data-testid="scheduling-view-day" @onclick="() => SetViewAsync(CalendarView.Day)">Day</button>
            <button type="button" class="btn btn-sm @(_view == CalendarView.Week ? "btn-primary" : "btn-outline-secondary")"
                    data-testid="scheduling-view-week" @onclick="() => SetViewAsync(CalendarView.Week)">Week</button>
            <button type="button" class="btn btn-sm @(_view == CalendarView.Month ? "btn-primary" : "btn-outline-secondary")"
                    data-testid="scheduling-view-month" @onclick="() => SetViewAsync(CalendarView.Month)">Month</button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="scheduling-prev" @onclick="PreviousRangeAsync">←</button>
        <span class="meterp-cal-range" data-testid="scheduling-range-label">@RangeLabel</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="scheduling-next" @onclick="NextRangeAsync">→</button>
        <button type="button" class="btn btn-sm btn-outline-primary" data-testid="scheduling-today" @onclick="GoTodayAsync">Today</button>
        @if (_calendarBusy)
        {
            <span class="spinner-border spinner-border-sm text-secondary" role="status"></span>
        }
        <span class="small ms-auto"><span class="meterp-cal-job needs-crew d-inline-block px-2 py-0 mb-0">Needs crew</span></span>
    </div>

    <div class="small text-muted mb-1">Unscheduled — drag onto a day</div>
    <div class="meterp-cal-unscheduled" data-day="" data-testid="scheduling-unscheduled">
        @foreach (var job in UnscheduledJobs)
        {
            <div @key="job.Id"
                 class="meterp-cal-job @(NeedsCrew(job) ? "needs-crew" : "")"
                 draggable="true"
                 data-job-id="@job.Id"
                 data-testid="scheduling-view-assign"
                 @onclick="() => OnJobCardClick(job)">
                <strong>@job.JobNumber</strong>
                <div>@job.Title</div>
                <div class="text-muted">@(job.Customer?.Name ?? "—")</div>
                @if (NeedsCrew(job))
                {
                    <div class="meterp-cal-job-flag">Needs crew</div>
                }
            </div>
        }
        @if (!UnscheduledJobs.Any())
        {
            <span class="small text-muted">All open jobs have a date</span>
        }
    </div>

    @if (_view != CalendarView.Day)
    {
        <div class="meterp-cal-weekdays">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
    }

    <div class="meterp-cal @(_view == CalendarView.Month ? "is-month" : _view == CalendarView.Day ? "is-day" : "is-week")">
        @foreach (var date in CalendarDays)
        {
            var dayJobs = _calendarJobs.Where(j => j.ScheduledStart?.Date == date.Date).ToList();
            var outside = _view == CalendarView.Month && date.Month != _anchor.Month;
            var today = date.Date == DateTime.UtcNow.Date;
            <div @key="date"
                 class="meterp-cal-day @(today ? "is-today" : "") @(outside ? "is-outside" : "")"
                 data-day="@date.ToString("yyyy-MM-dd")"
                 data-testid="scheduling-day">
                <div class="small fw-bold mb-1">@(_view == CalendarView.Month ? date.ToString("d") : date.ToString("ddd d MMM"))</div>
                @foreach (var cj in dayJobs)
                {
                    <div @key="cj.Id"
                         class="meterp-cal-job @(NeedsCrew(cj) ? "needs-crew" : "")"
                         draggable="true"
                         data-job-id="@cj.Id"
                         data-testid="scheduling-view-assign"
                         @onclick="() => OnJobCardClick(cj)">
                        <strong>@cj.JobNumber</strong>
                        <div>@cj.Title</div>
                        <div class="text-muted">@JobCardMeta(cj)</div>
                        @if (NeedsCrew(cj))
                        {
                            <div class="meterp-cal-job-flag">Needs crew</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_loading)
{
    <ListSkeleton Rows="6" TestId="scheduling-loading" AriaLabel="Loading schedule" />
}
else if (jobs == null || !jobs.Any())
{
    <div class="alert alert-info" data-testid="scheduling-empty">No scheduled jobs.</div>
}
else
{
    <div class="table-responsive" data-testid="scheduling-ready">
        <table class="table table-hover" data-testid="scheduling-table">
            <thead>
                <tr>
                    <th>Job #</th>
                    <th>Title / Customer</th>
                    <th>Scheduled</th>
                    <th>Status</th>
                    <th>Assigned</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in VisibleJobs)
                {
                    <tr @key="job.Id"
                        class="meterp-row-click @(_movedJobId == job.Id ? "table-success" : "")"
                        data-testid="scheduling-row"
                        title="Open job"
                        @onclick="() => ViewJobAsync(job)">
                        <td>@job.JobNumber</td>
                        <td>@job.Title<br /><small>@(job.Customer?.Name)</small></td>
                        <td data-testid="scheduling-row-date">@(job.ScheduledStart?.ToString("dd MMM yyyy") ?? "TBD")</td>
                        <td data-testid="scheduling-row-status">@((MarkupString)GetStatusBadge(job))</td>
                        <td data-testid="scheduling-assigned-cell">
                            @if (job.Asset != null) { <span class="badge bg-info" data-testid="scheduling-assigned-asset">@job.Asset.Name</span><br /> }
                            @if (NeedsCrew(job))
                            {
                                <span class="badge bg-warning text-dark" data-testid="scheduling-needs-crew">Needs crew</span>
                            }
                            else if (job.AssignedEmployee != null)
                            {
                                <span class="badge bg-success" data-testid="scheduling-assigned-employee">@job.AssignedEmployee.FirstName @job.AssignedEmployee.LastName (lead)</span>
                            }
                            @foreach (var crew in job.GetCrewEmployees().Where(e => e.Id != job.AssignedEmployeeId))
                            {
                                <br /><span class="badge bg-secondary" data-testid="scheduling-crew-badge">@crew.FirstName @crew.LastName</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (selectedJob != null)
{
    <FormModal IsOpen="true"
               Title="@($"{selectedJob.JobNumber} — {selectedJob.Title}")"
               Size="xl"
               TestId="scheduling-assign-panel"
               CloseOnBackdrop="false"
               OnClose="CloseAssign">
        <ChildContent>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Plant / asset <span class="text-muted fw-normal">(optional)</span></label>
                    <EntityPicker TestId="scheduling-asset-select"
                                  Value="@(assignAssetId ?? Guid.Empty)"
                                  ValueChanged="OnAssignAsset"
                                  Options="AssetPickerOptions"
                                  SelectedLabel="@AssignedAssetName"
                                  Placeholder="Type an asset name"
                                  OnSearch="SearchAssetsAsync" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Lead employee <span class="text-muted fw-normal">(optional)</span></label>
                    <EntityPicker TestId="scheduling-employee-select"
                                  Value="@(assignEmployeeId ?? Guid.Empty)"
                                  ValueChanged="OnAssignEmployee"
                                  Options="EmployeePickerOptions"
                                  SelectedLabel="@AssignedEmployeeName"
                                  Placeholder="Type a name"
                                  OnSearch="SearchEmployeesAsync" />
                </div>
            </div>
            <div class="mt-3" data-testid="scheduling-crew-panel">
                <label class="form-label">Additional crew</label>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var e in availableEmployees)
                    {
                        var crewChecked = assignCrewEmployeeIds.Contains(e.Id);
                        <label class="form-check form-check-inline mb-0">
                            <input type="checkbox"
                                   class="form-check-input"
                                   data-testid="scheduling-crew-checkbox"
                                   checked="@crewChecked"
                                   @onchange="(ChangeEventArgs args) => ToggleCrewMember(e.Id, args.Value is bool b && b)" />
                            @e.FirstName @e.LastName
                        </label>
                    }
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-4">
                    <label class="form-label">Scheduled start</label>
                    <input type="date" class="form-control" data-testid="scheduling-date-input" @bind="assignScheduledDate" />
                </div>
            </div>
            <hr class="my-3" />
            <div data-testid="scheduling-quick-labor-panel">
                <h6 class="mb-2">Quick-add labor (assigned crew)</h6>
                @if (GetCrewForQuickLabor().Any())
                {
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Hours</label>
                            <input type="number" class="form-control" min="0.25" step="0.25" data-testid="scheduling-labor-hours" @bind="laborHours" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Work date</label>
                            <input type="date" class="form-control" data-testid="scheduling-labor-date" @bind="laborWorkDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Crew to log</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var e in GetCrewForQuickLabor())
                                {
                                    var laborChecked = laborCrewEmployeeIds.Contains(e.Id);
                                    <label class="form-check form-check-inline mb-0">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               data-testid="scheduling-labor-crew-checkbox"
                                               checked="@laborChecked"
                                               @onchange="(ChangeEventArgs args) => ToggleLaborCrewMember(e.Id, args.Value is bool b && b)" />
                                        @e.FirstName @e.LastName
                                    </label>
                                }
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-outline-success mt-2" data-testid="scheduling-quick-add-labor" @onclick="QuickAddCrewLabor">Log crew hours</button>
                }
                else
                {
                    <p class="text-muted small mb-0">Save crew assignments above to enable one-click JobLabor entry (links to payroll &amp; utilization).</p>
                }
            </div>
        </ChildContent>
        <Footer>
            <a class="btn btn-outline-primary me-auto" href="@($"/jobs/{selectedJob.Id:D}")">Command center</a>
            <button class="btn btn-outline-secondary" data-testid="scheduling-close-assign" @onclick="CloseAssign">Close</button>
            <button class="btn btn-primary" data-testid="scheduling-save-assignments" @onclick="AssignResources">Save assignments</button>
        </Footer>
    </FormModal>
}

@code {
    private List<Job> jobs = new();
    private List<Asset> availableAssets = new();
    private List<Employee> availableEmployees = new();
    private Job? selectedJob;
    private Guid? assignAssetId;
    private Guid? assignEmployeeId;
    private HashSet<Guid> assignCrewEmployeeIds = new();
    private decimal laborHours = 8m;
    private DateTime laborWorkDate = DateTime.UtcNow.Date;
    private HashSet<Guid> laborCrewEmployeeIds = new();
    private bool _loading = true;
    private bool _calendarBusy;
    private bool _suppressClick;
    private Guid? _movedJobId;
    private DateTime _weekStart;
    private DateTime _anchor;
    private CalendarView _view = CalendarView.Week;
    private List<Job> _calendarJobs = new();
    private DotNetObjectReference<Scheduling>? _schedRef;

    private enum CalendarView { Day, Week, Month }

    private DateTime RangeStart => _view switch
    {
        CalendarView.Day => _anchor.Date,
        CalendarView.Week => StartOfWeek(_anchor),
        _ => StartOfWeek(new DateTime(_anchor.Year, _anchor.Month, 1, 0, 0, 0, DateTimeKind.Utc))
    };

    private int RangeDays => _view switch
    {
        CalendarView.Day => 1,
        CalendarView.Week => 7,
        _ => 42
    };

    private string RangeLabel => _view switch
    {
        CalendarView.Day => _anchor.ToString("dddd d MMM yyyy"),
        CalendarView.Week => $"{RangeStart:d MMM} – {RangeStart.AddDays(6):d MMM yyyy}",
        _ => _anchor.ToString("MMMM yyyy")
    };

    private List<DateTime> CalendarDays
    {
        get
        {
            var list = new List<DateTime>(RangeDays);
            var start = RangeStart;
            for (var i = 0; i < RangeDays; i++)
                list.Add(start.AddDays(i));
            return list;
        }
    }

    private IEnumerable<Job> UnscheduledJobs =>
        jobs.Where(j => !j.ScheduledStart.HasValue
                        && j.Status is JobStatus.Scheduled or JobStatus.InProgress or JobStatus.OnHold);

    private IEnumerable<Job> VisibleJobs =>
        jobs.Where(j =>
                !j.ScheduledStart.HasValue
                || (j.ScheduledStart.Value.Date >= RangeStart
                    && j.ScheduledStart.Value.Date < RangeStart.AddDays(RangeDays)))
            .OrderBy(j => j.ScheduledStart ?? DateTime.MaxValue);

    private static bool NeedsCrew(Job job) =>
        (job.AssignedEmployeeId == null || job.AssignedEmployeeId == Guid.Empty)
        && !job.GetCrewEmployees().Any();

    private static string JobCardMeta(Job job)
    {
        if (NeedsCrew(job))
            return job.Customer?.Name ?? "—";
        if (job.AssignedEmployee != null)
            return $"{job.AssignedEmployee.FirstName} {job.AssignedEmployee.LastName}";
        var crew = job.GetCrewEmployees().FirstOrDefault();
        return crew == null ? (job.Customer?.Name ?? "—") : $"{crew.FirstName} {crew.LastName}";
    }
    private List<RecurringJobSchedule> _recurringSchedules = new();
    private List<Customer> _customers = new();
    private List<Customer> _customerPickerSource = new();
    private List<Asset> _assetPickerSource = new();
    private List<Employee> _employeePickerSource = new();
    private DateTime? assignScheduledDate;

    private IReadOnlyList<EntityPickerOption> RecurringCustomerOptions =>
        _customerPickerSource.Select(c => new EntityPickerOption { Id = c.Id, Label = c.Name }).ToList();
    private string? RecurringCustomerName =>
        _customerPickerSource.FirstOrDefault(c => c.Id == _newRecurringCustomerId)?.Name
        ?? _customers.FirstOrDefault(c => c.Id == _newRecurringCustomerId)?.Name;

    private IReadOnlyList<EntityPickerOption> AssetPickerOptions =>
        _assetPickerSource.Select(a => new EntityPickerOption { Id = a.Id, Label = a.Name }).ToList();
    private string? AssignedAssetName =>
        availableAssets.FirstOrDefault(a => a.Id == assignAssetId)?.Name;

    private IReadOnlyList<EntityPickerOption> EmployeePickerOptions =>
        _employeePickerSource.Select(e => new EntityPickerOption { Id = e.Id, Label = $"{e.FirstName} {e.LastName}" }).ToList();
    private string? AssignedEmployeeName
    {
        get
        {
            var e = availableEmployees.FirstOrDefault(x => x.Id == assignEmployeeId);
            return e == null ? null : $"{e.FirstName} {e.LastName}";
        }
    }

    private Task OnRecurringCustomerPicked(Guid id)
    {
        _newRecurringCustomerId = id;
        return Task.CompletedTask;
    }

    private async Task SearchRecurringCustomersAsync(string term)
    {
        _customerPickerSource = (await CustomerService.GetAllAsync(
                string.IsNullOrWhiteSpace(term) ? null : term.Trim(), 1, 50)).ToList();
    }

    private Task OnAssignAsset(Guid id)
    {
        assignAssetId = id == Guid.Empty ? null : id;
        return Task.CompletedTask;
    }

    private Task OnAssignEmployee(Guid id)
    {
        assignEmployeeId = id == Guid.Empty ? null : id;
        return Task.CompletedTask;
    }

    private Task SearchAssetsAsync(string term)
    {
        _assetPickerSource = string.IsNullOrWhiteSpace(term)
            ? availableAssets
            : availableAssets.Where(a => a.Name.Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.CompletedTask;
    }

    private Task SearchEmployeesAsync(string term)
    {
        _employeePickerSource = string.IsNullOrWhiteSpace(term)
            ? availableEmployees
            : availableEmployees.Where(e =>
                    $"{e.FirstName} {e.LastName}".Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
        return Task.CompletedTask;
    }

    private bool _showRecurringModal;
    private bool _recurringBusy;
    private string _newRecurringTitle = "";
    private Guid _newRecurringCustomerId = Guid.Empty;
    private int _newRecurringInterval = 30;
    private DateTime _newRecurringNext = DateTime.UtcNow.Date;
    private decimal _newRecurringQuoted;

    protected override async Task OnInitializedAsync()
    {
        _anchor = DateTime.UtcNow.Date;
        _weekStart = RangeStart;
        await LoadBoardAsync();
        TryOpenAssignFromQuery();
    }

    private void TryOpenAssignFromQuery()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("assign", out var assignVal) || !Guid.TryParse(assignVal, out var jobId) || jobId == Guid.Empty)
            return;
        var job = jobs.FirstOrDefault(j => j.Id == jobId) ?? jobs.FirstOrDefault();
        if (job != null)
            ViewJob(job);
    }

    private static DateTime StartOfWeek(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff);
    }

    private async Task LoadBoardAsync()
    {
        _loading = true;
        try
        {
            var board = await SchedulingService.GetBoardAsync();
            jobs = board.Jobs.ToList();
            availableAssets = board.Assets.ToList();
            availableEmployees = board.Employees.ToList();
            _weekStart = RangeStart;
            _calendarJobs = (await SchedulingService.GetCalendarJobsAsync(RangeStart, RangeDays)).ToList();
            _recurringSchedules = (await RecurringJobService.GetAllAsync()).ToList();
            _customers = (await CustomerService.GetAllAsync(pageSize: 200)).ToList();
            _customerPickerSource = _customers;
            _assetPickerSource = availableAssets;
            _employeePickerSource = availableEmployees;
        }
        catch (TimeoutException)
        {
            // Circuit DB gate timed out; show the board shell instead of hanging the page.
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateRecurring()
    {
        _newRecurringTitle = "";
        _newRecurringCustomerId = _customers.FirstOrDefault()?.Id ?? Guid.Empty;
        _newRecurringInterval = 30;
        _newRecurringNext = DateTime.UtcNow.Date;
        _newRecurringQuoted = 0;
        _showRecurringModal = true;
    }

    private void CloseCreateRecurring()
    {
        _showRecurringModal = false;
        _recurringBusy = false;
    }

    private async Task SaveRecurringAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRecurringTitle))
        {
            ToastService.ShowError("Title is required.");
            return;
        }
        if (_newRecurringCustomerId == Guid.Empty)
        {
            ToastService.ShowError("Customer is required.");
            return;
        }
        if (_newRecurringInterval < 1)
        {
            ToastService.ShowError("Interval must be at least 1 day.");
            return;
        }

        _recurringBusy = true;
        try
        {
            await RecurringJobService.CreateAsync(new RecurringJobSchedule
            {
                Title = _newRecurringTitle.Trim(),
                CustomerId = _newRecurringCustomerId,
                IntervalDays = _newRecurringInterval,
                NextRunDate = _newRecurringNext.Date,
                DefaultQuotedTotal = _newRecurringQuoted,
                IsActive = true
            });
            ToastService.ShowSuccess("Recurring schedule created.");
            CloseCreateRecurring();
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _recurringBusy = false;
        }
    }

    private async Task LoadCalendarAsync()
    {
        _calendarBusy = true;
        try
        {
            _weekStart = RangeStart;
            _calendarJobs = (await SchedulingService.GetCalendarJobsAsync(RangeStart, RangeDays)).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            _calendarBusy = false;
        }
    }

    private async Task SetViewAsync(CalendarView view)
    {
        _view = view;
        _weekStart = RangeStart;
        await LoadCalendarAsync();
    }

    private async Task PreviousRangeAsync()
    {
        _anchor = _view switch
        {
            CalendarView.Day => _anchor.AddDays(-1),
            CalendarView.Week => _anchor.AddDays(-7),
            _ => _anchor.AddMonths(-1)
        };
        _weekStart = RangeStart;
        await LoadCalendarAsync();
    }

    private async Task NextRangeAsync()
    {
        _anchor = _view switch
        {
            CalendarView.Day => _anchor.AddDays(1),
            CalendarView.Week => _anchor.AddDays(7),
            _ => _anchor.AddMonths(1)
        };
        _weekStart = RangeStart;
        await LoadCalendarAsync();
    }

    private async Task GoTodayAsync()
    {
        _anchor = DateTime.UtcNow.Date;
        _weekStart = RangeStart;
        await LoadCalendarAsync();
    }

    private void OnJobCardClick(Job job)
    {
        if (_suppressClick)
        {
            _suppressClick = false;
            return;
        }
        ViewJob(job);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading) return;
        _schedRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("meterpUi.bindSchedule", "[data-testid='scheduling-calendar']", _schedRef);
        }
