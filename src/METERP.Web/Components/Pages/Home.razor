@if (_work != null)
{
    <FormModal IsOpen="true"
               Title="@_work.Title"
               Size="lg"
               TestId="home-work-review"
               CloseOnBackdrop="true"
               OnClose="CloseWork">
        <ChildContent>
            <p class="small text-muted mb-2">@_work.Eyebrow</p>
            @if (!string.IsNullOrWhiteSpace(_work.Customer))
            {
                <p class="mb-1"><strong>@_work.Customer</strong></p>
            }
            @if (_work.Amount is { } amount)
            {
                <p class="mb-2 fs-5 text-success">R @amount.ToString("N0")</p>
            }
            <p class="mb-0">@_work.Body</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseWork">Close</button>
            @if (!string.IsNullOrWhiteSpace(_work.Href))
            {
                <a class="btn btn-outline-primary" href="@_work.Href">Open full record</a>
            }
            @if (_work.SecondaryAct != null && !string.IsNullOrWhiteSpace(_work.SecondaryTestId))
            {
                <button type="button" class="btn @_work.SecondaryClass"
                        data-testid="@_work.SecondaryTestId"
                        disabled="@_work.Busy"
                        @onclick="RunSecondaryAsync">
                    @_work.SecondaryLabel
                </button>
            }
            @if (_work.CanAct && _work.Act != null)
            {
                <button type="button" class="btn @_work.ActionClass"
                        data-testid="@_work.ActionTestId"
                        disabled="@_work.Busy"
                        @onclick="RunPrimaryAsync">
                    @_work.ActionLabel
                </button>
            }
            else if (!string.IsNullOrWhiteSpace(_work.Href))
            {
                <a class="btn @_work.ActionClass" href="@_work.Href" data-testid="@_work.ActionTestId">@_work.ActionLabel</a>
            }
        </Footer>
    </FormModal>
}

