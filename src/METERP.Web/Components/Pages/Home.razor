    private void OpenCashJob(ReadyToInvoiceJobRow row)
    {
        var isDeposit = string.Equals(row.Reason, "Deposit", StringComparison.OrdinalIgnoreCase);
        var isSignOff = string.Equals(row.Reason, "Sign-off", StringComparison.OrdinalIgnoreCase);
        var href = isSignOff
            ? $"/jobs/{row.JobId:D}?signoff=1"
            : $"/jobs/{row.JobId:D}?invoice={(isDeposit ? "deposit" : "1")}";
        var label = isDeposit ? "Raise deposit" : isSignOff ? "Sign off" : "Invoice";
        var testId = isDeposit ? "home-deposit-invoice" : isSignOff ? "home-signoff-invoice" : "home-ready-invoice";
        var canAct = isSignOff ? CanManageJobs : CanChaseInvoices;
        _work = new HomeWorkItem
        {
            Title = $"{row.JobNumber} — {row.Title}",
            Eyebrow = row.Reason,
            Customer = row.CustomerName,
            Amount = row.UnbilledResidual,
            Body = $"Quoted R {row.QuotedTotal:N0} · billed R {row.BilledToDate:N0}. {row.Reason} is waiting.",
            ActionLabel = canAct ? label : "Open job",
            ActionTestId = testId,
            ActionClass = isSignOff ? "btn-warning" : "btn-success",
            CanAct = canAct,
            Href = href,
            Act = canAct ? () => ActOnCashQueueAsync(row) : null
        };
