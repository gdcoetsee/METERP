@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Domain
@using METERP.Common
@inject IQuoteService QuoteService
@inject ISalesOrderService SalesOrderService
@inject IJobService JobService
@inject IInvoiceService InvoiceService
@inject IUserService UserService
@inject IInventoryService InventoryService
@inject IPurchaseOrderService PurchaseOrderService
@inject IPpeIssueService PpeIssueService
@inject IStockRequisitionService RequisitionService
@inject ILeaveService LeaveService
@inject IFieldReportService FieldReportService
@inject ICurrentUserService CurrentUserService
@inject ITenantService TenantService
@inject IBillingPortalService BillingPortalService
@inject IAiAssistantService AiAssistantService
@inject IExecutiveDashboardService ExecutiveDashboard
@inject IAccountabilityReportService AccountabilityReports
@inject IScheduledReportService ScheduledReports
@inject IJSRuntime JS
@inject ToastService Toast
@inject NavigationManager Nav

<PageTitle>METERP</PageTitle>

@if (_initialized)
{
    <span data-testid="home-ready" class="visually-hidden">ready</span>
}

<PageHeader Title="Home" Subtitle="What needs you today — quotes, jobs, cash, and approvals." TestId="home-page-header">
    <Actions>
        @if (AiAssistantService.IsConfigured)
        {
            <span class="badge bg-primary">AI enabled</span>
        }
        <a href="/quotes?create=1" class="btn btn-primary" data-testid="home-new-quote">New quote</a>
        <a href="/jobs" class="btn btn-outline-secondary">Jobs</a>
    </Actions>
</PageHeader>

@if (currentTenant != null && currentTenant.SubscriptionStatus is "past_due" or "unpaid")
{
    <div class="alert alert-warning mb-4" data-testid="home-billing-past-due-banner" role="alert">
        <strong>Subscription payment issue.</strong> Your <code>@currentTenant.SubscriptionStatus</code> status may limit premium features.
        @if (!string.IsNullOrWhiteSpace(billingPortalUrl))
        {
            <button type="button" class="btn btn-sm btn-warning ms-2" data-testid="home-billing-past-due-manage-button" @onclick="OpenBillingPortal">Update billing</button>
        }
        else
        {
            <span> Contact support to restore service.</span>
        }
    </div>
}

@if (_showRoleDashboard)
{
    <div class="row g-3 mb-4" data-testid="home-role-dashboard">
        @if (_isTechnician)
        {
            <div class="col-md-4">
                <div class="card h-100 border-info">
                    <div class="card-body">
                        <h6 class="text-info">Field Portal</h6>
                        <p class="small text-muted mb-2">Submit hours, travel, and stock requests from site.</p>
                        <a href="/field" class="btn btn-sm btn-outline-info">Open Field Portal</a>
                    </div>
                </div>
            </div>
        }
        @if (_isProcurement)
        {
            <div class="col-md-4">
                <div class="card h-100 border-warning">
                    <div class="card-body">
                        <h6 class="text-warning">Procurement queue</h6>
                        <p class="small mb-1">@_executive?.PendingRequisitions requisition(s) awaiting action</p>
                        <a href="/purchase-orders" class="btn btn-sm btn-outline-warning me-1">POs</a>
                        <a href="/requisitions" class="btn btn-sm btn-outline-secondary">Requisitions</a>
                    </div>
                </div>
            </div>
        }
        @if (_isHr)
        {
            <div class="col-md-4">
                <div class="card h-100 border-success">
                    <div class="card-body">
                        <h6 class="text-success">HR &amp; leave</h6>
                        <p class="small mb-1">@_executive?.PendingLeave leave request(s) in queue</p>
                        <a href="/employees" class="btn btn-sm btn-outline-success me-1">Employees</a>
                        <a href="/approvals" class="btn btn-sm btn-outline-secondary">Approvals</a>
                    </div>
                </div>
            </div>
        }
        @if (_isStores)
        {
            <div class="col-md-4">
                <div class="card h-100 border-secondary">
                    <div class="card-body">
                        <h6>Stores</h6>
                        <p class="small mb-1">@lowStockCount low-stock SKU(s) · @_executive?.PendingRequisitions pending requisition(s)</p>
                        <a href="/inventory" class="btn btn-sm btn-outline-secondary me-1">Inventory</a>
                        <a href="/stock-take" class="btn btn-sm btn-outline-secondary">Stock take</a>
                    </div>
                </div>
            </div>
        }
        @if (_isFinance)
        {
            <div class="col-md-4">
                <div class="card h-100 border-danger">
                    <div class="card-body">
                        <h6 class="text-danger">Finance</h6>
                        <p class="small mb-1">R @(_executive?.AgedDebtorsTotal.ToString("N0") ?? "0") outstanding · @_readyToInvoiceCount ready to invoice</p>
                        <a href="/invoices" class="btn btn-sm btn-outline-danger me-1">Invoices</a>
                        <a href="/finance" class="btn btn-sm btn-outline-secondary">Finance</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_showExecutiveView && _executive != null)
{
    <h2 class="h5 mb-3" data-testid="home-needs-you">Needs you</h2>
    <div class="card mb-4 border-primary" data-testid="home-executive-dashboard">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Executive accountability</span>
            <div>
                <button type="button" class="btn btn-sm btn-light me-1" @onclick="EmailExecutiveSummaryAsync" data-testid="home-email-executive-report">Email summary</button>
                <a href="/approvals" class="btn btn-sm btn-light">Approvals hub</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center">
                <div class="col-md-2">
                    <div class="fs-4 fw-bold text-warning">@_executive.PendingApprovals</div>
                    <div class="small text-muted">Pending approvals</div>
                </div>
                <div class="col-md-2">
                    <div class="fs-4 fw-bold text-danger" data-testid="home-overdue-sla-count">@_overdueApprovals.Count</div>
                    <div class="small text-muted">Overdue (SLA)</div>
                </div>
                <div class="col-md-2">
                    <div class="fs-4 fw-bold text-danger">@_executive.UnreadNotifications</div>
                    <div class="small text-muted"><a href="/notifications">Unread alerts</a></div>
                </div>
                <div class="col-md-2" data-testid="home-ready-to-invoice-card">
                    <div class="fs-4 fw-bold text-success">@_executive.ReadyToInvoiceJobs</div>
                    <div class="small text-muted">Ready to invoice</div>
                </div>
                <div class="col-md-3">
                    <div class="fs-5 fw-bold">R @_executive.ReadyToInvoiceValue.ToString("N0")</div>
                    <div class="small text-muted">Quoted value awaiting invoice</div>
                </div>
                <div class="col-md-3">
                    <div class="fs-5 fw-bold text-danger">R @_executive.AgedDebtorsTotal.ToString("N0")</div>
                    <div class="small text-muted">Outstanding receivables — chase below</div>
                </div>
            </div>
            <p class="small text-muted mb-0 mt-2">
                Click a row to review the work, then approve, send, convert, or invoice from the overlay.
                Queues: @_executive.PendingQuotes quotes · @_executive.PendingRequisitions stock · @_executive.PendingLeave leave · @_executive.PendingFieldReports field reports
                @if (_executive.LowStockItems > 0)
                {
                    <span> · <strong>@_executive.LowStockItems</strong> low-stock SKUs</span>
                }
            </p>
            @{
                var cashQueue = _executive.DepositDueQueue
                    .Concat(_executive.ReadyToInvoiceQueue
                        .Where(r => _executive.DepositDueQueue.All(d => d.JobId != r.JobId)))
                    .Concat(_executive.AwaitingSignOffQueue
                        .Where(r => _executive.DepositDueQueue.All(d => d.JobId != r.JobId)
                            && _executive.ReadyToInvoiceQueue.All(x => x.JobId != r.JobId)))
                    .Take(8)
                    .ToList();
            }
            @if (_executive.ApprovalQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-approvals-queue">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Waiting</th>
                                <th>On</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.ApprovalQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-approve-item"
                                    @onclick="() => OpenApproval(row)">
                                    <td>@row.Kind</td>
                                    <td>@row.Number</td>
                                    <td>@row.Subject</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.UnsentQuoteQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-unsent-quotes">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Approved quote</th>
                                <th>Customer</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.UnsentQuoteQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-send-quote"
                                    @onclick="() => OpenSendQuote(row)">
                                    <td>@row.Number</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">R @row.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.UnconfirmedSalesOrderQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-unconfirmed-orders">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Draft sales order</th>
                                <th>Customer</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.UnconfirmedSalesOrderQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-confirm-so"
                                    @onclick="() => OpenConfirmSalesOrder(row)">
                                    <td>@row.Number</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">R @row.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.ConvertToJobQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-convert-to-job">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Won work</th>
                                <th>Customer</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.ConvertToJobQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-convert-job"
                                    @onclick="() => OpenConvert(row)">
                                    <td>@row.Kind @row.Number</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">R @row.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.UnsentInvoiceQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-unsent-invoices">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Draft invoice</th>
                                <th>Customer</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.UnsentInvoiceQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-send-invoice"
                                    @onclick="() => OpenSendInvoice(row)">
                                    <td>@row.Number</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">R @row.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.OverdueInvoiceQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-overdue-invoices">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Overdue invoice</th>
                                <th>Customer</th>
                                <th class="text-end">Days</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.OverdueInvoiceQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-chase-invoice"
                                    @onclick="() => OpenOverdueInvoice(row)">
                                    <td>@row.InvoiceNumber</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">@row.DaysOverdue</td>
                                    <td class="text-end">R @row.BalanceDue.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.UnsentPurchaseOrderQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-unsent-pos">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Unsent PO</th>
                                <th>Supplier</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.UnsentPurchaseOrderQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-send-po"
                                    @onclick="() => OpenSendPo(row)">
                                    <td>@row.Number</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">R @row.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.OverduePurchaseOrderQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-overdue-pos">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Late PO</th>
                                <th>Supplier</th>
                                <th class="text-end">Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.OverduePurchaseOrderQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-overdue-po"
                                    @onclick="() => OpenReceivePo(row)">
                                    <td>@row.Number</td>
                                    <td>@row.CustomerName</td>
                                    <td class="text-end">R @row.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.OutstandingPpeQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-outstanding-ppe">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Outstanding PPE</th>
                                <th>Employee</th>
                                <th class="text-end">Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.OutstandingPpeQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-return-ppe"
                                    @onclick="() => OpenPpe(row)">
                                    <td>@row.ItemName</td>
                                    <td>@row.EmployeeName</td>
                                    <td class="text-end">@row.Outstanding.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.LowStockQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-low-stock">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Low stock</th>
                                <th class="text-end">On hand</th>
                                <th class="text-end">Reorder</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.LowStockQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-low-stock-item"
                                    @onclick="() => OpenLowStock(row)">
                                    <td>@row.Sku @row.Name</td>
                                    <td class="text-end">@row.OnHand.ToString("N2")</td>
                                    <td class="text-end">@row.ReorderLevel.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.ExpiringCompanyDocumentQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-expiring-docs">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Company document</th>
                                <th>Type</th>
                                <th class="text-end">Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.ExpiringCompanyDocumentQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-expiring-doc"
                                    @onclick="() => OpenExpiringDoc(row)">
                                    <td>@row.Title</td>
                                    <td>@row.DocumentType</td>
                                    <td class="text-end">@row.DaysRemaining</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (_executive.ExpiringCertificationQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-expiring-certs">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Employee</th>
                                <th class="text-end">Days</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _executive.ExpiringCertificationQueue)
                            {
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="home-expiring-cert"
                                    @onclick="() => OpenExpiringCert(row)">
                                    <td>@row.CertificationType</td>
                                    <td>@row.EmployeeName</td>
                                    <td class="text-end">@row.DaysRemaining</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (cashQueue.Count > 0)
            {
                <div class="table-responsive mt-3" data-testid="home-ready-to-invoice">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Job</th>
                                <th>Customer</th>
                                <th>Why</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cashQueue)
                            {
                                var isDeposit = string.Equals(row.Reason, "Deposit", StringComparison.OrdinalIgnoreCase);
                                var testId = isDeposit ? "home-deposit-invoice"
                                    : string.Equals(row.Reason, "Sign-off", StringComparison.OrdinalIgnoreCase) ? "home-signoff-invoice"
                                    : "home-ready-invoice";
                                <tr class="meterp-row-click" data-testid="home-queue-row" data-home-action="@testId"
                                    @onclick="() => OpenCashJob(row)">
                                    <td>@row.JobNumber — @row.Title</td>
                                    <td>@row.CustomerName</td>
                                    <td>@row.Reason</td>
                                    <td class="text-end">R @row.UnbilledResidual.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<div class="card mb-4" data-testid="home-todays-jobs">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Today's jobs</span>
        <a href="/jobs" class="btn btn-sm btn-outline-secondary">All jobs</a>
    </div>
    <div class="card-body p-0">
        @if (_todaysJobs.Count == 0)
        {
            <p class="small text-muted mb-0 p-3">No jobs in progress or due today.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Job</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>When</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _todaysJobs)
                        {
                            <tr class="meterp-row-click" data-testid="home-todays-job-row" @onclick="() => OpenTodaysJob(job)">
                                <td>@job.JobNumber — @job.Title</td>
                                <td>@(job.Customer?.Name ?? "—")</td>
                                <td>@job.Status</td>
                                <td>@(job.ScheduledStart?.ToString("dd MMM") ?? "Now")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_showExecutiveView && _userActivity.Count > 0)
{
    <div class="card mb-4" data-testid="home-user-activity">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>User activity (30 days)</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ExportUserActivityAsync">Export CSV</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th class="text-end">Actions</th>
                            <th class="text-end">Approvals</th>
                            <th class="text-end">Last active</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _userActivity.Take(8))
                        {
                            <tr>
                                <td>@row.UserEmail</td>
                                <td class="text-end">@row.TotalActions</td>
                                <td class="text-end">@row.ApprovalActions</td>
                                <td class="text-end text-muted small">@(row.LastActivityUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (_showExecutiveView && _divisionScorecards.Count > 0)
{
    <div class="card mb-4" data-testid="home-division-scorecards">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Division scorecards</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ExportDivisionScorecardsAsync">Export CSV</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Division</th>
                            <th class="text-end">Active jobs</th>
                            <th class="text-end">Avg %</th>
                            <th class="text-end">Ready to invoice</th>
                            <th class="text-end">Invoiced R</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _divisionScorecards)
                        {
                            <tr>
                                <td><strong>@row.DivisionName</strong> <span class="text-muted small">@row.DivisionCode</span></td>
                                <td class="text-end">@row.ActiveJobs</td>
                                <td class="text-end">@row.AvgProgressPercent%</td>
                                <td class="text-end">@row.ReadyToInvoiceCount <span class="text-muted small">(R @row.ReadyToInvoiceValue.ToString("N0"))</span></td>
                                <td class="text-end">R @row.InvoicedRevenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (currentTenant != null)
{
