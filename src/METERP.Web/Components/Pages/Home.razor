            Body = $"Scheduled {(job.ScheduledStart?.ToString("dd MMM") ?? "unscheduled")}. Assigned {(job.AssignedEmployee == null ? "—" : $"{job.AssignedEmployee.FirstName} {job.AssignedEmployee.LastName}")}.",
            ActionLabel = "Open command center",
            ActionTestId = "home-todays-job-open",
            ActionClass = "btn-primary",
            CanAct = false,
