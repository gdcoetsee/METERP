            CloseWork();
        }
        catch
        {
            if (_work != null) _work.Busy = false;
            throw;
        }
    }

    private async Task RunSecondaryAsync()
    {
        if (_work?.SecondaryAct == null) return;
        _work.Busy = true;
        try
        {
            await _work.SecondaryAct.Invoke();
            CloseWork();
        }
        catch
        {
            if (_work != null) _work.Busy = false;
            throw;
        }
