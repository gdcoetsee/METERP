    private async Task ReceiveOverduePurchaseOrderAsync(ConvertibleDocumentRow row)
    {
        if (_receivingPoId is not null)
            return;
        if (CurrentUserService.UserId is not { } userId)
        {
            Toast.ShowError("Sign in again to receive a purchase order.");
            return;
        }

        _receivingPoId = row.Id;
        try
        {
            var grv = await PurchaseOrderService.ReceiveAsync(row.Id, userId);
            if (grv == null)
                throw new InvalidOperationException($"{row.Number} is not open for receive.");
            Toast.ShowSuccess($"Received {row.Number} as {grv.GrvNumber}.");
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _receivingPoId = null;
        }
    }

