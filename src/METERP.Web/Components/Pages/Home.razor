<p class="mt-4 text-muted small">
    METERP — Clean Architecture • .NET 9 • Blazor Server • PostgreSQL • Multi-tenant from day one • Claim-based permissions.
    <br />Full flow demo: Quote (inventory-backed lines) → Job (labor + materials + asset) → Invoice.
</p>

@code {
    private int customerCount;
    private int quoteCount;
    private int jobCount;
    private int invoiceCount;
    private string homeAiInsight = "";
    private bool onboarded = true; // set false for new users in real (from localStorage or user profile)
    private int inventoryCount;
    private int lowStockCount;
    private int assetCount;
    private decimal activeJobVariance;
    private int _readyToInvoiceCount;
    private decimal _readyToInvoiceValue;
    private ExecutiveDashboardSummary? _executive;
    private List<DivisionScorecardRow> _divisionScorecards = new();
    private List<UserActivityRow> _userActivity = new();
    private List<OverdueApprovalRow> _overdueApprovals = new();
    private bool _showExecutiveView;
    private bool _showRoleDashboard;
    private bool _isTechnician;
    private bool _isProcurement;
    private bool _isHr;
    private bool _isStores;
    private bool _isFinance;
    private int _supplierCount;
    private Tenant? currentTenant;
    private string? billingPortalUrl;
    private bool _initialized;
    private Guid? _convertingId;
    private Guid? _actingInvoiceId;
    private Guid? _sendingInvoiceId;
    private Guid? _sendingPoId;
    private Guid? _sendingQuoteId;
    private string? _approvingKey;
    private bool CanChaseInvoices => CurrentUserService.Permissions.Contains(Permissions.InvoicesManage);
    private bool CanSendPurchaseOrders => CurrentUserService.Permissions.Contains(Permissions.PurchaseOrdersManage);
    private bool CanSendQuotes => CurrentUserService.Permissions.Contains(Permissions.QuotesManage);

    private static string ApprovalKey(ApprovalQueueRow row) => $"{row.Kind}:{row.Id:D}";

    private bool CanApprove(ApprovalQueueRow row) => row.Kind switch
    {
        "Quote" => CurrentUserService.Permissions.Contains(Permissions.QuotesApprove),
        "REQ" => CurrentUserService.Permissions.Contains(Permissions.RequisitionsApprove),
        "Leave" => CurrentUserService.Permissions.Contains(Permissions.LeaveApprove),
        "Field" => CurrentUserService.Permissions.Contains(Permissions.JobsManage),
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _showExecutiveView = CurrentUserService.Permissions.Contains(Permissions.AuditView)
                || CurrentUserService.Permissions.Contains(Permissions.QuotesManage);

            if (CurrentUserService.UserId is { } userId)
            {
                var roles = await UserService.GetUserRolesAsync(userId);
                _isTechnician = roles.Contains("Technician");
                _isProcurement = roles.Contains("Procurement");
                _isHr = roles.Contains("HrManager");
                _isStores = roles.Contains("Stores");
                _isFinance = roles.Contains("Finance");
                _showRoleDashboard = _isTechnician || _isProcurement || _isHr || _isStores || _isFinance;
            }

            customerCount = (await CustomerService.GetAllAsync()).Count;
            quoteCount = (await QuoteService.GetAllAsync()).Count;
            jobCount = (await JobService.GetAllAsync()).Count;
            invoiceCount = (await InvoiceService.GetAllAsync()).Count;
            inventoryCount = (await InventoryService.GetAllItemsAsync()).Count;
            lowStockCount = (await InventoryService.GetAllItemsAsync(lowStockOnly: true)).Count;
            assetCount = (await AssetService.GetAllAsync()).Count;
            _supplierCount = (await SupplierService.GetAllAsync()).Count;

            var activeJobs = (await JobService.GetAllAsync(pageSize: 200)).ToList();
            activeJobVariance = activeJobs
                .Where(j => j.Status == JobStatus.InProgress || j.Status == JobStatus.Scheduled)
                .Sum(j => (j.ActualCost + (j.Labors?.Sum(l => l.TotalCost) ?? 0)) - j.QuotedTotal);

            _executive = await ExecutiveDashboard.GetSummaryAsync();
            _readyToInvoiceCount = _executive.ReadyToInvoiceJobs;
            _readyToInvoiceValue = _executive.ReadyToInvoiceValue;
            _divisionScorecards = (await AccountabilityReports.GetDivisionScorecardsAsync()).ToList();
            _userActivity = (await AccountabilityReports.GetUserActivityAsync()).ToList();
            _overdueApprovals = (await AccountabilityReports.GetOverdueApprovalsAsync()).ToList();

            // Load current tenant commercial usage (for demo visibility)
            var tid = CurrentUserService.TenantId;
            if (tid != Guid.Empty)
            {
                currentTenant = await TenantService.GetByIdAsync(tid);
                if (currentTenant != null)
                    billingPortalUrl = await BillingPortalService.ResolveCustomerPortalUrlAsync(currentTenant);
            }
        }
        catch
        {
            // ignore on initial load if DB not ready
        }
        finally
        {
            _initialized = true;
        }
    }

    private async Task ConvertWonWorkAsync(ConvertibleDocumentRow row)
    {
        if (_convertingId is not null)
            return;

        _convertingId = row.Id;
        try
        {
            Job job;
            if (string.Equals(row.Kind, "Quote", StringComparison.OrdinalIgnoreCase))
                job = await QuoteService.ConvertToJobAsync(row.Id);
            else if (string.Equals(row.Kind, "Sales order", StringComparison.OrdinalIgnoreCase))
                job = await SalesOrderService.ConvertToJobAsync(row.Id);
            else
            {
                Nav.NavigateTo(row.Href);
                return;
            }

            Toast.ShowSuccess($"{row.Kind} {row.Number} is now job {job.JobNumber}.");
            var href = job.NeedsDepositInvoice()
                ? $"/jobs/{job.Id:D}?invoice=deposit"
                : $"/jobs/{job.Id:D}";
            Nav.NavigateTo(href);
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _convertingId = null;
        }
    }

    private async Task SendInvoiceAsync(ConvertibleDocumentRow row)
    {
        if (_sendingInvoiceId is not null)
            return;

        _sendingInvoiceId = row.Id;
        try
        {
            await InvoiceService.UpdateStatusAsync(row.Id, InvoiceStatus.Sent);
            Toast.ShowSuccess($"Sent {row.Number} to {row.CustomerName}.");
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _sendingInvoiceId = null;
        }
    }

    private async Task ChaseOverdueInvoiceAsync(Guid invoiceId)
    {
        if (_actingInvoiceId is not null)
            return;

        _actingInvoiceId = invoiceId;
        try
        {
            var result = await InvoiceService.ChaseOverdueAsync(invoiceId);
            Toast.ShowSuccess(result.EmailSent
                ? $"Chased {result.InvoiceNumber} — emailed {result.CustomerEmail}."
                : $"Chased {result.InvoiceNumber} — recorded in-system (SMTP not configured).");
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _actingInvoiceId = null;
        }
    }

    private async Task ApproveFromHomeAsync(ApprovalQueueRow row)
    {
        if (_approvingKey is not null)
            return;
        if (CurrentUserService.UserId is not { } userId)
        {
            Toast.ShowError("Sign in again to approve.");
            return;
        }

        _approvingKey = ApprovalKey(row);
        try
        {
            var message = await AdvanceApprovalAsync(row, userId);
            Toast.ShowSuccess(message);
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _approvingKey = null;
        }
    }

    private async Task<string> AdvanceApprovalAsync(ApprovalQueueRow row, Guid userId)
    {
        if (string.Equals(row.Kind, "Quote", StringComparison.OrdinalIgnoreCase))
        {
            await QuoteService.ExecutiveApproveAsync(row.Id, userId);
            return $"{row.Number} approved — can now be marked Sent.";
        }

        if (string.Equals(row.Kind, "REQ", StringComparison.OrdinalIgnoreCase))
        {
            var wasManager = string.Equals(row.Stage, nameof(RequisitionStatus.PendingManager), StringComparison.Ordinal);
            var approved = row.Stage switch
            {
                nameof(RequisitionStatus.PendingManager) => await RequisitionService.ApproveManagerAsync(row.Id, userId),
                nameof(RequisitionStatus.PendingExecutive) => await RequisitionService.ApproveExecutiveAsync(row.Id, userId),
                _ => false
            };
            if (!approved)
                throw new InvalidOperationException("Requisition is no longer pending at this approval stage.");
            return wasManager
                ? $"{row.Number} advanced to executive approval."
                : $"{row.Number} approved — stock reserved for issue.";
        }

        if (string.Equals(row.Kind, "Leave", StringComparison.OrdinalIgnoreCase))
        {
            var approved = row.Stage switch
            {
                nameof(LeaveRequestStatus.PendingManager) => await LeaveService.ApproveManagerAsync(row.Id, userId),
                nameof(LeaveRequestStatus.PendingExecutive) => await LeaveService.ApproveExecutiveAsync(row.Id, userId),
                nameof(LeaveRequestStatus.PendingHr) => await LeaveService.ApproveHrAsync(row.Id, userId),
                _ => false
            };
            if (!approved)
                throw new InvalidOperationException("Leave request is no longer pending at this approval stage.");
            return "Leave request advanced in the approval chain.";
        }

        if (string.Equals(row.Kind, "Field", StringComparison.OrdinalIgnoreCase))
        {
            if (!await FieldReportService.ApproveAsync(row.Id, userId))
                throw new InvalidOperationException("Field report is no longer pending approval.");
            return $"Field report for {row.Number} approved — hours posted to the job.";
        }

        throw new InvalidOperationException($"Cannot approve {row.Kind} from Home.");
    }

    private async Task SendQuoteAsync(ConvertibleDocumentRow row)
    {
        if (_sendingQuoteId is not null)
            return;

        _sendingQuoteId = row.Id;
        try
        {
            await QuoteService.SendAsync(row.Id);
            Toast.ShowSuccess($"Sent {row.Number} to {row.CustomerName}.");
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _sendingQuoteId = null;
        }
    }

    private async Task SendPurchaseOrderAsync(ConvertibleDocumentRow row)
    {
        if (_sendingPoId is not null)
            return;

        _sendingPoId = row.Id;
        try
        {
            await PurchaseOrderService.UpdateStatusAsync(row.Id, PurchaseOrderStatus.Sent);
            Toast.ShowSuccess($"Sent {row.Number} to {row.CustomerName}.");
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _sendingPoId = null;
        }
    }

    private async Task RecordOverduePaymentAsync(AgedDebtorRow row)
    {
        if (_actingInvoiceId is not null)
            return;

        _actingInvoiceId = row.InvoiceId;
        try
        {
            await InvoiceService.RecordPaymentAsync(
                row.InvoiceId,
                row.BalanceDue,
                DateTime.UtcNow.Date,
                "Home cash queue",
                CurrentUserService.UserId,
                "Recorded remaining balance from Home.");
            Toast.ShowSuccess($"Received R {row.BalanceDue:N0} on {row.InvoiceNumber}.");
            _executive = await ExecutiveDashboard.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _actingInvoiceId = null;
        }
    }

    private async Task GenerateHomeAiInsight()
    {
        try
        {
            string context = $"Customers: {customerCount}, Quotes: {quoteCount}, Jobs: {jobCount}, Invoices: {invoiceCount}. Recent variance and low stock alerts in system.";
            homeAiInsight = await AiAssistantService.AskCopilotAsync("Give one key actionable insight for this contracting business today, focusing on margin or efficiency.", context) ?? "AI insight unavailable.";
        }
        catch
        {
            homeAiInsight = "AI temporarily unavailable (configure key).";
        }
    }

    private void StartOnboarding()
    {
        Toast.ShowSuccess("Onboarding started - see AI Copilot for your first quote!");
        Nav.NavigateTo("/ai-copilot");
        onboarded = true;
    }

    private async Task EmailExecutiveSummaryAsync()
    {
        var sent = await ScheduledReports.SendExecutiveSummaryEmailAsync();
        if (sent)
            Toast.ShowSuccess("Executive summary emailed (check Mailpit at :8025 in docker demo).");
        else
            Toast.ShowInfo("Email not sent — configure SMTP (Mailpit in docker-compose) or sign in with an email address.");
    }

    private async Task ExportUserActivityAsync()
    {
        var csv = await AccountabilityReports.ExportUserActivityCsvAsync();
        await JS.InvokeVoidAsync("meterpUi.downloadText", "user-activity.csv", csv, "text/csv;charset=utf-8");
        Toast.ShowSuccess("User activity exported.");
    }

    private async Task ExportDivisionScorecardsAsync()
    {
        var csv = await AccountabilityReports.ExportDivisionScorecardsCsvAsync();
        await JS.InvokeVoidAsync("meterpUi.downloadText", "division-scorecards.csv", csv, "text/csv;charset=utf-8");
        Toast.ShowSuccess("Division scorecards exported.");
    }

    private async Task OpenBillingPortal()
    {
        if (currentTenant == null)
            return;

        var url = billingPortalUrl ?? await BillingPortalService.ResolveCustomerPortalUrlAsync(currentTenant);
        if (string.IsNullOrWhiteSpace(url))
        {
            Toast.ShowInfo("Billing portal is not available for this tenant.");
            return;
        }

        billingPortalUrl = url;
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}
