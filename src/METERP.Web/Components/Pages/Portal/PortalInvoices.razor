@page "/portal/invoices"
@layout Layout.PortalLayout
@attribute [Authorize(Policy = "Portal.Access")]
@rendermode InteractiveServer
@using METERP.Application.Interfaces
@using METERP.Application.Services
@using METERP.Domain
@using METERP.Web.Services
@inject ICustomerPortalService Portal
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav
@inject ConfirmService Confirm
@inject ToastService Toast

<PageTitle>Invoices</PageTitle>
<h1 class="portal-title">Invoices</h1>
<p class="text-muted">Sent, part-paid, and overdue documents. Pay by EFT using the invoice number as reference, then tell us you have paid — the office records the receipt when the money lands.</p>

@if (_denied != null)
{
    <div class="alert alert-warning" role="status" data-testid="portal-unlinked">@_denied</div>
}
else if (_dash == null)
{
    <p class="text-muted">Loading…</p>
}
else if (!_dash.Invoices.Any())
{
    <p class="text-muted" data-testid="portal-invoices-empty">No invoices yet.</p>
}
else
{
    <div class="table-responsive card portal-panel">
        <table class="table mb-0" data-testid="portal-invoices-table">
            <thead>
                <tr>
                    <th>Number</th>
                    <th>Date</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Outstanding</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in _dash.Invoices)
                {
                    <tr class="meterp-row-click" title="Open invoice" @onclick="() => OpenInvoice(invoice)">
                        <td>@invoice.InvoiceNumber</td>
                        <td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td>@invoice.DueDate.ToString("yyyy-MM-dd")</td>
                        <td>@invoice.Status</td>
                        <td class="text-end">@InvoiceCreditConvention.FormatDocumentAmount(invoice.DocumentType, invoice.Total)</td>
                        <td class="text-end">@InvoiceCreditConvention.FormatDocumentBalance(invoice.DocumentType, invoice.BalanceDue)</td>
                        <td class="text-end">
                            @if (invoice.DocumentType != InvoiceDocumentType.CreditNote && invoice.BalanceDue > 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-testid="portal-invoice-paid"
                                        @onclick="() => ReportPaidAsync(invoice)" @onclick:stopPropagation="true">
                                    I've paid
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_invoice != null)
{
    <FormModal IsOpen="true" Title="@_invoice.InvoiceNumber" Size="lg" TestId="portal-invoice-detail" OnClose="CloseInvoice">
        <ChildContent>
            <p class="mb-1">Date: @_invoice.InvoiceDate.ToString("yyyy-MM-dd") · Due @_invoice.DueDate.ToString("yyyy-MM-dd")</p>
            <p class="mb-1">Status: @_invoice.Status</p>
            <p class="mb-1">Total: @InvoiceCreditConvention.FormatDocumentAmount(_invoice.DocumentType, _invoice.Total)</p>
            <p class="mb-3">Outstanding: <strong>@InvoiceCreditConvention.FormatDocumentBalance(_invoice.DocumentType, _invoice.BalanceDue)</strong></p>
            <table class="table table-sm mb-0">
                <thead><tr><th>Description</th><th>Type</th><th class="text-end">Qty</th><th class="text-end">Total</th></tr></thead>
                <tbody>
                    @foreach (var line in _invoice.Lines.Where(l => !l.IsDeleted))
                    {
                        <tr>
                            <td>@line.Description</td>
                            <td>@line.LineType</td>
                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                            <td class="text-end">@InvoiceCreditConvention.FormatDocumentAmount(_invoice.DocumentType, line.LineTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseInvoice">Close</button>
            @if (_invoice.DocumentType != InvoiceDocumentType.CreditNote && _invoice.BalanceDue > 0)
            {
                <button type="button" class="btn btn-primary" @onclick="() => ReportPaidAsync(_invoice)">I've paid</button>
            }
        </Footer>
    </FormModal>
}

@code {
    private CustomerPortalDashboard? _dash;
    private string? _denied;
    private Invoice? _invoice;

    private void OpenInvoice(Invoice invoice) => _invoice = invoice;
    private void CloseInvoice() => _invoice = null;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentUser.CustomerId is not { } customerId || customerId == Guid.Empty)
        {
            _denied = CustomerPortalMessages.Unlinked;
            return;
        }
        try
        {
            _dash = await Portal.GetDashboardAsync(customerId);
            if (_dash.IsUnlinked)
            {
                _denied = _dash.CustomerName;
                _dash = null;
            }
        }
        catch (Exception)
        {
            _denied = CustomerPortalMessages.Unlinked;
        }
    }

    private async Task ReportPaidAsync(Invoice invoice)
    {
        if (CurrentUser.CustomerId is not { } customerId)
            return;

        var ok = await Confirm.ConfirmAsync(
            $"Tell the office you paid R {invoice.BalanceDue:N2} on {invoice.InvoiceNumber}? Use that invoice number as your bank reference. This does not mark the invoice paid until we see the money.",
            "Payment notice",
            "I've paid");
        if (!ok) return;

        try
        {
            await Portal.ReportPaymentAsync(customerId, invoice.Id, invoice.BalanceDue, invoice.InvoiceNumber);
            Toast.ShowSuccess($"Thanks — we have a payment notice for {invoice.InvoiceNumber}.");
            _dash = await Portal.GetDashboardAsync(customerId);
            if (_invoice != null)
                _invoice = _dash.Invoices.FirstOrDefault(i => i.Id == _invoice.Id);
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }
}
