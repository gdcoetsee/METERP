@page "/customers"
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Domain
@using METERP.Common
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@attribute [Authorize(Policy = "Customers.View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ICustomerService CustomerService
@inject ICurrentUserService CurrentUserService
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>Customers</PageTitle>

@if (!_loading)
{
    <span data-testid="customers-ready" class="visually-hidden">ready</span>
}

<PageHeader Title="Customers" Subtitle="Companies you quote, job, and invoice. Name is required; the rest can wait." TestId="customers-page-header">
    <Actions>
        @if (UserCanManage)
        {
            <button class="btn btn-primary" @onclick="ShowCreateForm" data-testid="new-customer-button">New customer</button>
        }
    </Actions>
</PageHeader>

<div class="meterp-filter-bar">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control" data-testid="customers-search" placeholder="Search name, email or phone..."
               value="@searchTerm" @oninput="OnSearchInput" />
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch" title="Clear search">Clear</button>
        }
    </div>
</div>

@if (_loading)
{
    <ListSkeleton Rows="6" TestId="customers-loading" AriaLabel="Loading customers" />
}
else if (customers == null)
{
    <p><em>Loading customers...</em></p>
}
else if (!customers.Any())
{
    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <div class="alert alert-warning">No customers match your search. <button class="btn btn-sm btn-link p-0" @onclick="ClearSearch">Clear search</button></div>
    }
    else
    {
        <EmptyState Title="No customers yet"
                    Description="Add a company before you quote. Name is required; contact details can wait."
                    Icon="🏢"
                    CtaText="@(UserCanManage ? "New customer" : null)"
                    TestId="customers-empty"
                    OnCta="ShowCreateForm" />
    }
}
else
{
    <div class="table-responsive" data-testid="customers-table">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone / Email</th>
                    <th>Location</th>
                    <th>Contacts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in customers)
                {
                    <tr>
                        <td>
                            <strong>@customer.Name</strong>
                            @if (!string.IsNullOrEmpty(customer.CompanyRegistrationNumber))
                            {
                                <br /><small class="text-muted">Reg: @customer.CompanyRegistrationNumber</small>
                            }
                        </td>
                        <td>
                            @customer.Phone <br />
                            <small>@customer.Email</small>
                        </td>
                        <td>@customer.City, @customer.Province</td>
                        <td>
                            <span class="badge bg-secondary">@customer.Contacts.Count</span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ViewCustomer(customer)">View</button>
                            @if (UserCanManage)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCustomer(customer)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => DeleteCustomer(customer)">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(currentPage <= 1)">Previous</button>
        <span class="text-muted small">Page @currentPage</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(customers.Count < PageSize)">Next</button>
    </div>
}

@if (showForm)
{
    <FormModal IsOpen="true"
               Title="@(isEditing ? "Edit customer" : "New customer")"
               Size="lg"
               TestId="customer-form-modal"
               CloseOnBackdrop="false"
               OnClose="CancelForm">
        <ChildContent>
            <EditForm Model="currentCustomer" OnValidSubmit="SaveCustomer" FormName="CustomerForm">
                <div class="meterp-section">
                    <div class="meterp-section-title">Company</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label meterp-required">Name / company</label>
                            <InputText class="form-control" @bind-Value="currentCustomer.Name" required />
                            <span class="meterp-field-hint">Required. This is how they appear on quotes and invoices.</span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Company reg number <span class="text-muted fw-normal">(optional)</span></label>
                            <InputText class="form-control" @bind-Value="currentCustomer.CompanyRegistrationNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">VAT number <span class="text-muted fw-normal">(optional)</span></label>
                            <InputText class="form-control" @bind-Value="currentCustomer.VatNumber" />
                        </div>
                    </div>
                </div>
                <div class="meterp-section">
                    <div class="meterp-section-title">Contact</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Phone <span class="text-muted fw-normal">(optional)</span></label>
                            <InputText class="form-control" @bind-Value="currentCustomer.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email <span class="text-muted fw-normal">(optional)</span></label>
                            <InputText type="email" class="form-control" @bind-Value="currentCustomer.Email" />
                        </div>
                    </div>
                </div>
                <div class="meterp-section mb-0">
                    <div class="meterp-section-title">Address</div>
                    <div class="mb-2">
                        <InputText class="form-control" @bind-Value="currentCustomer.AddressLine1" placeholder="Street address" />
                    </div>
                    <InputText class="form-control mb-3" @bind-Value="currentCustomer.AddressLine2" placeholder="Address line 2" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">City</label>
                            <InputText class="form-control" @bind-Value="currentCustomer.City" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Province</label>
                            <InputText class="form-control" @bind-Value="currentCustomer.Province" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Postal code</label>
                            <InputText class="form-control" @bind-Value="currentCustomer.PostalCode" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Country</label>
                            <InputText class="form-control" @bind-Value="currentCustomer.Country" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes <span class="text-muted fw-normal">(optional)</span></label>
                            <InputTextArea class="form-control" @bind-Value="currentCustomer.Notes" rows="2" />
                        </div>
                    </div>
                </div>
            </EditForm>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="SaveCustomer">Save customer</button>
        </Footer>
    </FormModal>
}

@if (selectedCustomer != null)
{
    <FormModal IsOpen="true"
               Title="@($"{selectedCustomer.Name} — contacts")"
               Size="lg"
               TestId="customer-detail"
               CloseOnBackdrop="false"
               OnClose="CloseCustomerView">
        <ChildContent>
            <div class="mb-3">
                <strong>Details:</strong> @selectedCustomer.Phone | @selectedCustomer.Email<br />
                @selectedCustomer.AddressLine1, @selectedCustomer.City
            </div>

            <h6>Contacts (@selectedCustomer.Contacts.Count)</h6>

            @if (selectedCustomer.Contacts.Any())
            {
                <ul class="list-group mb-3">
                    @foreach (var contact in selectedCustomer.Contacts.OrderByDescending(c => c.IsPrimary))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@contact.FirstName @contact.LastName</strong>
                                @if (contact.IsPrimary) { <span class="badge bg-info ms-1">Primary</span> }
                                <br />
                                <small>@contact.JobTitle | @contact.Phone | @contact.Email</small>
                            </div>
                            @if (UserCanManage)
                            {
                                <div>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditContact(contact)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContact(contact)">Delete</button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">No contacts yet.</p>
            }

            @if (UserCanManage)
            {
                <button class="btn btn-outline-success btn-sm" @onclick="ShowAddContactForm">+ Add Contact</button>
            }

            @if (showContactForm)
            {
                <div class="mt-3 p-3 border rounded">
                    <h6>@(editingContact?.Id != Guid.Empty ? "Edit" : "New") Contact</h6>
                    <EditForm Model="editingContact" OnValidSubmit="SaveContact" FormName="ContactForm">
                        <div class="row">
                            <div class="col-md-6">
                                <InputText class="form-control mb-2" @bind-Value="editingContact!.FirstName" placeholder="First Name" required />
                            </div>
                            <div class="col-md-6">
                                <InputText class="form-control mb-2" @bind-Value="editingContact.LastName" placeholder="Last Name" required />
                            </div>
                        </div>
                        <InputText class="form-control mb-2" @bind-Value="editingContact.JobTitle" placeholder="Job Title" />
                        <InputText class="form-control mb-2" @bind-Value="editingContact.Phone" placeholder="Phone" />
                        <InputText type="email" class="form-control mb-2" @bind-Value="editingContact.Email" placeholder="Email" />
                        <div class="form-check mb-2">
                            <InputCheckbox class="form-check-input" @bind-Value="editingContact.IsPrimary" />
                            <label class="form-check-label">Primary Contact</label>
                        </div>
                        <InputTextArea class="form-control mb-2" @bind-Value="editingContact.Notes" placeholder="Notes" rows="2" />

                        <button type="submit" class="btn btn-sm btn-success">Save Contact</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelContactForm">Cancel</button>
                    </EditForm>
                </div>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseCustomerView">Close</button>
        </Footer>
    </FormModal>
}

@code {
    private List<Customer> customers = new();
    private Customer currentCustomer = new();
    private Customer? selectedCustomer;
    private bool showForm;
    private bool isEditing;
    private bool showContactForm;
    private Contact? editingContact;
    private string searchTerm = string.Empty;
    private int currentPage = 1;
    private const int PageSize = 10;
    private bool _loading = true;
    private int _customersLoadGeneration;
    private readonly ComponentAsyncGate _dataGate = new();

    private bool UserCanManage => CurrentUserService.Permissions.Contains(Permissions.CustomersManage);

    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(QuerySearch))
                searchTerm = QuerySearch;
            await LoadCustomers();
        }
        finally
        {
            _loading = false;
        }
    }

    private Task LoadCustomers() => _dataGate.RunAsync(async () =>
    {
        var generation = ++_customersLoadGeneration;
        var term = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim();
        var loaded = (await CustomerService.GetAllAsync(term, currentPage, PageSize)).ToList();
        if (generation != _customersLoadGeneration)
            return;
        customers = loaded;
    });

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadCustomers();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadCustomers();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadCustomers();
        }
    }

    private async Task NextPage()
    {
        currentPage++;
        await LoadCustomers();
    }

    private void ShowCreateForm()
    {
        currentCustomer = new Customer { Country = "South Africa" };
        isEditing = false;
        showForm = true;
        selectedCustomer = null;
    }

    private void EditCustomer(Customer customer)
    {
        currentCustomer = new Customer
        {
            Id = customer.Id,
            Name = customer.Name,
            CompanyRegistrationNumber = customer.CompanyRegistrationNumber,
            VatNumber = customer.VatNumber,
            Phone = customer.Phone,
            Email = customer.Email,
            AddressLine1 = customer.AddressLine1,
            AddressLine2 = customer.AddressLine2,
            City = customer.City,
            Province = customer.Province,
            PostalCode = customer.PostalCode,
            Country = customer.Country,
            Notes = customer.Notes
        };
        isEditing = true;
        showForm = true;
        selectedCustomer = null;
    }

    private async Task SaveCustomer()
    {
        try
        {
            if (isEditing)
            {
                await CustomerService.UpdateAsync(currentCustomer);
            }
            else
            {
                await CustomerService.CreateAsync(currentCustomer);
            }

            showForm = false;
            ToastService.ShowSuccess("Customer saved successfully.");
            await LoadCustomers();
            currentCustomer = new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private void CancelForm()
    {
        showForm = false;
        currentCustomer = new();
    }

    private async Task ViewCustomer(Customer customer)
    {
        selectedCustomer = await CustomerService.GetByIdAsync(customer.Id);
        showForm = false;
        showContactForm = false;
    }

    private void CloseCustomerView()
    {
        selectedCustomer = null;
        editingContact = null;
        showContactForm = false;
    }

    private void ShowAddContactForm()
    {
        if (selectedCustomer == null) return;
        editingContact = new Contact { CustomerId = selectedCustomer.Id };
        showContactForm = true;
    }

    private void EditContact(Contact contact)
    {
        editingContact = new Contact
        {
            Id = contact.Id,
            CustomerId = contact.CustomerId,
            FirstName = contact.FirstName,
            LastName = contact.LastName,
            JobTitle = contact.JobTitle,
            Phone = contact.Phone,
            Mobile = contact.Mobile,
            Email = contact.Email,
            Notes = contact.Notes,
            IsPrimary = contact.IsPrimary
        };
        showContactForm = true;
    }

    private async Task SaveContact()
    {
        if (editingContact == null || selectedCustomer == null) return;

        if (editingContact.Id == Guid.Empty)
        {
            await CustomerService.AddContactAsync(editingContact);
        }
        else
        {
            await CustomerService.UpdateContactAsync(editingContact);
        }

        showContactForm = false;
        editingContact = null;
        ToastService.ShowSuccess("Contact saved successfully.");
        selectedCustomer = await CustomerService.GetByIdAsync(selectedCustomer.Id); // refresh
        await LoadCustomers();
    }

    private void CancelContactForm()
    {
        showContactForm = false;
        editingContact = null;
    }

    private async Task DeleteContact(Contact contact)
    {
        if (!await ConfirmDelete($"Delete contact {contact.FirstName} {contact.LastName}?")) return;

        await CustomerService.DeleteContactAsync(contact.Id);
        selectedCustomer = await CustomerService.GetByIdAsync(selectedCustomer!.Id);
        await LoadCustomers();
    }

    private async Task DeleteCustomer(Customer customer)
    {
        if (!await ConfirmDelete($"Delete customer \"{customer.Name}\" and all its contacts?")) return;

        await CustomerService.DeleteAsync(customer.Id);
        if (selectedCustomer?.Id == customer.Id)
        {
            selectedCustomer = null;
            showContactForm = false;
            editingContact = null;
        }
        await LoadCustomers();
    }

    private async Task<bool> ConfirmDelete(string message)
    {
        try
        {
            return await JS.InvokeAsync<bool>("confirm", message);
        }
        catch
        {
            return false;
        }
    }
}
