@page "/opportunities"
@using METERP.Application.Services
@using METERP.Domain
@using METERP.Common
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using METERP.Application.Interfaces
@inject IOpportunityService OpportunityService
@inject ICustomerService CustomerService
@inject IEmployeeService EmployeeService
@inject ICurrentUserService CurrentUserService
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS
@attribute [Authorize(Policy = "Opportunities.View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable

<PageTitle>Opportunities (CRM)</PageTitle>

<div class="meterp-board-page">
@if (_ready)
{
    <span data-testid="opportunities-ready" class="visually-hidden">ready</span>
}

<PageHeader Title="Opportunities" Subtitle="Pipeline from lead to quote. Click a card to act — do not scroll for a form." TestId="opportunities-page-header">
    <Actions>
        @if (CanManage)
        {
            <button type="button" class="btn btn-primary" data-testid="opportunity-create-button" @onclick="ShowCreate">New opportunity</button>
        }
    </Actions>
</PageHeader>

<div class="meterp-board-toolbar" data-testid="opportunity-filters">
    <div class="input-group meterp-board-search">
        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control" placeholder="Search deals..."
               data-testid="opportunity-search" value="@searchTerm" @oninput="OnSearch" />
    </div>
    <select class="form-select form-select-sm" data-testid="opportunity-filter-close" @bind="_closeFilter" @bind:after="Filter">
        <option value="all">Close date</option>
        <option value="overdue">Overdue</option>
        <option value="month">This month</option>
        <option value="next30">Next 30 days</option>
    </select>
    <select class="form-select form-select-sm" data-testid="opportunity-filter-amount" @bind="_amountFilter" @bind:after="Filter">
        <option value="all">Amount</option>
        <option value="10k">R 10k+</option>
        <option value="50k">R 50k+</option>
        <option value="100k">R 100k+</option>
    </select>
    <select class="form-select form-select-sm" data-testid="opportunity-filter-quote" @bind="_quoteFilter" @bind:after="Filter">
        <option value="all">Association</option>
        <option value="quoted">Has quote</option>
        <option value="unquoted">No quote</option>
    </select>
    <select class="form-select form-select-sm" data-testid="opportunity-filter-priority" @bind="_priorityFilter" @bind:after="Filter">
        <option value="all">Priority</option>
        <option value="High">High</option>
        <option value="Medium">Medium</option>
        <option value="Low">Low</option>
    </select>
    <select class="form-select form-select-sm" data-testid="opportunity-filter-followup" @bind="_followUpFilter" @bind:after="Filter">
        <option value="all">Follow-up</option>
        <option value="overdue">Overdue</option>
        <option value="week">This week</option>
        <option value="none">No follow-up</option>
    </select>
    <select class="form-select form-select-sm meterp-board-toolbar-sort" data-testid="opportunity-sort" @bind="_sort" @bind:after="Filter">
        <option value="board">Board order</option>
        <option value="close">Close date</option>
        <option value="followup">Follow-up date</option>
        <option value="amount-desc">Amount high–low</option>
        <option value="amount-asc">Amount low–high</option>
        <option value="weighted">Weighted high–low</option>
        <option value="title">Deal name</option>
        <option value="newest">Recently created</option>
    </select>
</div>
@if (HasActiveFilters)
{
    <div class="meterp-filter-chips">
        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <span class="badge text-bg-light">Search: @searchTerm</span>
        }
        @if (_closeFilter != "all")
        {
            <span class="badge text-bg-light">@_closeFilter</span>
        }
        @if (_amountFilter != "all")
        {
            <span class="badge text-bg-light">@_amountFilter</span>
        }
        @if (_quoteFilter != "all")
        {
            <span class="badge text-bg-light">@_quoteFilter</span>
        }
        @if (_priorityFilter != "all")
        {
            <span class="badge text-bg-light">@_priorityFilter</span>
        }
        @if (_followUpFilter != "all")
        {
            <span class="badge text-bg-light">@_followUpFilter</span>
        }
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ResetFilters">Clear filters</button>
    </div>
}

@if (_loading)
{
    <ListSkeleton Rows="4" TestId="opportunities-loading" AriaLabel="Loading opportunities" />
}
else
{
<div class="meterp-kanban" data-testid="opportunities-pipeline">
    @foreach (var stage in stages)
    {
        <div class="meterp-kanban-col">
            <div class="meterp-kanban-col-head">
                <strong class="small">@StageLabel(stage)</strong>
                <span class="badge bg-secondary ms-1">@GetCount(stage)</span>
                <div class="small text-success">R @GetValue(stage).ToString("N0")</div>
                <div class="meterp-kanban-weighted">Weighted R @GetWeighted(stage).ToString("N0")</div>
            </div>
            <div class="meterp-kanban-lane"
                 data-lane="@stage.ToString()"
                 data-testid="@($"opportunity-lane-{stage}")">
                @foreach (var opp in GetByStage(stage))
                {
                    <div @key="opp.Id"
                         class="meterp-kanban-card"
                         draggable="@(CanManage ? "true" : "false")"
                         data-deal-id="@opp.Id"
                         data-testid="@(opp.CustomerId.HasValue && opp.CustomerId != Guid.Empty ? "opportunity-card-with-customer" : "opportunity-card")"
                         @onclick="() => OnCardClick(opp)">
                        <div class="p-2 small">
                            <div class="d-flex align-items-start gap-1">
                                @if (CanManage)
                                {
                                    <i class="bi bi-grip-vertical meterp-kanban-grip" aria-hidden="true"></i>
                                }
                                <strong>@opp.Title</strong>
                            </div>
                            <span class="text-muted">@DisplayCustomer(opp)</span><br />
                            <span class="text-success">R @opp.Value.ToString("N0")</span>
                            <span class="text-muted"> · @opp.ProbabilityPercent%</span>
                            <div class="text-muted">Close @opp.ExpectedClose.ToString("dd MMM") · @DaysToClose(opp)</div>
                            <div class="meterp-kanban-meta">
                                <span class="badge @PriorityBadgeClass(opp.Priority)">@opp.Priority</span>
                                @if (!string.IsNullOrWhiteSpace(OwnerName(opp)))
                                {
                                    <span class="badge bg-light text-dark">@OwnerName(opp)</span>
                                }
                                @if (FollowUpOverdue(opp))
                                {
                                    <span class="badge bg-danger-subtle text-danger">Follow-up overdue</span>
                                }
                                else if (opp.NextFollowUp is { } follow)
                                {
                                    <span class="badge bg-info-subtle text-info">Follow @follow.ToString("dd MMM")</span>
                                }
                                @if (opp.QuoteId is { } qid && qid != Guid.Empty)
                                {
                                    <span class="badge bg-success-subtle text-success">Quote</span>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (!GetByStage(stage).Any())
                {
                    <div class="small text-muted px-1 py-3">@(CanManage ? "Drop deals here" : "No deals")</div>
                }
            </div>
        </div>
    }
</div>
}
</div>

@if (showCreate && CanManage)
{
    <FormModal IsOpen="true"
               Title="New opportunity"
               Size="lg"
               TestId="opportunity-create-form"
               CloseOnBackdrop="false"
               OnClose="CancelCreate">
        <ChildContent>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label meterp-required">Title</label>
                    <input class="form-control" data-testid="opportunity-title" @bind="newOpp.Title" placeholder="e.g. Substation upgrade" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Customer</label>
                    <EntityPicker TestId="opportunity-customer-select"
                                  Value="selectedCustomerId"
                                  ValueChanged="OnOpportunityCustomerPicked"
                                  Options="CustomerPickerOptions"
                                  SelectedLabel="@SelectedOpportunityCustomerName"
                                  Placeholder="Type a company name, or leave blank"
                                  OnSearch="SearchCustomersAsync" />
                    <span class="meterp-field-hint">Optional. Link an existing company, or type a name below if they are not in the list yet.</span>
                </div>
                @if (selectedCustomerId == Guid.Empty)
                {
                    <div class="col-md-6">
                        <label class="form-label">Customer name (if not linked)</label>
                        <input class="form-control" @bind="newOpp.CustomerName" placeholder="Company name for this lead" />
                    </div>
                }
                <div class="col-md-4">
                    <label class="form-label">Value (R)</label>
                    <input type="number" class="form-control" @bind="newOpp.Value" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Stage</label>
                    <select class="form-select" @bind="newOpp.Stage">
                        @foreach (var s in stages) { <option value="@s">@StageLabel(s)</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Expected close</label>
                    <input type="date" class="form-control" @bind="newOpp.ExpectedClose" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Priority</label>
                    <select class="form-select" @bind="newOpp.Priority">
                        @foreach (var p in priorities) { <option value="@p">@p</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Source</label>
                    <select class="form-select" @bind="newOpp.Source">
                        @foreach (var s in sources) { <option value="@s">@SourceLabel(s)</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Next follow-up</label>
                    <input type="date" class="form-control" @bind="newOpp.NextFollowUp" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Contact name</label>
                    <input class="form-control" @bind="newOpp.ContactName" placeholder="Site manager / buyer" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Owner</label>
                    <EntityPicker TestId="opportunity-owner-select"
                                  Value="newOpp.OwnerEmployeeId ?? Guid.Empty"
                                  ValueChanged="OnCreateOwnerPicked"
                                  Options="EmployeePickerOptions"
                                  SelectedLabel="@CreateOwnerLabel"
                                  Placeholder="Who owns this deal"
                                  OnSearch="SearchEmployeesAsync" />
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn btn-outline-secondary" @onclick="CancelCreate">Cancel</button>
            <button class="btn btn-primary" data-testid="opportunity-save" @onclick="CreateOpp">Create</button>
        </Footer>
    </FormModal>
}

@if (selectedOpp != null)
{
    <FormModal IsOpen="true"
               Title="@selectedOpp.Title"
               Size="xl"
               TestId="opportunity-detail"
               CloseOnBackdrop="false"
               OnClose="CloseView">
        <ChildContent>
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="meterp-section">
                        <div class="meterp-section-title">Deal</div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label meterp-required">Title</label>
                                <input class="form-control" @bind="selectedOpp.Title" disabled="@(!CanManage)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount (R)</label>
                                <input type="number" class="form-control" @bind="selectedOpp.Value" disabled="@(!CanManage)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Stage</label>
                                <select class="form-select" @bind="selectedOpp.Stage" disabled="@(!CanManage)">
                                    @foreach (var s in stages) { <option value="@s">@StageLabel(s)</option> }
                                </select>
                                <span class="visually-hidden" data-testid="opportunity-stage">@StageLabel(selectedOpp.Stage)</span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Expected close</label>
                                <input type="date" class="form-control" @bind="selectedOpp.ExpectedClose" disabled="@(!CanManage)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Priority</label>
                                <select class="form-select" @bind="selectedOpp.Priority" disabled="@(!CanManage)">
                                    @foreach (var p in priorities) { <option value="@p">@p</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Source</label>
                                <select class="form-select" @bind="selectedOpp.Source" disabled="@(!CanManage)">
                                    @foreach (var s in sources) { <option value="@s">@SourceLabel(s)</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Type</label>
                                <select class="form-select" @bind="selectedOpp.DealType" disabled="@(!CanManage)">
                                    @foreach (var t in dealTypes) { <option value="@t">@DealTypeLabel(t)</option> }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Win probability %</label>
                                <input type="number" class="form-control" min="0" max="100" @bind="selectedOpp.ProbabilityPercent" disabled="@(!CanManage)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Next follow-up</label>
                                <input type="date" class="form-control" @bind="selectedOpp.NextFollowUp" disabled="@(!CanManage)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Weighted</label>
                                <p class="mb-0 pt-2">R @selectedOpp.WeightedValue.ToString("N0")</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contact</label>
                                <input class="form-control mb-2" @bind="selectedOpp.ContactName" placeholder="Name" disabled="@(!CanManage)" />
                                <input class="form-control mb-2" @bind="selectedOpp.ContactPhone" placeholder="Phone" disabled="@(!CanManage)" />
                                <input class="form-control" @bind="selectedOpp.ContactEmail" placeholder="Email" disabled="@(!CanManage)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Owner</label>
                                @if (CanManage)
                                {
                                    <EntityPicker TestId="opportunity-detail-owner"
                                                  Value="selectedOpp.OwnerEmployeeId ?? Guid.Empty"
                                                  ValueChanged="OnDetailOwnerPicked"
                                                  Options="EmployeePickerOptions"
                                                  SelectedLabel="@OwnerName(selectedOpp)"
                                                  Placeholder="Assign an owner"
                                                  OnSearch="SearchEmployeesAsync" />
                                }
                                else
                                {
                                    <p class="mb-0">@(OwnerName(selectedOpp) ?? "—")</p>
                                }
                            </div>
                            @if (ShowLossReason)
                            {
                                <div class="col-12">
                                    <label class="form-label meterp-required">Loss reason</label>
                                    <textarea class="form-control" rows="2" @bind="selectedOpp.LossReason" disabled="@(!CanManage)"
                                              placeholder="Price, timing, competitor, scope…"></textarea>
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label">Company</label>
                                @if (CanManage)
                                {
                                    <EntityPicker TestId="opportunity-detail-customer"
                                                  Value="selectedOpp.CustomerId ?? Guid.Empty"
                                                  ValueChanged="OnDetailCustomerPicked"
                                                  Options="CustomerPickerOptions"
                                                  SelectedLabel="@DisplayCustomer(selectedOpp)"
                                                  Placeholder="Link a company"
                                                  OnSearch="SearchCustomersAsync" />
                                }
                                else
                                {
                                    <p class="mb-0">@DisplayCustomer(selectedOpp)</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="meterp-section mb-0">
                        <div class="meterp-section-title">Next step / notes</div>
                        <textarea class="form-control" rows="5" @bind="selectedOpp.Notes" disabled="@(!CanManage)"
                                  placeholder="Next step, site visit, who you spoke to…"></textarea>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="meterp-totals mb-3">
                        <div class="meterp-section-title">Forecast</div>
                        <p class="mb-1">Amount <strong>R @selectedOpp.Value.ToString("N0")</strong></p>
                        <p class="mb-1">Probability <strong>@selectedOpp.ProbabilityPercent%</strong></p>
                        <p class="mb-0">Weighted <strong>R @selectedOpp.WeightedValue.ToString("N0")</strong></p>
                    </div>
                    <div class="meterp-totals mb-3">
                        <div class="meterp-section-title">Associated</div>
                        @if (selectedOpp.QuoteId is { } qid && qid != Guid.Empty)
                        {
                            <p class="mb-2">Linked quote is on file.</p>
                            <a class="btn btn-sm btn-outline-primary" href="/quotes">Open quotes</a>
                        }
                        else
                        {
                            <p class="mb-2 text-muted">No quote yet. Convert this deal when the scope is clear.</p>
                        }
                        <p class="small text-muted mb-0 mt-2">Created @selectedOpp.CreatedDate.ToString("dd MMM yyyy") · @DaysToClose(selectedOpp)</p>
                    </div>
                    @if (CanManage && selectedOpp.Stage is not OpportunityStage.ClosedWon and not OpportunityStage.ClosedLost)
                    {
                        <div class="d-flex gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-success" data-testid="opportunity-mark-won" @onclick="MarkWonAsync">Mark won</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-testid="opportunity-mark-lost" @onclick="MarkLostAsync">Mark lost</button>
                        </div>
                    }
                    <p class="meterp-field-hint">Drag cards between lanes, or save properties here. Create a quote when the scope is clear.</p>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn btn-outline-secondary" @onclick="CloseView">Close</button>
            @if (CanManage)
            {
                <button class="btn btn-outline-secondary" data-testid="opportunity-advance-stage"
                        @onclick="UpdateStage">Advance stage</button>
                <button class="btn btn-outline-primary" @onclick="SaveOppAsync">Save</button>
            }
            <button class="btn btn-outline-success" data-testid="opportunity-convert-ai"
                    @onclick="ConvertToQuote">Create with AI</button>
            <button class="btn btn-primary" data-testid="opportunity-convert-manual"
                    @onclick="ConvertToManualQuote">Create quote</button>
        </Footer>
    </FormModal>
}

@code {
    private List<Opportunity> opportunities = new();
    private List<Opportunity> filtered = new();
    private List<Customer> customers = new();
    private string searchTerm = "";
    private string _closeFilter = "all";
    private string _amountFilter = "all";
    private string _quoteFilter = "all";
    private string _priorityFilter = "all";
    private string _followUpFilter = "all";
    private string _sort = "board";
    private Opportunity? selectedOpp;
    private bool showCreate;
    private Opportunity newOpp = new();
    private Guid selectedCustomerId = Guid.Empty;
    private bool _suppressClick;
    private List<Employee> employees = new();

    private bool _ready;
    private bool _loading = true;
    private readonly ComponentAsyncGate _dataGate = new();
    private bool CanManage => CurrentUserService.Permissions.Contains(Permissions.OpportunitiesManage);

    [SupplyParameterFromQuery(Name = "open")]
    public Guid? OpenOpportunityId { get; set; }

    private static readonly OpportunityStage[] stages =
    {
        OpportunityStage.Lead,
        OpportunityStage.Qualified,
        OpportunityStage.Proposal,
        OpportunityStage.Negotiation,
        OpportunityStage.ClosedWon,
        OpportunityStage.ClosedLost
    };

    private static readonly OpportunityPriority[] priorities =
    {
        OpportunityPriority.High, OpportunityPriority.Medium, OpportunityPriority.Low
    };

    private static readonly OpportunitySource[] sources = Enum.GetValues<OpportunitySource>();
    private static readonly OpportunityDealType[] dealTypes = Enum.GetValues<OpportunityDealType>();

    private bool ShowLossReason =>
        selectedOpp != null && selectedOpp.Stage == OpportunityStage.ClosedLost;

    protected override async Task OnInitializedAsync() => await _dataGate.RunAsync(async () =>
    {
        _loading = true;
        try
        {
            opportunities = (await OpportunityService.GetAllAsync()).ToList();
            customers = (await CustomerService.GetAllAsync(pageSize: 200)).ToList();
            employees = (await EmployeeService.GetAllAsync(pageSize: 100)).ToList();
            filtered = opportunities;
            if (OpenOpportunityId is { } openId && openId != Guid.Empty)
                selectedOpp = opportunities.FirstOrDefault(o => o.Id == openId)
                    ?? await OpportunityService.GetByIdAsync(openId);
            _ready = true;
        }
        finally
        {
            _loading = false;
        }
    });

    private static string StageLabel(OpportunityStage stage) => stage switch
    {
        OpportunityStage.Lead => "Lead",
        OpportunityStage.Qualified => "Qualified",
        OpportunityStage.Proposal => "Proposal",
        OpportunityStage.Negotiation => "Negotiation",
        OpportunityStage.ClosedWon => "Closed Won",
        OpportunityStage.ClosedLost => "Closed Lost",
        _ => stage.ToString()
    };

    private string DisplayCustomer(Opportunity opp) =>
        opp.Customer?.Name ?? opp.CustomerName ?? "—";

    private static string? OwnerName(Opportunity opp)
    {
        if (opp.OwnerEmployee == null) return null;
        var name = $"{opp.OwnerEmployee.FirstName} {opp.OwnerEmployee.LastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? null : name;
    }

    private static string SourceLabel(OpportunitySource source) => source switch
    {
        OpportunitySource.ExistingCustomer => "Existing customer",
        OpportunitySource.WalkIn => "Walk-in",
        OpportunitySource.Repeat => "Repeat work",
        _ => source.ToString()
    };

    private static string DealTypeLabel(OpportunityDealType type) => type switch
    {
        OpportunityDealType.NewWork => "New work",
        OpportunityDealType.CallOut => "Call-out",
        _ => type.ToString()
    };

    private static string PriorityBadgeClass(OpportunityPriority priority) => priority switch
    {
        OpportunityPriority.High => "bg-danger-subtle text-danger",
        OpportunityPriority.Low => "bg-secondary-subtle text-secondary",
        _ => "bg-warning-subtle text-dark"
    };

    private static bool FollowUpOverdue(Opportunity opp)
    {
        if (opp.NextFollowUp is not { } d) return false;
        if (opp.Stage is OpportunityStage.ClosedWon or OpportunityStage.ClosedLost) return false;
        return d.Date < DateTime.UtcNow.Date;
    }

    private int GetCount(OpportunityStage stage) => filtered.Count(o => o.Stage == stage);
    private decimal GetValue(OpportunityStage stage) => filtered.Where(o => o.Stage == stage).Sum(o => o.Value);
    private decimal GetWeighted(OpportunityStage stage) => filtered.Where(o => o.Stage == stage).Sum(o => o.WeightedValue);

    private static string DaysToClose(Opportunity opp)
    {
        var days = (opp.ExpectedClose.Date - DateTime.UtcNow.Date).Days;
        if (days < 0) return $"{-days}d overdue";
        if (days == 0) return "closes today";
        return $"{days}d";
    }

    private async Task SaveOppAsync()
    {
        if (selectedOpp == null || !CanManage) return;
        try
        {
            selectedOpp.Customer = null;
            selectedOpp.Quote = null;
            selectedOpp.OwnerEmployee = null;
            await OpportunityService.UpdateAsync(selectedOpp);
            opportunities = (await OpportunityService.GetAllAsync()).ToList();
            Filter();
            ToastService.ShowSuccess("Deal updated.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private List<Opportunity> GetByStage(OpportunityStage stage)
    {
        var list = filtered.Where(o => o.Stage == stage);
        return _sort switch
        {
            "amount-desc" => list.OrderByDescending(o => o.Value).ToList(),
            "amount-asc" => list.OrderBy(o => o.Value).ToList(),
            "title" => list.OrderBy(o => o.Title).ToList(),
            "newest" => list.OrderByDescending(o => o.CreatedDate).ToList(),
            "close" => list.OrderBy(o => o.ExpectedClose).ToList(),
            "followup" => list.OrderBy(o => o.NextFollowUp ?? DateTime.MaxValue).ToList(),
            "weighted" => list.OrderByDescending(o => o.WeightedValue).ToList(),
            _ => list.OrderBy(o => o.BoardOrder).ThenBy(o => o.ExpectedClose).ToList()
        };
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        Filter();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        Filter();
    }

    private void Filter()
    {
        IEnumerable<Opportunity> q = opportunities;
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var t = searchTerm.ToLower();
            q = q.Where(o =>
                o.Title.ToLower().Contains(t) ||
                (o.CustomerName != null && o.CustomerName.ToLower().Contains(t)) ||
                (o.Customer != null && o.Customer.Name.ToLower().Contains(t)));
        }

        var today = DateTime.UtcNow.Date;
        q = _closeFilter switch
        {
            "overdue" => q.Where(o => o.ExpectedClose.Date < today
                && o.Stage is not OpportunityStage.ClosedWon and not OpportunityStage.ClosedLost),
            "month" => q.Where(o => o.ExpectedClose.Year == today.Year && o.ExpectedClose.Month == today.Month),
            "next30" => q.Where(o => o.ExpectedClose.Date >= today && o.ExpectedClose.Date <= today.AddDays(30)),
            _ => q
        };

        q = _amountFilter switch
        {
            "10k" => q.Where(o => o.Value >= 10_000m),
            "50k" => q.Where(o => o.Value >= 50_000m),
            "100k" => q.Where(o => o.Value >= 100_000m),
            _ => q
        };

        q = _quoteFilter switch
        {
            "quoted" => q.Where(o => o.QuoteId is { } id && id != Guid.Empty),
            "unquoted" => q.Where(o => o.QuoteId == null || o.QuoteId == Guid.Empty),
            _ => q
        };

        if (_priorityFilter != "all" && Enum.TryParse<OpportunityPriority>(_priorityFilter, out var pri))
            q = q.Where(o => o.Priority == pri);

        var followToday = DateTime.UtcNow.Date;
        q = _followUpFilter switch
        {
            "overdue" => q.Where(o => o.NextFollowUp.HasValue
                && o.NextFollowUp.Value.Date < followToday
                && o.Stage is not OpportunityStage.ClosedWon and not OpportunityStage.ClosedLost),
            "week" => q.Where(o => o.NextFollowUp.HasValue
                && o.NextFollowUp.Value.Date >= followToday
                && o.NextFollowUp.Value.Date <= followToday.AddDays(7)),
            "none" => q.Where(o => o.NextFollowUp == null),
            _ => q
        };

        filtered = q.ToList();
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(searchTerm)
        || _closeFilter != "all"
        || _amountFilter != "all"
        || _quoteFilter != "all"
        || _priorityFilter != "all"
        || _followUpFilter != "all";

    private void ResetFilters()
    {
        searchTerm = "";
        _closeFilter = "all";
        _amountFilter = "all";
        _quoteFilter = "all";
        _priorityFilter = "all";
        _followUpFilter = "all";
        Filter();
    }

    private DotNetObjectReference<Opportunities>? _kanbanRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || !CanManage) return;
        _kanbanRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("meterpUi.bindKanban", "[data-testid='opportunities-pipeline']", _kanbanRef);
        }
        catch
        {
            /* JS not ready */
        }
    }

    [JSInvokable]
    public async Task OnKanbanDrop(string id, string stage, string? beforeId)
    {
        if (!CanManage) return;
        if (!Guid.TryParse(id, out var dealId)) return;
        if (!Enum.TryParse<OpportunityStage>(stage, true, out var st)) return;
        Guid? before = Guid.TryParse(beforeId, out var b) ? b : null;
        _suppressClick = true;
        await InvokeAsync(() => MoveDealAsync(dealId, st, before));
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => _kanbanRef?.Dispose();

    private void OnCardClick(Opportunity opp)
    {
        if (_suppressClick)
        {
            _suppressClick = false;
            return;
        }
        ViewOpp(opp);
    }

    private async Task MoveDealAsync(Guid id, OpportunityStage stage, Guid? insertBeforeId)
    {
        var deal = opportunities.FirstOrDefault(o => o.Id == id);
        var previousStage = deal?.Stage;
        var previousOrder = deal?.BoardOrder ?? 0;
        if (deal != null)
        {
            deal.Stage = stage;
            ApplyLocalBoardOrder(deal, stage, insertBeforeId);
            OpportunityPipeline.AlignProbabilityWithStage(deal, previousStage ?? stage);
            Filter();
        }

        try
        {
            await OpportunityService.MoveOnBoardAsync(id, stage, insertBeforeId);
            var fresh = await OpportunityService.GetByIdAsync(id);
            if (fresh != null)
            {
                var idx = opportunities.FindIndex(o => o.Id == id);
                if (idx >= 0) opportunities[idx] = fresh;
                else opportunities.Add(fresh);
                if (selectedOpp?.Id == id)
                    selectedOpp = fresh;
            }
            Filter();
            ToastService.ShowSuccess($"Moved to {StageLabel(stage)}.");
        }
        catch (Exception ex)
        {
            if (deal != null && previousStage is { } revert)
            {
                deal.Stage = revert;
                deal.BoardOrder = previousOrder;
                Filter();
            }
            ToastService.ShowError(ex.Message);
        }
    }

    private void ApplyLocalBoardOrder(Opportunity deal, OpportunityStage stage, Guid? insertBeforeId)
    {
        var siblings = opportunities.Where(o => o.Stage == stage && o.Id != deal.Id)
            .OrderBy(o => o.BoardOrder)
            .ToList();
        if (insertBeforeId is { } before && before != Guid.Empty)
        {
            var at = siblings.FindIndex(o => o.Id == before);
            if (at >= 0)
            {
                siblings.Insert(at, deal);
                for (var i = 0; i < siblings.Count; i++)
                    siblings[i].BoardOrder = (i + 1) * 10;
                return;
            }
        }
        deal.BoardOrder = siblings.Count == 0 ? 10 : siblings.Max(o => o.BoardOrder) + 10;
    }

    private Task OnDetailCustomerPicked(Guid id)
    {
        if (selectedOpp == null) return Task.CompletedTask;
        selectedOpp.CustomerId = id == Guid.Empty ? null : id;
        selectedOpp.CustomerName = customers.FirstOrDefault(c => c.Id == id)?.Name ?? selectedOpp.CustomerName;
        return Task.CompletedTask;
    }

    private async Task MarkWonAsync()
    {
        if (selectedOpp == null) return;
        selectedOpp.Stage = OpportunityStage.ClosedWon;
        await SaveOppAsync();
    }

    private async Task MarkLostAsync()
    {
        if (selectedOpp == null) return;
        if (string.IsNullOrWhiteSpace(selectedOpp.LossReason))
        {
            selectedOpp.Stage = OpportunityStage.ClosedLost;
            ToastService.ShowError("Enter a loss reason before marking lost.");
            return;
        }
        selectedOpp.Stage = OpportunityStage.ClosedLost;
        await SaveOppAsync();
    }

