@page "/notifications"
@using METERP.Application.Services
@using METERP.Domain
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ToastService ToastService
@inject ITenantNotificationService NotificationService
@inject NavigationManager Nav

<PageTitle>Notifications</PageTitle>

<PageHeader Title="Notifications" Subtitle="Expiry alerts, approvals, and system messages for this tenant." TestId="notifications-page-header">
    <Actions>
        <button class="btn btn-outline-secondary" @onclick="MarkAllRead" data-testid="notifications-mark-all">Mark all read</button>
        <button class="btn btn-outline-danger" @onclick="DismissAllAsync" data-testid="notifications-dismiss-all">Dismiss all</button>
    </Actions>
</PageHeader>

<span data-testid="notifications-ready" class="visually-hidden">ready</span>
<div class="list-group" data-testid="notifications-list">
    @foreach (var n in notifications)
    {
        <div class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "text-muted" : "")"
             data-testid="notification-item">
            <div style="cursor:pointer;" class="flex-grow-1" @onclick="() => OpenAsync(n)">
                <strong>@n.Title</strong>
                @if (!string.IsNullOrEmpty(n.Category))
                {
                    <span class="badge bg-light text-dark ms-1">@n.Category</span>
                }
                <br />
                <small>@n.Message</small>
            </div>
            <div class="text-end ms-2">
                <small class="text-muted d-block">@n.CreatedDate.ToString("MMM dd")</small>
                @if (!n.IsRead)
                {
                    <span class="badge bg-danger ms-1">New</span>
                }
                <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-decoration-none"
                        data-testid="notification-dismiss"
                        @onclick="() => DismissAsync(n)"
                        @onclick:stopPropagation="true">Dismiss</button>
            </div>
        </div>
    }
</div>

@if (!notifications.Any())
{
    <EmptyState Title="No notifications"
                Description="Compliance scans and approval workflows will appear here."
                Icon="🔔"
                TestId="notifications-empty" />
}

@code {
    private List<TenantNotification> notifications = new();

    protected override async Task OnInitializedAsync()
    {
        notifications = (await NotificationService.GetForCurrentUserAsync()).ToList();
    }

    private async Task OpenAsync(TenantNotification n)
    {
        await NotificationService.MarkReadAsync(n.Id);
        notifications = (await NotificationService.GetForCurrentUserAsync()).ToList();
        var url = NotificationLinks.ForEntity(n.RelatedEntityType, n.RelatedEntityId);
        if (!string.IsNullOrWhiteSpace(url))
            Nav.NavigateTo(url);
    }

    private async Task MarkAllRead()
    {
        try
        {
            await NotificationService.MarkAllReadAsync();
            notifications = (await NotificationService.GetForCurrentUserAsync()).ToList();
        }
        finally
        {
            ToastService.ShowSuccess("All notifications marked read.");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DismissAsync(TenantNotification n)
    {
        await NotificationService.DismissAsync(n.Id);
        notifications = (await NotificationService.GetForCurrentUserAsync()).ToList();
        ToastService.ShowSuccess("Notification dismissed.");
    }

    private async Task DismissAllAsync()
    {
        try
        {
            await NotificationService.DismissAllAsync();
            notifications = (await NotificationService.GetForCurrentUserAsync()).ToList();
            ToastService.ShowSuccess("All notifications dismissed.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }
}