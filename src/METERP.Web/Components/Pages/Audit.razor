@page "/audit"
@using METERP.Application.Services
@using METERP.Common
@using Microsoft.AspNetCore.Authorization
@inject IAuditService AuditService
@inject ToastService ToastService
@inject IJSRuntime JS
@attribute [Authorize(Policy = "Audit.View")]

<PageTitle>Audit Log</PageTitle>

<PageHeader Title="Audit log" Subtitle="What changed, who did it, and when — tenant-isolated." TestId="audit-page-header">
    <Actions>
        <button class="btn btn-outline-secondary" data-testid="audit-export-csv" @onclick="ExportLog">Export CSV</button>
    </Actions>
</PageHeader>

<div class="row g-2 mb-3" data-testid="audit-filters">
    <div class="col-md-2">
        <input class="form-control form-control-sm" placeholder="Entity type (Quote, Job…)"
               @bind="_entityType" @bind:event="oninput" data-testid="audit-filter-entity-type" />
    </div>
    <div class="col-md-2">
        <input class="form-control form-control-sm" placeholder="Action (CREATE, PAYMENT…)"
               @bind="_action" @bind:event="oninput" data-testid="audit-filter-action" />
    </div>
    <div class="col-md-3">
        <input class="form-control form-control-sm" placeholder="Reference (Q-2026…)"
               @bind="_entityReference" @bind:event="oninput" data-testid="audit-filter-reference" />
    </div>
    <div class="col-md-3">
        <input class="form-control form-control-sm" placeholder="User email"
               @bind="_userEmail" @bind:event="oninput" data-testid="audit-filter-user" />
    </div>
    <div class="col-md-2">
        <button type="button" class="btn btn-sm btn-primary w-100" data-testid="audit-filter-apply" @onclick="ApplyFilters">Search</button>
    </div>
</div>

<div class="table-responsive" data-testid="audit-ready">
    <div data-testid="audit-table">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th>Date (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr class="meterp-row-click" data-testid="audit-row" title="Open audit entry" @onclick="() => OpenLog(log)">
                        <td>@log.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@log.UserEmail</td>
                        <td><span class="badge bg-info">@log.Action</span></td>
                        <td>@log.EntityType @log.EntityReference</td>
                        <td>@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_selected != null)
{
    <FormModal IsOpen="true"
               Title="@($"{_selected.Action} · {_selected.EntityType}")"
               Size="lg"
               TestId="audit-detail"
               OnClose="CloseLog">
        <ChildContent>
            <p class="mb-1">When (UTC): <strong>@_selected.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</strong></p>
            <p class="mb-1">User: @_selected.UserEmail</p>
            <p class="mb-1">Entity: @_selected.EntityType @_selected.EntityReference</p>
            <p class="mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(_selected.Details) ? "—" : _selected.Details)</p>
        </ChildContent>
        <Footer>
            <button type="button" class="btn btn-outline-secondary" @onclick="CloseLog">Close</button>
        </Footer>
    </FormModal>
}

@code {
    private List<AuditLogRow> logs = new();
    private AuditLogRow? _selected;

    private void OpenLog(AuditLogRow log) => _selected = log;
    private void CloseLog() => _selected = null;
    private string _entityType = "";
    private string _entityReference = "";
    private string _userEmail = "";
    private string _action = "";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        logs = (await AuditService.SearchAsync(
            string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
            string.IsNullOrWhiteSpace(_entityReference) ? null : _entityReference,
            string.IsNullOrWhiteSpace(_userEmail) ? null : _userEmail,
            action: string.IsNullOrWhiteSpace(_action) ? null : _action)).ToList();
    }

    private async Task ApplyFilters() => await LoadAsync();

    private async Task ExportLog()
    {
        try
        {
            // Export current filter view (not only unfiltered recent).
            var rows = await AuditService.SearchAsync(
                string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
                string.IsNullOrWhiteSpace(_entityReference) ? null : _entityReference,
                string.IsNullOrWhiteSpace(_userEmail) ? null : _userEmail,
                page: 1,
                pageSize: 5000,
                action: string.IsNullOrWhiteSpace(_action) ? null : _action);

            var sb = new System.Text.StringBuilder();
            sb.AppendLine("OccurredAtUtc,UserEmail,Action,EntityType,EntityReference,Details");
            foreach (var r in rows)
            {
                sb.Append(Csv(r.OccurredAtUtc.ToString("O"))).Append(',')
                    .Append(Csv(r.UserEmail)).Append(',')
                    .Append(Csv(r.Action)).Append(',')
                    .Append(Csv(r.EntityType)).Append(',')
                    .Append(Csv(r.EntityReference)).Append(',')
                    .Append(Csv(r.Details))
                    .AppendLine();
            }

            await JS.InvokeVoidAsync("meterpUi.downloadText",
                $"audit-log-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv",
                sb.ToString(),
                "text/csv;charset=utf-8");
            ToastService.ShowSuccess($"Exported {rows.Count} audit row(s).");
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }

    private static string Csv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        return value;
    }
}