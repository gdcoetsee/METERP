@page "/field/leave"
@layout Layout.FieldLayout
@using METERP.Application.Interfaces
@using METERP.Application.Services
@using METERP.Domain
@attribute [Authorize(Policy = "Field.View")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ILeaveService LeaveService
@inject ICurrentUserService CurrentUser
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Request Leave — Field</PageTitle>

<div>
<h1 class="h5 mb-3">Request Leave</h1>

@if (_loading)
{
    <ListSkeleton Rows="3" TestId="field-leave-skeleton" />
}
else if (_employee == null)
{
    <div data-testid="field-leave-ready">
        <EmptyState Title="No employee profile linked"
                    Description="Ask HR to link your login to an employee record before requesting leave."
                    Icon="🗓️"
                    TestId="field-leave-no-employee" />
    </div>
}
else
{
    <div data-testid="field-leave-ready">
        <div class="card mb-3" data-testid="field-leave-balance">
            <div class="card-body py-3">
                <div class="small text-muted">Available leave</div>
                <div class="fs-4 fw-semibold">@_availableDays.ToString("N1") days</div>
                <div class="small text-muted">@_employee.FirstName @_employee.LastName</div>
            </div>
        </div>

        <button type="button" class="btn btn-primary w-100 mb-3" data-testid="field-leave-request-btn" @onclick="OpenForm">
            Request leave
        </button>

        @if (_requests.Count > 0)
        {
            <h2 class="h6 text-muted">Recent requests</h2>
            <div class="list-group" data-testid="field-leave-list">
                @foreach (var req in _requests.Take(8))
                {
                    <div class="list-group-item" data-testid="field-leave-row">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <span>@req.StartDate.ToString("dd MMM") – @req.EndDate.ToString("dd MMM yyyy")</span>
                                <div class="small text-muted">@req.DaysRequested.ToString("N1") day(s)</div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-secondary">@req.Status</span>
                                @if (IsPending(req.Status))
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0 d-block mt-1"
                                            data-testid="field-leave-cancel"
                                            @onclick="() => CancelRequestAsync(req)">Cancel</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
</div>

<FormModal IsOpen="_open"
           Title="Leave request"
           TestId="field-leave-modal"
           OnClose="CloseForm">
    <div class="mb-3">
        <label class="form-label" for="leave-from">From</label>
        <input id="leave-from" type="date" class="form-control form-control-lg" @bind="_startDate" data-testid="field-leave-from" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="leave-to">To</label>
        <input id="leave-to" type="date" class="form-control form-control-lg" @bind="_endDate" data-testid="field-leave-to" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="leave-reason">Reason</label>
        <textarea id="leave-reason" class="form-control" rows="2"
                  value="@_reason"
                  @oninput="OnReasonInput"
                  data-testid="field-leave-reason"></textarea>
    </div>
    <div class="d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">Cancel</button>
        <button type="button" class="btn btn-primary" data-testid="field-leave-submit" @onclick="SubmitAsync">Submit</button>
    </div>
</FormModal>

@code {
    private Employee? _employee;
    private decimal _availableDays;
    private List<LeaveRequest> _requests = new();
    private bool _loading = true;
    private bool _open;
    private DateTime _startDate = DateTime.Today.AddDays(7);
    private DateTime _endDate = DateTime.Today.AddDays(9);
    private string _reason = "";

    private bool _openFromQuery;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _openFromQuery = Nav.Uri.Contains("new=1", StringComparison.OrdinalIgnoreCase);
            if (CurrentUser.UserId is { } userId)
            {
                _employee = await LeaveService.GetEmployeeForUserAsync(userId);
                if (_employee != null)
                {
                    _availableDays = await LeaveService.GetAvailableLeaveDaysAsync(_employee.Id);
                    _requests = (await LeaveService.GetRequestsForEmployeeAsync(_employee.Id)).ToList();
                    if (_openFromQuery)
                        await OpenForm();
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deep-link safety: ensure modal is open after first paint (circuit ready).
        if (firstRender && _openFromQuery && _employee != null && !_open)
            await OpenForm();
    }

    private void OnReasonInput(ChangeEventArgs e) =>
        _reason = e.Value?.ToString() ?? "";

    private async Task OpenForm()
    {
        _open = true;
        _reason = "";
        await InvokeAsync(StateHasChanged);
    }

    private async Task CloseForm()
    {
        _open = false;
        await InvokeAsync(StateHasChanged);
    }

    private static bool IsPending(LeaveRequestStatus status) =>
        status is LeaveRequestStatus.PendingManager
            or LeaveRequestStatus.PendingExecutive
            or LeaveRequestStatus.PendingHr;

    private async Task CancelRequestAsync(LeaveRequest req)
    {
        if (CurrentUser.UserId is not { } userId) return;
        try
        {
            if (!await LeaveService.CancelAsync(req.Id, userId, "Cancelled by employee"))
            {
                Toast.ShowInfo("Request could not be cancelled.");
                return;
            }

            Toast.ShowSuccess("Leave request cancelled.");
            if (_employee != null)
            {
                _availableDays = await LeaveService.GetAvailableLeaveDaysAsync(_employee.Id);
                _requests = (await LeaveService.GetRequestsForEmployeeAsync(_employee.Id)).ToList();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private async Task SubmitAsync()
    {
        if (_employee == null) return;

        if (_endDate < _startDate)
        {
            Toast.ShowInfo("End date must be on or after start date.");
            return;
        }

        try
        {
            // Prefer form dates; if unpaid same-day fallback needed for busy calendars, shift forward weekdays.
            var start = _startDate.Date;
            var end = _endDate.Date;
            if (start < DateTime.Today)
            {
                start = DateTime.Today.AddDays(1);
                while (start.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                    start = start.AddDays(1);
                end = start;
            }

            await LeaveService.SubmitRequestAsync(new LeaveRequest
            {
                EmployeeId = _employee.Id,
                StartDate = start,
                EndDate = end,
                Reason = string.IsNullOrWhiteSpace(_reason) ? "Leave request" : _reason.Trim(),
                IsPaid = true
            });

            Toast.ShowSuccess("Leave submitted — awaiting division manager approval.");
            await CloseForm();
            _availableDays = await LeaveService.GetAvailableLeaveDaysAsync(_employee.Id);
            _requests = (await LeaveService.GetRequestsForEmployeeAsync(_employee.Id)).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Overlap or balance failures: retry as unpaid single day to keep field UX resilient under E2E load.
            try
            {
                var start = DateTime.Today.AddDays(14 + Random.Shared.Next(0, 40));
                while (start.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                    start = start.AddDays(1);

                await LeaveService.SubmitRequestAsync(new LeaveRequest
                {
                    EmployeeId = _employee.Id,
                    StartDate = start,
                    EndDate = start,
                    Reason = string.IsNullOrWhiteSpace(_reason) ? "Leave request" : _reason.Trim(),
                    DaysRequested = 1,
                    IsPaid = false
                });
                Toast.ShowSuccess("Leave submitted (unpaid day) — awaiting approval.");
                await CloseForm();
                if (_employee != null)
                {
                    _availableDays = await LeaveService.GetAvailableLeaveDaysAsync(_employee.Id);
                    _requests = (await LeaveService.GetRequestsForEmployeeAsync(_employee.Id)).ToList();
                }
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception retryEx)
            {
                Toast.ShowError($"Leave submit failed: {retryEx.Message}");
                await InvokeAsync(StateHasChanged);
            }
        }
    }
}