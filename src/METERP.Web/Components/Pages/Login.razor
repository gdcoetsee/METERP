@page "/login"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using System
@using System.ComponentModel.DataAnnotations
@using METERP.Application.Services
@using METERP.Infrastructure.Identity
@using METERP.Infrastructure.Persistence
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IPendingTwoFactorChallengeStore ChallengeStore
@inject IServiceScopeFactory ScopeFactory
@inject METERP.Application.Interfaces.ITenantProvider TenantProvider
@inject NavigationManager Navigation

<PageTitle>Sign in — METERP</PageTitle>
@layout Layout.EmptyLayout
@inject IConfiguration Config

<span data-testid="login-ready" class="visually-hidden">ready</span>

<div class="auth-shell">
    <section class="auth-hero">
        <p class="auth-kicker">Contractor ERP</p>
        <h1>Quotes, jobs, travel, and invoices — without the paperwork pile.</h1>
        <p>Office, field, and customers each get a door. Grok Bot sits on top when you connect your xAI, Google, or OpenAI subscription.</p>
    </section>
    <section class="auth-card">
        <h2>Staff sign in</h2>
        <p class="text-muted">Demo: <strong>admin@acme.demo</strong> / <strong>Demo123!</strong></p>
        @if (loginFailed)
        {
            <div class="alert alert-danger mb-3">Invalid email or password. Please try again.</div>
        }
        <label class="form-label">Email</label>
        <input class="form-control mb-3" @bind="loginModel.Email" data-testid="login-email" autocomplete="username" />
        <label class="form-label">Password</label>
        <input type="password" class="form-control mb-3" @bind="loginModel.Password" data-testid="login-password" autocomplete="current-password" />
        <button class="btn btn-primary w-100 py-2 mb-3" @onclick="HandleLogin" data-testid="login-submit">Sign in</button>
        @if (HasGoogle || HasMicrosoft || HasX)
        {
            <p class="text-center text-muted small my-2">or continue with your work account</p>
            <div class="d-grid gap-2 mb-3">
                @if (HasGoogle)
                {
                    <a class="btn btn-outline-dark" href="/external-login/Google" data-testid="login-google">Continue with Google</a>
                }
                @if (HasMicrosoft)
                {
                    <a class="btn btn-outline-dark" href="/external-login/Microsoft" data-testid="login-microsoft">Continue with Microsoft</a>
                }
                @if (HasX)
                {
                    <a class="btn btn-outline-dark" href="/external-login/X" data-testid="login-x">Continue with X</a>
                }
            </div>
        }
        <p class="small text-muted mb-0">2FA is asked after password when enabled. Customers use <a href="/portal/login">the customer portal</a>. New staff: ask an admin. <a href="/help">User manual</a></p>
    </section>
</div>

@code {
    private LoginModel loginModel { get; set; } = new();
    private bool loginFailed;
    private bool HasGoogle => !string.IsNullOrWhiteSpace(Config["Authentication:Google:ClientId"]);
    private bool HasMicrosoft => !string.IsNullOrWhiteSpace(Config["Authentication:Microsoft:ClientId"]);
    private bool HasX => !string.IsNullOrWhiteSpace(Config["Authentication:X:ConsumerKey"]);

    private async Task HandleLogin()
    {
        loginFailed = false;

        if (string.IsNullOrWhiteSpace(loginModel.Email) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            loginFailed = true;
            return;
        }

        // Pre-login lookup uses an isolated scope (avoids disposed circuit-scoped DbContext).
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
        var normalized = UserManager.NormalizeEmail(loginModel.Email);
        var user = await db.Users
            .IgnoreQueryFilters()
            .FirstOrDefaultAsync(u => u.NormalizedEmail == normalized);

        if (user == null)
        {
            TenantProvider.SetTenantId(Guid.Empty);
            user = await UserManager.FindByEmailAsync(loginModel.Email);
        }

        if (user == null)
        {
            loginFailed = true;
            loginModel.Password = string.Empty;
            return;
        }

        var passwordValid = await UserManager.CheckPasswordAsync(user, loginModel.Password ?? string.Empty);

        if (!passwordValid)
        {
            loginFailed = true;
            loginModel.Password = string.Empty;
            return;
        }

        if (await UserManager.GetTwoFactorEnabledAsync(user))
        {
            var token = ChallengeStore.CreateChallenge(user.Id);
            Navigation.NavigateTo($"/login-2fa?token={Uri.EscapeDataString(token)}", forceLoad: true);
            return;
        }

        var ticket = ChallengeStore.CreateChallenge(user.Id);
        Navigation.NavigateTo($"/login-complete?twofa={Uri.EscapeDataString(ticket)}", forceLoad: true);
    }

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    // Ensure the model is initialized even on initial SSR render before interactivity kicks in
    protected override void OnInitialized()
    {
        loginModel ??= new LoginModel();
    }

}
