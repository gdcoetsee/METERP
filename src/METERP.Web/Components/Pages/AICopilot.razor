    private async Task<Guid> ResolveCustomerIdForQuoteAsync()
    {
        if (_pendingOpportunityId.HasValue)
        {
            var opp = await OpportunityService.GetByIdAsync(_pendingOpportunityId.Value);
            if (opp?.CustomerId is Guid linkedCustomerId && linkedCustomerId != Guid.Empty)
                return linkedCustomerId;
        }

        if (!availableCustomers.Any())
            availableCustomers = (await CustomerService.GetAllAsync(null, 1, 1000)).ToList();

        return availableCustomers.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task CreateQuoteFromAiText(string? aiText)
    {
        var text = string.IsNullOrWhiteSpace(aiText) ? lastResponse : aiText;
        if (string.IsNullOrWhiteSpace(text)) return;

        try
        {
            var customerId = await ResolveCustomerIdForQuoteAsync();
            if (customerId == Guid.Empty)
            {
                ToastService.ShowError("No customers available — create a customer first.");
                return;
            }

            lastCreatedQuote = await AiQuoteApplyService.CreateQuoteFromAiTextAsync(text, customerId);
            lastAiTextForPdf = text;

            if (_pendingOpportunityId.HasValue && lastCreatedQuote != null)
            {
                await OpportunityService.MarkConvertedToQuoteAsync(_pendingOpportunityId.Value, lastCreatedQuote.Id);
                _pendingOpportunityId = null;
                try { await JS.InvokeVoidAsync("localStorage.removeItem", "pendingOpportunityId"); } catch { }
                ToastService.ShowSuccess("Draft quote created and opportunity linked. See /quotes.");
            }
            else
            {
                ToastService.ShowSuccess("Draft Quote created with AI-suggested lines! See /quotes.");
            }

            Navigation.NavigateTo("/quotes", forceLoad: true);
        }
        catch (AiFeatureDisabledException ex)
        {
            ToastService.ShowError(ex.Message);
        }
        catch (QuotaExceededException ex)
        {
            ToastService.ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to create Quote from AI: " + ex.Message);
        }
    }

