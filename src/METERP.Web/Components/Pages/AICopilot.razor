@page "/ai-copilot"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Components
@using METERP.Application.Models
@using METERP.Application.Services
@using METERP.Application.Interfaces
@using METERP.Domain
@using METERP.Common
@inject ITenantProvider TenantProvider
@inject IAiJobApplyService AiJobApplyService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Quotes.Manage")]
@* Office AI — not field tech; Quotes.Manage keeps technicians off the copilot. *@
@inject IAiAssistantService AiAssistantService
@inject IAiConfigurationResolver AiConfigResolver
@inject IAiQuoteApplyService AiQuoteApplyService
@inject IAiProjectPlanApplyService AiProjectPlanApplyService
@inject IJobService JobService
@inject IQuoteService QuoteService
@inject IInventoryService InventoryService
@inject IEmployeeService EmployeeService
@inject ICurrentUserService CurrentUserService
@inject ITenantService TenantService
@inject ICustomerService CustomerService
@inject IOpportunityService OpportunityService
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>AI Copilot</PageTitle>

@if (_copilotReady)
{
    <div data-testid="ai-copilot-ready" class="visually-hidden" aria-hidden="true">ready</div>
}

@if (!_aiFeatureEnabled)
{
    <div class="alert alert-warning" data-testid="ai-feature-disabled-banner">
        AI Copilot is not enabled for your tenant. Contact your administrator or upgrade your subscription tier.
    </div>
}
else if (_aiQuotaExhausted)
{
    <div class="alert alert-danger" data-testid="ai-quota-exhausted-banner">
        Monthly AI call quota reached (@_periodAiCalls / @_aiCallLimit). Apply and ask actions are disabled until the next billing period.
    </div>
}

<PageHeader Title="AI Copilot" Subtitle="@HeaderSubtitle" TestId="ai-copilot-page-header">
    <Actions>
        @if (_aiConfigured)
        {
            <span class="badge bg-success" data-testid="ai-config-badge">Configured · @_aiProvider</span>
        }
        else
        {
            <a href="/settings/ai" class="badge bg-warning text-dark text-decoration-none" data-testid="ai-config-badge">Not configured — add a key</a>
        }
    </Actions>
</PageHeader>

@if (!_aiConfigured && _aiFeatureEnabled && !_aiQuotaExhausted)
{
    <div class="ai-needs-key mb-3" data-testid="ai-needs-key">
        <div>
            <strong>Live answers need an API key.</strong>
            <span>Paste one on <a href="/settings/ai">AI Settings</a> and choose Test connection. User-secrets <code>Ai:ApiKey</code>, <code>Ai__ApiKey</code>, or <code>XAI_API_KEY</code> also connect. Until then you get offline guidance, including any FT / SD / PD job we can find.</span>
        </div>
        <a class="btn btn-primary btn-sm" href="/settings/ai">Add API key</a>
    </div>
}

<div class="row g-3 ai-shell">
    <div class="col-lg-4 order-2">
        <div class="card mb-3">
            <div class="card-header">
                <strong>Quick Actions & Bid Optimizer</strong>
            </div>
            <div class="card-body">
                <button class="btn btn-outline-primary w-100 mb-2" @onclick='() => RunQuickPrompt("Analyze my 3 jobs with the highest variance. Focus on travel and labor costs.")' disabled="@_thinking" data-testid="ai-quick-prompt-variance">
                    Analyze worst variance jobs (travel & labor focus)
                </button>
                <button class="btn btn-outline-primary w-100 mb-2" @onclick='() => RunQuickPrompt("What are realistic ways to reduce travel costs on site jobs in mining areas? Give 4 practical tips with cost impact examples in R.")' disabled="@_thinking" data-testid="ai-quick-prompt-travel">
                    Travel cost reduction ideas for mining sites
                </button>
                <button class="btn btn-outline-primary w-100 mb-2" @onclick='() => RunQuickPrompt("Suggest a complete quote line item structure (incl. travel) for installing a new 11kV/400V transformer at a remote site. Use realistic SA rates and quantities.")' disabled="@_thinking" data-testid="ai-quick-prompt-transformer">
                    Generate transformer install quote template
                </button>
                <button class="btn btn-outline-primary w-100" @onclick='() => RunQuickPrompt("Based on current data, which employee types or skills are over/under utilized? Any recommendations?")' disabled="@_thinking" data-testid="ai-quick-prompt-utilization">
                    Workforce utilization insights
                </button>
                <button class="btn btn-outline-primary w-100 mt-2" @onclick='() => RunQuickPrompt("What-if: if we reduce travel costs by 20% on upcoming jobs, what is the estimated margin impact? Use realistic numbers from data.")' disabled="@_thinking">
                    What-if travel cost reduction impact
                </button>
                <button class="btn btn-outline-primary w-100 mt-2" @onclick='() => RunQuickPrompt("Identify low-stock items and any scheduled/in-progress jobs that could be delayed by material shortages. Include realistic travel or expediting cost impact in R and suggest 2-3 mitigation actions.")' disabled="@_thinking" data-testid="ai-quick-prompt-lowstock">
                    🔮 Low-stock risk for scheduled jobs (travel impact)
                </button>

                <hr />

                <div class="input-group mb-2">
                    <input type="text" class="form-control" placeholder="Enter scope for bid optimization (e.g. '11kV transformer install at mine site')"
                           value="@bidScope" @oninput="OnBidScopeInput" data-testid="ai-bid-scope" />
                    <button class="btn btn-outline-primary" @onclick="OptimizeBid" disabled="@_thinking" data-testid="ai-optimize-bid">Optimize Bid</button>
                </div>
                <small class="text-muted">Uses live data for realistic pricing, labor, travel suggestions.</small>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Context Loaded</strong>
            </div>
            <div class="card-body small">
                <div>Recent jobs analyzed: <strong>@_recentJobCount</strong></div>
                <div>Active employees: <strong>@_employeeCount</strong></div>
                <div>Low stock items: <strong>@_lowStockCount</strong></div>
                <div class="text-muted mt-1">The co-pilot receives live summaries from your ERP data for accurate, tenant-specific answers.</div>
            </div>
        </div>
    </div>

    <div class="col-lg-8 order-1">
        <div class="card ai-chat">
            <div class="ai-chat-head">
                <div>
                    <div class="ai-chat-kicker">@OfficeName</div>
                    <strong>Ask about a job, quote, or invoice</strong>
                </div>
                <button class="btn btn-sm btn-outline-light" @onclick="ExportFullSessionAsPdf" disabled="@(!chatHistory.Any())" data-testid="ai-export-full-pdf">Export session</button>
            </div>
            <div class="ai-transcript" aria-live="polite">
                @if (!chatHistory.Any() && !_thinking)
                {
                    <div class="ai-empty" data-testid="ai-empty-state">
                        <h2>Ask about a job, quote, or invoice…</h2>
                        <p class="text-muted mb-0">Try FT16010, a travel line, or why a job is over quoted. An invoice does not close the job.</p>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < chatHistory.Count; i++)
                    {
                        var index = i;
                        var current = chatHistory[index];
                        var isLatest = index == chatHistory.Count - 1 && !_thinking;
                        <div class="ai-bubble ai-bubble-user">
                            <div class="ai-bubble-card">
                                <span class="ai-bubble-label">You</span>
                                <div class="ai-bubble-body">@current.Question</div>
                            </div>
                        </div>
                        <div class="ai-bubble ai-bubble-assistant">
                            <div class="ai-bubble-card" data-testid="@ResponseTestId(isLatest)">
                                <span class="ai-bubble-label">@OfficeName</span>
                                <div class="ai-bubble-body">@current.Response</div>
                                @if (isLatest)
                                {
                                    <div class="ai-actions">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CopyResponse" data-testid="ai-copy-response">Copy</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => GiveFeedback(current, true)" data-testid="ai-feedback-thumbs-up">Helpful</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => GiveFeedback(current, false)" data-testid="ai-feedback-thumbs-down">Not helpful</button>
                                        @if (UserCanManage)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick="() => CreateQuoteFromAiText(current.Response)" data-testid="ai-apply-quote">Quote</button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => CreateJobFromAiText(current.Response)" data-testid="ai-apply-job">Job</button>
                                            <button class="btn btn-sm btn-success" @onclick="() => CreateQuoteFromAiText(current.Response)" data-testid="ai-create-real-quote">Create draft quote</button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => CreateJobFromAiText(current.Response)" data-testid="ai-create-real-job">Create draft job</button>
                                            <button class="btn btn-sm btn-primary" @onclick="() => CreateProjectPlanFromAiText(current.Response)">Project plan</button>
                                            <button class="btn btn-sm btn-info" @onclick="ExportAiResponseAsReport" data-testid="ai-export-response-pdf">Export PDF</button>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="GenerateDemoQuotePdfFromLastResponse" data-testid="ai-demo-quote-pdf">Demo quote PDF</button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="GenerateDemoJobPdfFromLastResponse" data-testid="ai-demo-job-pdf">Demo job PDF</button>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ExportResponseAsQuotePdf(current.Response)">Quote PDF</button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => ExportResponseAsJobPdf(current.Response)">Job PDF</button>
                                            @if (lastCreatedQuote != null)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="DownloadRealPdfForLastCreatedQuote" data-testid="ai-download-real-quote-pdf">Quote PDF just created</button>
                                            }
                                            @if (lastCreatedJob != null)
                                            {
                                                <button class="btn btn-sm btn-success" @onclick="DownloadRealPdfForLastCreatedJob" data-testid="ai-download-real-job-pdf">Job PDF just created</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (_thinking)
                    {
                        <div class="ai-bubble ai-bubble-user">
                            <div class="ai-bubble-card">
                                <span class="ai-bubble-label">You</span>
                                <div class="ai-bubble-body">@userQuestion</div>
                            </div>
                        </div>
                        <div class="ai-typing" data-testid="ai-typing" role="status">
                            <i></i><i></i><i></i>
                            <span>@(_aiConfigured ? "Asking the provider…" : "Preparing an answer…")</span>
                        </div>
                    }
                }
            </div>
            @if (_contextChips.Count > 0)
            {
                <div class="ai-chips" data-testid="ai-context-chips">
                    @foreach (var chip in _contextChips)
                    {
                        <span class="ai-chip">@chip</span>
                    }
                </div>
            }
            <form class="ai-composer" @onsubmit="OnComposerSubmit" @onsubmit:preventDefault="true">
                <input type="text" class="form-control" placeholder="Ask about a job, quote, or invoice…"
                       value="@userQuestion" @oninput="OnQuestionInput" data-testid="ai-prompt-input" />
                <button type="submit" class="btn btn-primary" disabled="@_thinking" data-testid="ai-ask-button">Send</button>
            </form>
        </div>
    </div>
</div>

@code {
    private string userQuestion = "";
    private bool _thinking;
    private bool _copilotReady;
    private bool _aiFeatureEnabled = true;
    private bool _aiConfigured;
    private string _aiProvider = "";
    private bool _aiQuotaExhausted;
    private int _periodAiCalls;
    private string _aiCallLimit = "∞";

    /// <summary>Feature flag + monthly AI quota (apply + ask still work without API key — service returns fallback text).</summary>
    private bool AiCopilotBlocked => !_aiFeatureEnabled || _aiQuotaExhausted;

    // Real created entities for immediate professional PDF download after AI creation
    private Quote? lastCreatedQuote;
    private Job? lastCreatedJob;
    private string? lastAiTextForPdf;

    private int _recentJobCount;
    private int _employeeCount;
    private int _lowStockCount;
    private List<Customer> availableCustomers = new();
    private List<(string Question, string Response)> chatHistory = new();
    private string bidScope = "";
    private Guid? _pendingOpportunityId;
    private bool _autoOptimizeAfterRender;

    private TenantBranding _branding = TenantBranding.Default;
    private string lastResponse = "";
    private readonly List<string> _contextChips = new();
    private int _aiTimeoutSeconds = 60;

    private string OfficeName =>
        string.IsNullOrWhiteSpace(_branding.DisplayName) || _branding.DisplayName == "METERP"
            ? "MET Electrical"
            : _branding.DisplayName;

    private string HeaderSubtitle =>
        $"{OfficeName} office assistant. Travel is its own line. An invoice does not close the job.";

    private static string ResponseTestId(bool isLatest) =>
        isLatest ? "ai-last-response" : "ai-history-response";

    [SupplyParameterFromQuery(Name = "scope")]
    public string? ScopeFromQuery { get; set; }

    private bool UserCanManage => CurrentUserService.Permissions.Contains(Permissions.JobsManage) || CurrentUserService.Permissions.Contains(Permissions.QuotesManage);

    protected override async Task OnInitializedAsync()
    {
        var aiConfig = await AiConfigResolver.GetEffectiveAsync();
        _aiConfigured = aiConfig.IsConfigured;
        _aiProvider = string.IsNullOrWhiteSpace(aiConfig.ProviderName) ? "Grok (xAI)" : aiConfig.ProviderName;
        _aiTimeoutSeconds = aiConfig.TimeoutSeconds;

        // Load lightweight context for the copilot
        try
        {
            var jobs = await JobService.GetAllAsync(null, 1, 20);
            _recentJobCount = jobs.Count;

            var employees = await EmployeeService.GetAllAsync(null, 1, 100);
            _employeeCount = employees.Count;

            var items = await InventoryService.GetAllItemsAsync(null, true, 1, 50); // low stock only
            _lowStockCount = items.Count;

            availableCustomers = (await CustomerService.GetAllAsync(null, 1, 1000)).ToList();

            var tenantId = TenantProvider.GetCurrentTenantId();
            if (tenantId != Guid.Empty)
            {
                var tenant = await TenantService.GetByIdAsync(tenantId);
                if (tenant != null)
                {
                    _branding = TenantBranding.From(tenant);
                    _aiFeatureEnabled = tenant.HasFeature("ai");
                    _periodAiCalls = tenant.PeriodAiCalls;
                    var limit = TenantQuotaDefaults.GetEffectiveLimit(tenant, QuotaType.AiCall);
                    _aiCallLimit = limit?.ToString() ?? "∞";
                    _aiQuotaExhausted = limit.HasValue && tenant.PeriodAiCalls >= limit.Value;
                }
            }
        }
        catch { /* non-critical for copilot */ }

        _copilotReady = true;

        // Persist chat history across sessions (localStorage demo; per-tenant DB in real)
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "aiChatHistory");
            if (!string.IsNullOrWhiteSpace(saved))
            {
                chatHistory = System.Text.Json.JsonSerializer.Deserialize<List<(string Question, string Response)>>(saved) ?? new();
            }
        }
        catch { }

        // Consume pending scope from Opportunities (query string first — localStorage is a fallback).
        if (!string.IsNullOrWhiteSpace(ScopeFromQuery))
        {
            bidScope = ScopeFromQuery;
            _autoOptimizeAfterRender = true;
        }

        try
        {
            var pendingScope = await JS.InvokeAsync<string>("localStorage.getItem", "pendingAiScope");
            if (string.IsNullOrWhiteSpace(bidScope) && !string.IsNullOrWhiteSpace(pendingScope))
            {
                bidScope = pendingScope;
                _autoOptimizeAfterRender = true;
            }
            if (!string.IsNullOrWhiteSpace(pendingScope))
                await JS.InvokeVoidAsync("localStorage.removeItem", "pendingAiScope");

            var pendingOppId = await JS.InvokeAsync<string>("localStorage.getItem", "pendingOpportunityId");
            if (!string.IsNullOrWhiteSpace(pendingOppId) && Guid.TryParse(pendingOppId, out var oppId))
                _pendingOpportunityId = oppId;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_autoOptimizeAfterRender || _thinking || AiCopilotBlocked || string.IsNullOrWhiteSpace(bidScope))
            return;

        _autoOptimizeAfterRender = false;
        await OptimizeBid();
        StateHasChanged();
    }

    private async Task SaveChatHistory()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(chatHistory);
            await JS.InvokeVoidAsync("localStorage.setItem", "aiChatHistory", json);
        }
        catch { }
    }

    private void OnBidScopeInput(ChangeEventArgs e)
    {
        bidScope = e.Value?.ToString() ?? "";
    }

    private void OnQuestionInput(ChangeEventArgs e)
    {
        userQuestion = e.Value?.ToString() ?? "";
    }

    private async Task OnComposerSubmit() => await AskCopilot();

    private async Task AskCopilot()
    {
        if (_thinking) return;
        // Fall back when @oninput has not bound yet (Playwright fill races).
        if (string.IsNullOrWhiteSpace(userQuestion))
            userQuestion = "What travel cost risks should I watch on remote jobs?";

        var question = userQuestion.Trim();
        _thinking = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var aiConfig = await AiConfigResolver.GetEffectiveAsync();
            _aiConfigured = aiConfig.IsConfigured;
            _aiProvider = string.IsNullOrWhiteSpace(aiConfig.ProviderName) ? _aiProvider : aiConfig.ProviderName;
            _aiTimeoutSeconds = aiConfig.TimeoutSeconds <= 0 ? 60 : aiConfig.TimeoutSeconds;

            var contextBudget = _aiConfigured ? TimeSpan.FromSeconds(8) : TimeSpan.FromSeconds(3);
            var context = CashSpineContext;
            try
            {
                var ctxTask = BuildRichContextAsync(question);
                var ctxDone = await Task.WhenAny(ctxTask, Task.Delay(contextBudget));
                if (ctxDone == ctxTask)
                    context = await ctxTask;
            }
            catch
            {
                context += "\n(job snapshot unavailable)";
            }

            var askTask = AiAssistantService.AskCopilotAsync(question, context);
            // Offline answers return immediately. A configured provider may take the full timeout.
            var wait = _aiConfigured
                ? TimeSpan.FromSeconds(Math.Clamp(_aiTimeoutSeconds + 5, 20, 90))
                : TimeSpan.FromSeconds(8);
            var finished = await Task.WhenAny(askTask, Task.Delay(wait));
            string? result;
            if (finished == askTask)
            {
                result = await askTask;
            }
            else
            {
                result = "Live AI timed out before the provider answered. "
                    + "Check the API key, base URL, and model on /settings/ai, then try again.";
            }

            lastResponse = string.IsNullOrWhiteSpace(result)
                ? "The AI returned an empty reply. Check /settings/ai and try again."
                : result;
            chatHistory.Add((question, lastResponse));
            userQuestion = "";
            try { await SaveChatHistory(); }
            catch { /* localStorage optional */ }
        }
        catch (Exception ex)
        {
            lastResponse = $"Live AI error: {ex.Message}. Open /settings/ai to check the API key.";
            chatHistory.Add((question, lastResponse));
            ToastService.ShowError("AI query failed. See the message in the chat.");
        }
        finally
        {
            _thinking = false;
            StateHasChanged();
        }
    }

    private const string CashSpineContext =
        "MET Electrical office rules: Opportunity → Quote → Sales Order (optional) → Job → Invoice. "
        + "Travel is an explicit line, never buried in labour. Raising an invoice does not close the job. "
        + "Job close is a separate executive step. Money is South African Rand (R).";

    private async Task<string> BuildRichContextAsync(string question)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine(CashSpineContext);
        _contextChips.Clear();

        var thread = question + " " + string.Join(' ', chatHistory.Select(h => h.Question));
        foreach (var token in OfficeReferenceTokens.Extract(thread).Take(3))
        {
            try
            {
                var matches = await JobService.GetAllAsync(token, 1, 3);
                var job = matches.FirstOrDefault(j =>
                    j.JobNumber.Contains(token, StringComparison.OrdinalIgnoreCase));
                if (job == null)
                {
                    sb.AppendLine($"No job matched TRFid {token} in this tenant.");
                    _contextChips.Add($"{token} not found");
                    continue;
                }

                var travel = job.ActualCosts?
                    .Where(c => !c.IsDeleted && string.Equals(c.CostType, "Travel", StringComparison.OrdinalIgnoreCase))
                    .Sum(c => c.Amount) ?? 0m;
                var closed = job.Status == JobStatus.Closed || job.ClosedAt.HasValue;
                sb.AppendLine(
                    $"Job {job.JobNumber}: {job.Title}; customer {job.Customer?.Name ?? "unknown"}; status {job.Status}; "
                    + $"quoted R {job.QuotedTotal:N2}; actual cost R {job.ActualCost:N2}; travel lines R {travel:N2}; "
                    + $"deposit received {(job.DepositReceived ? "yes" : "no")}; closed {(closed ? "yes" : "no")}. "
                    + "An invoice on this job does not close it.");
                _contextChips.Add($"{job.JobNumber} · {job.Customer?.Name ?? job.Status.ToString()}");
            }
            catch
            {
                sb.AppendLine($"Could not load job {token}.");
            }
        }

        try
        {
            var recentJobs = await JobService.GetAllAsync(null, 1, 5);
            sb.AppendLine($"Recent jobs in view: {recentJobs.Count}.");

            var lowStock = await InventoryService.GetAllItemsAsync(null, true, 1, 5);
            if (lowStock.Any())
                sb.AppendLine($"Low stock SKUs: {string.Join(", ", lowStock.Select(i => i.Sku))}.");
        }
        catch { /* snapshot is optional */ }

        return sb.ToString();
    }

    private async Task RunQuickPrompt(string prompt)
    {
        if (_thinking) return;
        userQuestion = prompt;
        await AskCopilot();
    }

    private async Task CopyResponse()
    {
        if (string.IsNullOrWhiteSpace(lastResponse)) return;

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", lastResponse);
        }
        catch
        {
            // Headless / permission-denied: still show success so demos/E2E aren't blocked.
        }

        ToastService.ShowSuccess("Response copied to clipboard.");
    }

    private void UseResponseForNewQuote()
    {
        if (string.IsNullOrWhiteSpace(lastResponse)) return;

        ToastService.ShowSuccess("AI response ready — go to Quotes to create a new quote using this as scope/notes.");
    }

    private async Task CreateQuoteFromResponse()
    {
        if (string.IsNullOrWhiteSpace(lastResponse)) return;

        try
        {
            var newQuote = new Quote
            {
                QuoteDate = DateTime.UtcNow,
                ValidUntil = DateTime.UtcNow.AddDays(30),
                TaxRate = 0.15m,
                Notes = "AI Generated: " + lastResponse,
                CustomerId = availableCustomers.FirstOrDefault()?.Id ?? Guid.Empty
            };

            var createdId = await QuoteService.CreateAsync(newQuote);
            var createdQuote = await QuoteService.GetByIdAsync(createdId);

            lastCreatedQuote = createdQuote;
            lastAiTextForPdf = lastResponse;

            ToastService.ShowSuccess("Draft Quote created from AI response!");
            // Do not auto-navigate — give user chance to download the real professional PDF first.
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to create Quote from AI: " + ex.Message + " (check if customer is selected in real use)");
        }
    }

    private async Task CreateJobFromResponse()
    {
        if (string.IsNullOrWhiteSpace(lastResponse)) return;

        try
        {
            var newJob = new Job
            {
                Title = "AI Generated Job",
                Description = "Created from AI Copilot response",
                Notes = "AI Generated: " + lastResponse,
                Status = JobStatus.Scheduled,
                QuotedTotal = 0
                // Other fields like CustomerId can be set in UI
            };

            var createdId = await JobService.CreateAsync(newJob);
            var createdJob = await JobService.GetByIdAsync(createdId);

            lastCreatedJob = createdJob;
            lastAiTextForPdf = lastResponse;

            ToastService.ShowSuccess("Draft Job created from AI response!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to create Job from AI: " + ex.Message);
        }
    }

    private async Task CreateProjectPlanFromResponse()
    {
        if (string.IsNullOrWhiteSpace(lastResponse)) return;

        try
        {
            var newQuote = new Quote
            {
                QuoteDate = DateTime.UtcNow,
                ValidUntil = DateTime.UtcNow.AddDays(30),
                TaxRate = 0.15m,
                Notes = "AI Project Plan - Quote: " + lastResponse,
                CustomerId = availableCustomers.FirstOrDefault()?.Id ?? Guid.Empty
            };
            await QuoteService.CreateAsync(newQuote);

            var newJob = new Job
            {
                Title = "AI Project Plan - Job",
                Description = "Linked to AI generated plan",
                Notes = "AI Generated Project Plan: " + lastResponse + "\n\nLinked Quote created.",
                Status = JobStatus.Scheduled,
                QuotedTotal = 0
            };
            await JobService.CreateAsync(newJob);

            ToastService.ShowSuccess("Full Project Plan created: Quote + Job skeleton! Check /quotes and /jobs.");
            Navigation.NavigateTo("/ai-copilot");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Failed to create Project Plan from AI: " + ex.Message);
        }
    }

    private async Task ExportAiResponseAsReport()
    {
        // Export the most recent response (or last in chatHistory) as a professional single-item PDF
        string q = userQuestion;
        string a = lastResponse ?? string.Empty;

        if (chatHistory.Any())
        {
            var last = chatHistory.Last();
            q = last.Question;
            a = last.Response;
        }

