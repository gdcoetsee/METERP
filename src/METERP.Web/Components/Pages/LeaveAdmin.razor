@page "/leave-admin"
@using METERP.Application.Interfaces
@using METERP.Application.Services
@using METERP.Common
@using METERP.Domain
@using METERP.Web.Services
@attribute [Authorize(Policy = "Employees.Manage")]
@rendermode InteractiveServer
@inject ILeaveService LeaveService
@inject IEmployeeService EmployeeService
@inject ICurrentUserService CurrentUser
@inject ToastService Toast

<PageTitle>Leave Admin</PageTitle>

<PageHeader Title="Leave administration" Subtitle="Requests and balance adjustments. Employee and reason are required to change a balance." TestId="leave-admin-page-header">
    <Actions>
        <button type="button" class="btn btn-primary" data-testid="leave-admin-adjust-btn" @onclick="OpenAdjust">Adjust balance</button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <ListSkeleton Rows="5" TestId="leave-admin-loading" AriaLabel="Loading leave" />
}
else
{
    <div class="table-responsive" data-testid="leave-admin-ready">
        <table class="table table-hover" data-testid="leave-admin-table">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Dates</th>
                    <th class="text-end">Days</th>
                    <th>Status</th>
                    <th>Paid</th>
                    <th>Reason</th>
                    <th>Approver note</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _requests)
                {
                    <tr data-testid="leave-admin-row">
                        <td>@(r.Employee != null ? $"{r.Employee.FirstName} {r.Employee.LastName}" : "—")</td>
                        <td>@r.StartDate.ToString("yyyy-MM-dd") → @r.EndDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@r.DaysRequested.ToString("N1")</td>
                        <td><span class="badge bg-secondary">@r.Status</span></td>
                        <td>@(r.IsPaid ? "Yes" : "Unpaid")</td>
                        <td class="small">@(r.Reason ?? "—")</td>
                        <td class="small">@(string.IsNullOrWhiteSpace(r.ApproverNote) ? "—" : r.ApproverNote)</td>
                        <td class="text-end">
                            @if (CanCancel(r))
                            {
                                <button type="button" class="btn btn-link btn-sm p-0"
                                        data-testid="leave-admin-cancel"
                                        @onclick="() => CancelRequestAsync(r)">Cancel</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_requests.Count == 0)
        {
            <p class="text-muted">No leave requests yet.</p>
        }
    </div>
}

@if (_showAdjust)
{
    <FormModal IsOpen="true" Title="Adjust leave balance" TestId="leave-admin-adjust-modal" OnClose="() => _showAdjust = false">
        <div class="mb-3">
            <label class="form-label meterp-required">Employee</label>
            <EntityPicker TestId="leave-admin-employee"
                          Value="_adjustEmployeeId"
                          ValueChanged="OnLeaveEmployeePicked"
                          Options="LeaveEmployeeOptions"
                          SelectedLabel="@LeaveEmployeeName"
                          Placeholder="Type an employee name"
                          Required="true"
                          OnSearch="SearchLeaveEmployeesAsync" />
        </div>
        <div class="mb-3">
            <label class="form-label">New balance (days)</label>
            <input type="number" step="0.5" class="form-control" @bind="_adjustBalance" data-testid="leave-admin-balance" />
        </div>
        <div class="mb-3">
            <label class="form-label meterp-required">Reason</label>
            <input class="form-control" @bind="_adjustReason" data-testid="leave-admin-reason" />
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" @onclick="() => _showAdjust = false">Cancel</button>
            <button type="button" class="btn btn-primary" data-testid="leave-admin-adjust-save" @onclick="SaveAdjustAsync">Save</button>
        </div>
    </FormModal>
}

@code {
    private List<LeaveRequest> _requests = new();
    private List<Employee> _employees = new();
    private bool _loading = true;
    private bool _showAdjust;
    private Guid _adjustEmployeeId;
    private decimal _adjustBalance;
    private string _adjustReason = "";

    private IReadOnlyList<EntityPickerOption> LeaveEmployeeOptions =>
        _employees.Select(e => new EntityPickerOption
        {
            Id = e.Id,
            Label = $"{e.EmployeeNumber} — {e.FirstName} {e.LastName}",
            SubLabel = $"Balance {e.LeaveBalanceDays:N1} days"
        }).ToList();
    private string? LeaveEmployeeName
    {
        get
        {
            var e = _employees.FirstOrDefault(x => x.Id == _adjustEmployeeId);
            return e == null ? null : $"{e.EmployeeNumber} — {e.FirstName} {e.LastName}";
        }
    }

    private Task OnLeaveEmployeePicked(Guid id)
    {
        _adjustEmployeeId = id;
        var emp = _employees.FirstOrDefault(e => e.Id == id);
        if (emp != null)
            _adjustBalance = emp.LeaveBalanceDays;
        return Task.CompletedTask;
    }

    private async Task SearchLeaveEmployeesAsync(string term)
    {
        _employees = (await EmployeeService.GetAllAsync(
                string.IsNullOrWhiteSpace(term) ? null : term.Trim(), 1, 50, includeInactive: false)).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _employees = (await EmployeeService.GetAllAsync(pageSize: 200, includeInactive: false)).ToList();
            _requests = (await LeaveService.GetRecentRequestsAsync(100)).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenAdjust()
    {
        _adjustEmployeeId = _employees.FirstOrDefault()?.Id ?? Guid.Empty;
        var emp = _employees.FirstOrDefault(e => e.Id == _adjustEmployeeId);
        _adjustBalance = emp?.LeaveBalanceDays ?? 0;
        _adjustReason = "";
        _showAdjust = true;
    }

    private async Task SaveAdjustAsync()
    {
        if (_adjustEmployeeId == Guid.Empty || string.IsNullOrWhiteSpace(_adjustReason))
        {
            Toast.ShowError("Employee and reason are required.");
            return;
        }

        try
        {
            await LeaveService.AdjustLeaveBalanceAsync(_adjustEmployeeId, _adjustBalance, _adjustReason);
            Toast.ShowSuccess("Leave balance updated.");
            _showAdjust = false;
            _employees = (await EmployeeService.GetAllAsync(pageSize: 200)).ToList();
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }

    private static bool CanCancel(LeaveRequest r) =>
        r.Status is LeaveRequestStatus.PendingManager
            or LeaveRequestStatus.PendingExecutive
            or LeaveRequestStatus.PendingHr
        || (r.Status == LeaveRequestStatus.Approved && r.StartDate.Date > DateTime.UtcNow.Date);

    private async Task CancelRequestAsync(LeaveRequest r)
    {
        if (CurrentUser.UserId is not { } userId) return;
        try
        {
            if (!await LeaveService.CancelAsync(r.Id, userId, "Cancelled by leave admin"))
            {
                Toast.ShowInfo("Request could not be cancelled.");
                return;
            }

            Toast.ShowSuccess("Leave request cancelled.");
            _requests = (await LeaveService.GetRecentRequestsAsync(100)).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
    }
}
