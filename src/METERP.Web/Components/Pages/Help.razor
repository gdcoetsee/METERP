@page "/help"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization

<PageTitle>How to use METERP</PageTitle>
<span data-testid="help-ready" class="visually-hidden">ready</span>

<div class="help-hero">
    <p class="portal-kicker">User manual</p>
    <h1>How to run the business in METERP</h1>
    <p class="text-muted" data-testid="help-spine-note">Cash spine: Opportunity → Quote → Job → Invoice. Travel is its own line. A <strong>deposit</strong> invoice is not a <strong>final</strong> invoice, and neither one is Executive close. <strong>Invoice does not close the job</strong>. TRFid examples: FT16010, SD393, PD0085 (MET Electrical).</p>
    <p class="lead text-muted">This is the working guide for office staff, field technicians, executives, and customers. Follow the spine: opportunity → quote → job → invoice. Travel is always a separate cost.</p>
</div>

<div class="row g-4 help-body">
    <div class="col-lg-3">
        <nav class="help-toc card portal-panel p-3" aria-label="Manual sections">
            <strong class="d-block mb-2">Jump to</strong>
            <a href="#staff-login">Sign in</a>
