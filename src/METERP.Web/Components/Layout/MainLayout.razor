@inherits LayoutComponentBase
@using Microsoft.JSInterop
@inject IJSRuntime JS

@code {
    private bool isDarkMode;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "darkMode");
            isDarkMode = saved == "true";
            if (isDarkMode)
            {
                await JS.InvokeVoidAsync("document.body.classList.add", "dark");
            }
        }
        catch { }
    }

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        if (isDarkMode)
        {
            await JS.InvokeVoidAsync("document.body.classList.add", "dark");
        }
        else
        {
            await JS.InvokeVoidAsync("document.body.classList.remove", "dark");
        }
        await JS.InvokeVoidAsync("localStorage.setItem", "darkMode", isDarkMode.ToString().ToLower());
    }
}

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-3 meterp-topbar d-flex justify-content-between align-items-center">
            <div class="meterp-topbar-search">
                <AuthorizeView>
                    <Authorized>
                        <GlobalSearch />
                    </Authorized>
                </AuthorizeView>
            </div>
            <div class="d-flex align-items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <NotificationBell />
                    </Authorized>
                </AuthorizeView>
                <button class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="ToggleDarkMode" title="Toggle dark mode" data-testid="topbar-dark-mode">
                    <i class="bi @(isDarkMode ? "bi-sun" : "bi-moon")" aria-hidden="true"></i>
                </button>
                <AuthorizeView>
                    <Authorized>
                        <div class="meterp-user-chip">
                            <span class="d-none d-md-inline">@context.User.Identity?.Name</span>
                            <a href="/account" class="btn btn-sm btn-outline-secondary py-0 px-2">Account</a>
                            <a href="/logout" class="btn btn-sm btn-outline-secondary py-0 px-2">Logout</a>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="btn btn-sm btn-outline-primary py-0 px-2">Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<!-- Floating AI Copilot launcher for that "next level" feel -->
<AuthorizeView Policy="Portal.Access" Context="portalAuth">
    <NotAuthorized>
        <AuthorizeView Context="staffAuth">
            <Authorized>
                <a href="/ai-copilot" class="btn btn-primary position-fixed rounded-circle shadow ai-fab"
                   title="Open Grok Bot" data-testid="ai-copilot-launcher">
                    <span style="font-size: 1.4rem;">✨</span>
                </a>
            </Authorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>

<TenantBrandingStyles />
<METERP.Web.Components.Shared.ToastContainer />
<METERP.Web.Components.Shared.ConfirmDialogHost />

<div id="blazor-error-ui" role="alert" aria-live="assertive">
    An unhandled error has occurred. Please try refreshing or contact support.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" aria-label="Dismiss error">🗙</a>
</div>
