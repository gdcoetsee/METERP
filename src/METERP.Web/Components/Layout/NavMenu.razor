@code {
    private readonly HashSet<string> _open = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _open.Add(ActiveGroup());
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _open.Add(ActiveGroup());
        InvokeAsync(StateHasChanged);
    }

    private bool IsOpen(string group) => _open.Contains(group);

    private void Toggle(string group)
    {
        if (!_open.Remove(group))
            _open.Add(group);
    }

    private string ActiveGroup()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(path)) return "overview";
        if (path.StartsWith("customer") || path.StartsWith("opportunit") || path.StartsWith("quote") || path.StartsWith("sales-order"))
            return "crm";
        if (path.StartsWith("invoice") || path.StartsWith("finance") || path.StartsWith("leave") || path.StartsWith("certif")
            || path.StartsWith("employee") || path.StartsWith("division") || path.StartsWith("payroll"))
            return "finance";
        if (path.StartsWith("report") || path.StartsWith("ai-") || path.StartsWith("settings") || path.StartsWith("notification")
            || path.StartsWith("company-document") || path.StartsWith("audit") || path.StartsWith("tenant") || path.StartsWith("user"))
            return "insights";
        if (path.StartsWith("field")) return "field";
        if (path.StartsWith("account") || path.StartsWith("logout")) return "account";
        return "ops";
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
